@model List<FuelManagement.Models.ViewModels.SwitchAccountViewModel>

@{
    ViewData["Title"] = "Choose Account";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Choose Account - FuelMS</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    <style>

        body {
            font-family: 'Inter',sans-serif;
            background: oklch(0.491 0.27 292.581);
        }

        .card {
            box-shadow: 0 12px 25px rgba(0,0,0,0.15);
        }

            .card:hover {
                box-shadow: 0 20px 35px rgba(0,0,0,0.25);
            }

    </style>

</head>

<body class="min-h-screen flex items-center justify-center px-4">

    <div class="w-full max-w-4xl text-center">

        <!-- HEADER -->
        <div class="mb-14">

            <h1 class="text-4xl font-bold text-white mb-2">
                Choose Account
            </h1>

            <p class="text-white/80 text-lg">
                Select your account to continue
            </p>

        </div>


        <!-- USERS -->
        <div class="flex flex-col md:flex-row items-center justify-center gap-10">

            @foreach (var user in Model)
            {
                <div onclick="openLogin(@user.Id,'@user.FullName')"
                     class="card bg-white rounded-2xl p-7 w-48 text-center cursor-pointer
     transition duration-300 hover:-translate-y-1">

                    <div class="w-28 h-28 mx-auto">

                        <img src="@(user.ProfileImageUrl ?? "/images/avatars/default.jpg")"
                             alt="@user.FullName"
                             class="w-full h-full rounded-full object-cover border-4 border-gray-100 shadow-sm"
                             onerror="this.src='https://ui-avatars.com/api/?name=@Uri.EscapeDataString(user.FullName)&size=128&background=0ea5e9&color=fff&bold=true'" />

                    </div>

                    <span class="block mt-4 text-gray-800 font-medium">
                        @user.FullName
                    </span>

                </div>
            }

        </div>


        <p class="text-white/80 text-sm mt-14">
            Click on your account to continue
        </p>

    </div>



    <!-- LOGIN MODAL -->
    <div id="loginModal"
         class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">

        <div class="bg-white rounded-xl shadow-xl w-96 p-6">

            <h2 class="text-xl font-semibold mb-4 text-gray-800">
                Enter Password
            </h2>

            <form method="post" action="/Account/SwitchAccountLogin">

                @Html.AntiForgeryToken()

                <input type="hidden" name="userId" id="loginUserId" />

                <p id="loginUserName"
                   class="text-gray-600 mb-4 text-sm"></p>

                <input type="password"
                       name="password"
                       placeholder="Enter your password"
                       required
                       class="w-full border rounded-lg px-3 py-2 mb-4" />

                <div class="flex justify-end gap-3">

                    <button type="button"
                            onclick="closeLogin()"
                            class="px-4 py-2 text-gray-600">
                        Cancel
                    </button>

                    <button type="submit"
                            class="bg-violet-600 hover:bg-violet-700 text-white px-4 py-2 rounded-lg">
                        Login
                    </button>

                </div>

            </form>

        </div>

    </div>



    <script>

        function openLogin(id,name)
        {
        document.getElementById("loginUserId").value=id;
        document.getElementById("loginUserName").innerText="Login as "+name;

        const modal=document.getElementById("loginModal");

        modal.classList.remove("hidden");
        modal.classList.add("flex");
        }

        function closeLogin()
        {
        const modal=document.getElementById("loginModal");

        modal.classList.remove("flex");
        modal.classList.add("hidden");
        }

    </script>

</body>
</html>