@model FuelManagement.Models.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Reset Password - FuelMS";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script>
        if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    animation: {
                        'fadeIn':    'fadeIn 0.6s ease-out forwards',
                        'slideUp':   'slideUp 0.5s cubic-bezier(0.16,1,0.3,1) forwards',
                        'popIn':     'popIn 0.5s cubic-bezier(0.34,1.56,0.64,1) forwards',
                        'float':     'float 4s ease-in-out infinite',
                        'pulse-ring':'pulseRing 2s ease-out infinite',
                        'shimmer':   'shimmer 2s linear infinite',
                    },
                    keyframes: {
                        fadeIn:    { '0%': { opacity:'0', transform:'translateY(20px)' },  '100%': { opacity:'1', transform:'translateY(0)' } },
                        slideUp:   { '0%': { opacity:'0', transform:'translateY(40px)' },  '100%': { opacity:'1', transform:'translateY(0)' } },
                        popIn:     { '0%': { opacity:'0', transform:'scale(0.7)' },         '100%': { opacity:'1', transform:'scale(1)' } },
                        float:     { '0%,100%': { transform:'translateY(0) rotate(0deg)' },'50%':  { transform:'translateY(-12px) rotate(2deg)' } },
                        pulseRing: { '0%': { transform:'scale(1)', opacity:'0.8' },         '100%': { transform:'scale(1.5)', opacity:'0' } },
                        shimmer:   { '0%': { backgroundPosition:'-200% 0' },                '100%': { backgroundPosition:'200% 0' } },
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            font-family: 'Inter', sans-serif;
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            width: 100%;
            min-height: 100%;
        }

            html.dark body {
                background-color: #030712 !important;
            }

        .bg-animated {
            background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 25%, #f5f3ff 50%, #fdf4ff 75%, #fff7ed 100%);
            background-size: 400% 400%;
            animation: gradientShift 12s ease infinite;
        }

        .dark .bg-animated {
            background: linear-gradient(135deg, #030712 0%, #0f0a1e 25%, #0a0f1e 50%, #0f0a1e 75%, #030712 100%);
        }

        @@keyframes gradientShift {
            0%, 100% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }
        }

        .glass-card {
            background: rgba(255,255,255,0.88);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid rgba(255,255,255,0.6);
            box-shadow: 0 32px 64px -12px rgba(0,0,0,0.12), 0 0 0 1px rgba(255,255,255,0.5);
        }

        .dark .glass-card {
            background: rgba(15,10,30,0.88);
            border: 1px solid rgba(139,92,246,0.15);
            box-shadow: 0 32px 64px -12px rgba(0,0,0,0.6), 0 0 0 1px rgba(139,92,246,0.1);
        }

        .orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(70px);
            pointer-events: none;
            animation: floatOrb 8s ease-in-out infinite;
        }

        @@keyframes floatOrb {
            0%, 100% {
                transform: translate(0,0) scale(1);
            }

            33% {
                transform: translate(20px,-20px) scale(1.05);
            }

            66% {
                transform: translate(-15px,15px) scale(0.95);
            }
        }

        /* ── Left panel yellow — fixed height, no stretching ── */
        .info-panel {
            background-color: #FACC15;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            height: 100%;
            min-height: 600px;
        }

            .info-panel::before {
                content: '';
                position: absolute;
                top: -60px;
                right: -60px;
                width: 220px;
                height: 220px;
                background: rgba(0,0,0,0.05);
                border-radius: 50%;
            }

            .info-panel::after {
                content: '';
                position: absolute;
                bottom: -40px;
                left: -40px;
                width: 160px;
                height: 160px;
                background: rgba(0,0,0,0.04);
                border-radius: 50%;
            }

        /* ── Person photo: fixed height with cover — no gaps ── */
        .person-photo-fill {
            position: relative;
            height: 280px; /* fixed height */
            margin-top: auto;
            margin-left: -2rem;
            margin-right: -2rem;
            margin-bottom: -2rem;
            overflow: hidden;
            background-color: #FACC15;
            flex-shrink: 0;
        }

            .person-photo-fill img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                object-position: center 20%;
                display: block;
            }

            .person-photo-fill::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 100px;
                background: linear-gradient(to bottom, #FACC15 0%, #FACC15 20%, rgba(250,204,21,0) 100%);
                z-index: 2;
                pointer-events: none;
            }

            .person-photo-fill::after {
                content: '';
                position: absolute;
                inset: 0;
                background: radial-gradient(circle at 70% 30%, rgba(250,204,21,0.3) 0%, transparent 60%);
                z-index: 1;
                pointer-events: none;
            }

        /* ── Mobile yellow strip ── */
        .mobile-yellow-strip {
            background-color: #FACC15;
            display: block;
        }

        .mobile-yellow-photo {
            position: relative;
            height: 180px;
            overflow: hidden;
            background-color: #FACC15;
        }

            .mobile-yellow-photo img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                object-position: center 20%;
                display: block;
            }

            .mobile-yellow-photo::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 80px;
                background: linear-gradient(to bottom, #FACC15 0%, #FACC15 15%, rgba(250,204,21,0) 100%);
                z-index: 2;
                pointer-events: none;
            }

            .mobile-yellow-photo::after {
                content: '';
                position: absolute;
                inset: 0;
                background: radial-gradient(circle at 70% 30%, rgba(250,204,21,0.3) 0%, transparent 70%);
                z-index: 1;
                pointer-events: none;
            }

        .step-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            transition: all 0.4s cubic-bezier(0.34,1.56,0.64,1);
        }

            .step-dot.active {
                width: 24px;
                border-radius: 4px;
            }

        .form-input {
            transition: all 0.3s ease;
            background: rgba(248,250,252,0.8);
        }

        .dark .form-input {
            background: rgba(17,24,39,0.8);
        }

        .form-input:focus {
            transform: translateY(-1px);
            box-shadow: 0 0 0 3px rgba(139,92,246,0.15), 0 8px 20px -4px rgba(139,92,246,0.15);
        }

        .btn-gradient {
            background: linear-gradient(135deg, #7c3aed, #4f46e5, #2563eb);
            background-size: 200% 200%;
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
        }

            .btn-gradient:hover {
                background-position: right center;
                transform: translateY(-2px);
                box-shadow: 0 16px 40px -8px rgba(124,58,237,0.5);
            }

            .btn-gradient::after {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(135deg, transparent 30%, rgba(255,255,255,0.15) 50%, transparent 70%);
                background-size: 200% 100%;
                transition: background-position 0.5s;
            }

            .btn-gradient:hover::after {
                background-position: -100% 0;
            }

        .user-card-hover {
            transition: all 0.4s cubic-bezier(0.34,1.56,0.64,1);
            cursor: pointer;
        }

            .user-card-hover:hover {
                transform: translateY(-4px) scale(1.02);
                box-shadow: 0 24px 48px -8px rgba(124,58,237,0.3);
            }

            .user-card-hover:active {
                transform: scale(0.98);
            }

        .avatar-ring::before {
            content: '';
            position: absolute;
            inset: -3px;
            border-radius: 50%;
            background: linear-gradient(135deg, #7c3aed, #2563eb, #7c3aed);
            background-size: 200% 200%;
            animation: gradientShift 3s ease infinite;
            z-index: -1;
        }

        .strength-bar {
            transition: all 0.4s ease;
        }

        .eye-btn {
            transition: all 0.2s ease;
        }

            .eye-btn:hover {
                transform: scale(1.1);
            }

        .back-link-underline {
            position: relative;
            display: inline-block;
        }

            .back-link-underline::after {
                content: '';
                position: absolute;
                width: 0;
                height: 1px;
                bottom: -1px;
                left: 0;
                background: #78350f;
                transition: width 0.3s ease;
            }

            .back-link-underline:hover::after {
                width: 100%;
            }

        .scroll-panel::-webkit-scrollbar {
            width: 3px;
        }

        .scroll-panel::-webkit-scrollbar-track {
            background: transparent;
        }

        .scroll-panel::-webkit-scrollbar-thumb {
            background: rgba(139,92,246,0.3);
            border-radius: 2px;
        }

        /* ── Layout ── */
        .outer-wrapper {
            width: 100%;
            max-width: 480px;
            margin: 0 auto;
        }

        @@media (min-width: 768px) {
            .outer-wrapper {
                max-width: 600px;
            }
        }

        @@media (min-width: 1024px) {
            .outer-wrapper {
                max-width: 960px;
            }

            .layout-cols {
                display: flex;
                flex-direction: row;
                min-height: 650px;
            }

            .info-panel-wrap {
                display: flex !important;
                width: 42%;
            }

            .form-panel-wrap {
                width: 58%;
            }

            .scroll-panel {
                max-height: 650px;
                overflow-y: auto;
            }

            .mobile-yellow-strip {
                display: none !important;
            }

            .mobile-back {
                display: none !important;
            }

            .desktop-back {
                display: flex !important;
            }

            .info-panel {
                min-height: 650px;
            }

            .person-photo-fill {
                height: 280px;
                margin-left: -2.5rem;
                margin-right: -2.5rem;
                margin-bottom: -2.5rem;
            }
        }

        @@media (min-width: 1280px) {
            .outer-wrapper {
                max-width: 1100px;
            }

            .layout-cols {
                min-height: 680px;
            }

            .info-panel {
                min-height: 680px;
            }

            .scroll-panel {
                max-height: 680px;
            }

            .person-photo-fill {
                height: 300px;
            }
        }

        /* When user is found and card is clicked, ensure photo still fits */
        .found-state .person-photo-fill {
            height: 280px;
        }

        .desktop-back {
            display: none;
        }

        .info-panel-wrap {
            display: none;
        }
    </style>
</head>
<body class="bg-animated min-h-screen w-full flex items-start lg:items-center justify-center p-3 sm:p-6 lg:p-8">

    <div class="orb w-96 h-96 bg-violet-300/25 dark:bg-violet-900/20 top-0 left-0 -translate-x-1/2 -translate-y-1/2"></div>
    <div class="orb w-80 h-80 bg-blue-300/20 dark:bg-blue-900/15 bottom-0 right-0 translate-x-1/3 translate-y-1/3" style="animation-delay:3s;"></div>
    <div class="orb w-64 h-64 bg-pink-300/15 dark:bg-pink-900/10 top-1/2 right-1/4" style="animation-delay:5s;"></div>

    <div class="outer-wrapper animate-fadeIn w-full">

        <!-- Mobile back button -->
        <div class="mobile-back mb-4 sm:mb-6">
            <a asp-action="Login" asp-controller="Account"
               class="inline-flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 hover:text-violet-600 dark:hover:text-violet-400 transition-colors group">
                <span class="w-8 h-8 rounded-full bg-white/80 dark:bg-gray-800/80 border border-gray-200 dark:border-gray-700 flex items-center justify-center group-hover:border-violet-300 transition-all group-hover:shadow-md">
                    <i class="fas fa-arrow-left text-xs transform group-hover:-translate-x-0.5 transition-transform"></i>
                </span>
                Back to Login
            </a>
        </div>

        <div class="glass-card rounded-2xl sm:rounded-3xl overflow-hidden">
            <div class="layout-cols">

                <!-- ══ LEFT INFO PANEL (desktop only) ══ -->
                <div class="info-panel-wrap">
                    <div class="info-panel w-full p-8 xl:p-10 text-gray-900">

                        <div class="desktop-back flex-col">
                            <a asp-action="Login" asp-controller="Account"
                               class="back-link-underline inline-flex items-center gap-2 text-gray-800/70 hover:text-gray-900 text-sm transition-colors mb-8 group">
                                <i class="fas fa-arrow-left text-xs transform group-hover:-translate-x-1 transition-transform"></i>
                                Back to Login
                            </a>

                            <div class="flex items-center gap-3 mb-6">
                                <div class="w-12 h-12 bg-black/10 rounded-2xl flex items-center justify-center float-animation overflow-hidden border border-black/10 flex-shrink-0">
                                    <img src="~/images/ul.png" alt="Logo"
                                         class="w-full h-full object-contain p-1"
                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                                    <i class="fas fa-gas-pump text-gray-800 text-lg" style="display:none;"></i>
                                </div>
                                <div>
                                    <p class="font-bold text-gray-900 text-lg leading-tight">Uniso Fuel</p>
                                    <p class="text-gray-700/60 text-xs">Engineer Ayub</p>
                                </div>
                            </div>

                            <h2 class="text-2xl xl:text-3xl font-bold leading-tight mb-3 text-gray-900" id="desktopTitle">
                                Sponsored by CS23A Class of 2027.
                            </h2>
                            <p class="text-gray-800/70 text-sm xl:text-base leading-relaxed" id="desktopSub">
                                We believe that great code comes with great responsibility.

                                That's why the CS23A class of 2027 has partnered with Uniso Fuel to bring you a secure and seamless password recovery experience.
                            </p>
                        </div>

                        <!-- Person photo desktop — fixed height with beautiful blur preserved -->
                        <div class="person-photo-fill mt-auto">
                            <img src="~/images/buya.png"
                                 alt="Person"
                                 onerror="this.closest('.person-photo-fill').style.visibility='hidden';" />
                        </div>
                    </div>
                </div>

                <!-- ══ RIGHT FORM PANEL ══ -->
                <div class="form-panel-wrap flex flex-col">

                    <!-- ── Mobile yellow strip ── -->
                    <div class="mobile-yellow-strip">
                        <!-- Yellow top section with logo + text -->
                        <div class="p-5 sm:p-6 relative overflow-hidden" style="background-color:#FACC15;">
                            <div class="absolute top-0 right-0 w-36 h-36 bg-black/5 rounded-full -translate-y-1/2 translate-x-1/2"></div>

                            <div class="relative z-10 flex items-center justify-between mb-3">
                                <div class="flex items-center gap-2.5">
                                    <div class="w-9 h-9 sm:w-10 sm:h-10 bg-black/10 rounded-xl flex items-center justify-center float-animation overflow-hidden border border-black/10">
                                        <img src="~/images/ul.png" alt="Logo"
                                             class="w-full h-full object-contain p-1"
                                             onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                                        <i class="fas fa-gas-pump text-gray-800 text-sm" style="display:none;"></i>
                                    </div>
                                    <div>
                                        <p class="font-bold text-gray-900 text-sm sm:text-base leading-tight">Uniso Fuel</p>
                                        <p class="text-gray-700/60 text-xs">Engineer Ayub</p>
                                    </div>
                                </div>
                                <div class="flex items-center gap-1.5">
                                    <div class="step-dot active bg-gray-800" id="dot1"></div>
                                    <div class="step-dot bg-gray-800/30" id="dot2"></div>
                                    <div class="step-dot bg-gray-800/30" id="dot3"></div>
                                </div>
                            </div>

                            <div class="relative z-10">
                                <h1 class="text-lg sm:text-xl font-bold text-gray-900" id="headerTitle">Reset Password</h1>
                                <p class="text-gray-700/70 text-xs sm:text-sm mt-0.5" id="headerSub">Verify your identity to set a new password</p>
                            </div>
                        </div>

                        <!-- Mobile person photo — fixed height with blur preserved -->
                        <div class="mobile-yellow-photo">
                            <img src="~/images/buya.png"
                                 alt="Person"
                                 onerror="this.closest('.mobile-yellow-photo').style.visibility='hidden';" />
                        </div>
                    </div>

                    <!-- Scrollable content -->
                    <div class="scroll-panel p-5 sm:p-7 lg:p-8 xl:p-10 flex-1 flex flex-col justify-start">

                        <!-- Desktop step dots -->
                        <div class="hidden lg:flex items-center justify-between mb-6 xl:mb-8">
                            <div>
                                <h2 class="text-xl xl:text-2xl font-bold text-gray-900 dark:text-white" id="desktopFormTitle">Find Your Account</h2>
                                <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5" id="desktopFormSub">Enter your email to get started</p>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <div class="step-dot active bg-violet-500" id="ddot1"></div>
                                <div class="step-dot bg-gray-200 dark:bg-gray-700" id="ddot2"></div>
                                <div class="step-dot bg-gray-200 dark:bg-gray-700" id="ddot3"></div>
                            </div>
                        </div>

                        @if (TempData["ResetError"] != null)
                        {
                            <div class="mb-5 p-4 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800/50 rounded-2xl animate-popIn flex items-start gap-3">
                                <div class="w-8 h-8 bg-red-100 dark:bg-red-900/40 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                                    <i class="fas fa-exclamation text-red-500 text-xs"></i>
                                </div>
                                <div>
                                    <p class="text-sm font-semibold text-red-700 dark:text-red-400">Something went wrong</p>
                                    <p class="text-xs text-red-600 dark:text-red-500 mt-0.5">@TempData["ResetError"]</p>
                                </div>
                            </div>
                        }

                        <!-- STEP 1 — Email form -->
                        <div id="step1" class="@(Model.UserFound || Model.NotFound ? "hidden" : "")">
                            <div class="text-center lg:text-left mb-6">
                                <div class="lg:hidden relative inline-block mb-4">
                                    <div class="w-16 h-16 sm:w-20 sm:h-20 bg-gradient-to-br from-violet-500 to-indigo-600 rounded-3xl flex items-center justify-center mx-auto shadow-lg shadow-violet-200 dark:shadow-violet-900/30 animate-popIn">
                                        <i class="fas fa-envelope-open-text text-white text-2xl sm:text-3xl"></i>
                                    </div>
                                    <div class="absolute inset-0 bg-violet-400/30 rounded-3xl animate-pulse-ring"></div>
                                </div>
                                <p class="text-sm text-gray-500 dark:text-gray-400 max-w-sm lg:max-w-none">
                                    Enter the email address linked to your account and we'll find it for you.
                                </p>
                            </div>

                            <form method="post" asp-action="ForgotPassword" class="space-y-4">
                                @Html.AntiForgeryToken()
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">Email Address</label>
                                    <div class="relative">
                                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                            <i class="fas fa-at text-gray-400 dark:text-gray-500 text-sm"></i>
                                        </div>
                                        <input asp-for="Email" type="email"
                                               class="form-input w-full pl-11 pr-4 py-3 lg:py-3.5 border border-gray-200 dark:border-gray-700 rounded-2xl text-gray-800 dark:text-gray-200 placeholder-gray-400 dark:placeholder-gray-600 focus:outline-none focus:border-violet-400 dark:focus:border-violet-500 focus:ring-2 focus:ring-violet-100 dark:focus:ring-violet-900/30 text-sm lg:text-base"
                                               placeholder="your@email.com" />
                                    </div>
                                    <span asp-validation-for="Email" class="text-xs text-red-500 dark:text-red-400 mt-1.5 block"></span>
                                </div>

                                <button type="submit" class="btn-gradient w-full py-3 lg:py-3.5 px-6 text-white font-semibold rounded-2xl text-sm lg:text-base">
                                    <span class="relative z-10 flex items-center justify-center gap-2">
                                        <i class="fas fa-magnifying-glass"></i>
                                        Find My Account
                                    </span>
                                </button>
                            </form>

                            <div class="mt-5 pt-5 border-t border-gray-100 dark:border-gray-800 text-center lg:text-left">
                                <p class="text-sm text-gray-500 dark:text-gray-400">
                                    Remembered your password?
                                    <a asp-action="Login" class="text-violet-600 dark:text-violet-400 font-semibold hover:text-violet-700 dark:hover:text-violet-300 transition-colors ml-1">Sign in</a>
                                </p>
                            </div>
                        </div>

                        <!-- STEP 2A — Not found -->
                        @if (Model.NotFound)
                        {
                            <div class="animate-slideUp text-center py-2">
                                <div class="w-20 h-20 lg:w-24 lg:h-24 bg-gradient-to-br from-red-400 to-rose-600 rounded-3xl flex items-center justify-center mx-auto mb-5 shadow-lg shadow-red-200 dark:shadow-red-900/30 animate-popIn">
                                    <i class="fas fa-user-xmark text-white text-3xl lg:text-4xl"></i>
                                </div>
                                <h3 class="text-xl lg:text-2xl font-bold text-gray-900 dark:text-white mb-2">No Account Found</h3>
                                <p class="text-gray-500 dark:text-gray-400 text-sm lg:text-base mb-2 max-w-sm mx-auto">
                                    Sorry, we couldn't find any account linked to
                                </p>
                                <div class="inline-flex items-center gap-2 px-4 py-2 bg-gray-100 dark:bg-gray-800 rounded-full mb-6">
                                    <i class="fas fa-envelope text-gray-400 text-xs"></i>
                                    <span class="text-sm font-semibold text-gray-700 dark:text-gray-300">@Model.Email</span>
                                </div>
                                <div class="space-y-3 max-w-sm mx-auto lg:max-w-none">
                                    <a asp-action="ForgotPassword" class="btn-gradient w-full py-3 px-6 text-white font-semibold rounded-2xl text-sm flex items-center justify-center gap-2">
                                        <i class="fas fa-rotate-left"></i> Try a Different Email
                                    </a>
                                    <a asp-action="SignIn" class="w-full py-3 px-6 border-2 border-gray-200 dark:border-gray-700 hover:border-violet-300 dark:hover:border-violet-600 text-gray-700 dark:text-gray-300 font-semibold rounded-2xl text-sm flex items-center justify-center gap-2 transition-all hover:bg-violet-50 dark:hover:bg-violet-900/10">
                                        <i class="fas fa-user-plus text-violet-500"></i> Create New Account
                                    </a>
                                </div>
                            </div>
                        }

                        <!-- STEP 2B — Found -->
                        @if (Model.UserFound)
                        {
                            <div class="animate-slideUp" id="foundSection">
                                <div class="flex items-center gap-3 mb-5">
                                    <div class="w-10 h-10 bg-emerald-100 dark:bg-emerald-900/30 rounded-2xl flex items-center justify-center flex-shrink-0">
                                        <i class="fas fa-circle-check text-emerald-500 text-lg"></i>
                                    </div>
                                    <div>
                                        <h3 class="text-base lg:text-lg font-bold text-gray-900 dark:text-white">Account found!</h3>
                                        <p class="text-xs text-gray-500 dark:text-gray-400">Tap the card below to continue</p>
                                    </div>
                                </div>

                                <div id="userCard" onclick="revealPasswordForm()"
                                     class="user-card-hover relative p-4 lg:p-5 rounded-3xl border-2 border-violet-200 dark:border-violet-700/50 bg-gradient-to-br from-violet-50 to-indigo-50 dark:from-violet-900/10 dark:to-indigo-900/10 mb-2 animate-popIn overflow-hidden">
                                    <div class="relative flex items-center gap-4">
                                        <div class="relative flex-shrink-0">
                                            @if (!string.IsNullOrEmpty(Model.FoundUserProfileImage))
                                            {
                                                <div class="avatar-ring relative w-14 h-14 lg:w-16 lg:h-16 rounded-full overflow-hidden border-2 border-white dark:border-gray-800 shadow-lg">
                                                    <img src="@Model.FoundUserProfileImage" alt="@Model.FoundUserFullName"
                                                         class="w-full h-full object-cover"
                                                         onerror="this.style.display='none'; document.getElementById('avatarFallback').style.display='flex';" />
                                                    <div id="avatarFallback" class="hidden w-full h-full bg-gradient-to-br from-violet-500 to-indigo-600 items-center justify-center">
                                                        <span class="text-white font-bold text-lg">@Model.FoundUserFullName?.Substring(0, 1).ToUpper()</span>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="avatar-ring relative w-14 h-14 lg:w-16 lg:h-16 rounded-full bg-gradient-to-br from-violet-500 via-indigo-500 to-blue-500 flex items-center justify-center shadow-lg border-2 border-white dark:border-gray-800">
                                                    <span class="text-white font-bold text-xl lg:text-2xl select-none">
                                                        @(Model.FoundUserFullName?.Length > 0 ? Model.FoundUserFullName.Substring(0, 1).ToUpper() : "?")
                                                    </span>
                                                </div>
                                            }
                                            <div class="absolute bottom-0.5 right-0.5 w-3.5 h-3.5 bg-emerald-400 border-2 border-white dark:border-gray-800 rounded-full shadow"></div>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <p class="font-bold text-gray-900 dark:text-white text-base lg:text-lg truncate">@Model.FoundUserFullName</p>
                                            <p class="text-gray-500 dark:text-gray-400 text-xs lg:text-sm truncate">@Model.FoundUserEmail</p>
                                            <span class="inline-flex items-center gap-1 mt-1.5 px-2 py-0.5 bg-violet-100 dark:bg-violet-900/30 text-violet-700 dark:text-violet-300 text-xs font-medium rounded-full">
                                                <i class="fas fa-shield-halved text-xs"></i> Verified Account
                                            </span>
                                        </div>
                                        <div class="flex-shrink-0 w-8 h-8 bg-violet-100 dark:bg-violet-900/40 rounded-full flex items-center justify-center">
                                            <i class="fas fa-chevron-right text-violet-500 text-xs"></i>
                                        </div>
                                    </div>
                                    <div class="mt-3 pt-3 border-t border-violet-100 dark:border-violet-800/30 flex items-center justify-center gap-2">
                                        <div class="w-2 h-2 bg-violet-400 rounded-full animate-pulse"></div>
                                        <span class="text-xs font-semibold text-violet-600 dark:text-violet-400">Click to confirm — Is this you?</span>
                                        <div class="w-2 h-2 bg-violet-400 rounded-full animate-pulse"></div>
                                    </div>
                                </div>

                                <div id="passwordForm" class="hidden mt-5 animate-slideUp">
                                    <div class="flex items-center gap-3 mb-5">
                                        <div class="flex-1 h-px bg-gradient-to-r from-transparent via-violet-200 dark:via-violet-700 to-transparent"></div>
                                        <span class="text-xs font-semibold text-violet-500 dark:text-violet-400 px-2 flex-shrink-0">
                                            <i class="fas fa-lock mr-1"></i>Set New Password
                                        </span>
                                        <div class="flex-1 h-px bg-gradient-to-r from-transparent via-violet-200 dark:via-violet-700 to-transparent"></div>
                                    </div>

                                    <form method="post" asp-action="ResetPassword" class="space-y-4">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="email" value="@Model.FoundUserEmail" />

                                        <div>
                                            <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">
                                                New Password <span class="text-red-500">*</span>
                                            </label>
                                            <div class="relative">
                                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                                    <i class="fas fa-lock text-gray-400 dark:text-gray-500 text-sm"></i>
                                                </div>
                                                <input type="password" name="newPassword" id="newPassword" required
                                                       class="form-input w-full pl-11 pr-12 py-3 lg:py-3.5 border border-gray-200 dark:border-gray-700 rounded-2xl text-gray-800 dark:text-gray-200 placeholder-gray-400 dark:placeholder-gray-600 focus:outline-none focus:border-violet-400 dark:focus:border-violet-500 focus:ring-2 focus:ring-violet-100 dark:focus:ring-violet-900/30 text-sm lg:text-base"
                                                       placeholder="••••••••" />
                                                <button type="button" onclick="toggleEye('newPassword','eyeNew')"
                                                        class="eye-btn absolute inset-y-0 right-0 pr-4 flex items-center text-gray-400 hover:text-violet-500 dark:text-gray-500 dark:hover:text-violet-400" tabindex="-1">
                                                    <i id="eyeNew" class="fas fa-eye text-sm"></i>
                                                </button>
                                            </div>
                                            <div class="mt-2.5">
                                                <div class="flex gap-1.5 h-1.5 mb-1.5">
                                                    <div class="strength-bar flex-1 bg-gray-200 dark:bg-gray-700 rounded-full" id="s1"></div>
                                                    <div class="strength-bar flex-1 bg-gray-200 dark:bg-gray-700 rounded-full" id="s2"></div>
                                                    <div class="strength-bar flex-1 bg-gray-200 dark:bg-gray-700 rounded-full" id="s3"></div>
                                                    <div class="strength-bar flex-1 bg-gray-200 dark:bg-gray-700 rounded-full" id="s4"></div>
                                                </div>
                                                <p id="sText" class="text-xs text-gray-400 dark:text-gray-500">Enter a password</p>
                                            </div>
                                        </div>

                                        <div>
                                            <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">
                                                Confirm Password <span class="text-red-500">*</span>
                                            </label>
                                            <div class="relative">
                                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                                    <i class="fas fa-lock text-gray-400 dark:text-gray-500 text-sm"></i>
                                                </div>
                                                <input type="password" name="confirmPassword" id="confirmNewPassword" required
                                                       class="form-input w-full pl-11 pr-12 py-3 lg:py-3.5 border border-gray-200 dark:border-gray-700 rounded-2xl text-gray-800 dark:text-gray-200 placeholder-gray-400 dark:placeholder-gray-600 focus:outline-none focus:border-violet-400 dark:focus:border-violet-500 focus:ring-2 focus:ring-violet-100 dark:focus:ring-violet-900/30 text-sm lg:text-base"
                                                       placeholder="••••••••" />
                                                <button type="button" onclick="toggleEye('confirmNewPassword','eyeConfirm')"
                                                        class="eye-btn absolute inset-y-0 right-0 pr-4 flex items-center text-gray-400 hover:text-violet-500 dark:text-gray-500 dark:hover:text-violet-400" tabindex="-1">
                                                    <i id="eyeConfirm" class="fas fa-eye text-sm"></i>
                                                </button>
                                            </div>
                                            <p id="matchMsg" class="text-xs mt-1.5 hidden"></p>
                                        </div>

                                        <button type="submit" id="resetBtn"
                                                class="btn-gradient w-full py-3 lg:py-3.5 px-6 text-white font-semibold rounded-2xl text-sm lg:text-base">
                                            <span class="relative z-10 flex items-center justify-center gap-2">
                                                <i class="fas fa-key"></i> Reset My Password
                                            </span>
                                        </button>
                                    </form>
                                </div>

                                <p class="mt-4 text-center text-xs text-gray-400 dark:text-gray-500">
                                    Not your account?
                                    <a asp-action="ForgotPassword" class="text-violet-500 dark:text-violet-400 font-semibold hover:text-violet-600 transition-colors ml-1">Search again</a>
                                </p>
                            </div>
                        }

                    </div>

                    <!-- Bottom strip -->
                    <div class="px-5 sm:px-7 lg:px-8 xl:px-10 py-3.5 bg-gray-50/80 dark:bg-gray-900/50 border-t border-gray-100 dark:border-gray-800/50 flex items-center justify-between">
                        <div class="flex gap-4">
                            <a href="#" class="text-xs text-gray-400 dark:text-gray-600 hover:text-violet-500 dark:hover:text-violet-400 transition-colors">Privacy</a>
                            <a href="#" class="text-xs text-gray-400 dark:text-gray-600 hover:text-violet-500 dark:hover:text-violet-400 transition-colors">Terms</a>
                            <a href="#" class="text-xs text-gray-400 dark:text-gray-600 hover:text-violet-500 dark:hover:text-violet-400 transition-colors">Help</a>
                        </div>
                        <span class="text-xs text-gray-300 dark:text-gray-700">© 2025 Uniso Fuel</span>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <script>
        function revealPasswordForm() {
            const card = document.getElementById('userCard');
            const form = document.getElementById('passwordForm');
            if (!form || !card) return;

            card.classList.add('border-violet-500', 'shadow-lg');
            card.classList.remove('border-violet-200');
            card.style.cursor = 'default';
            card.onclick = null;

            const d1 = document.getElementById('dot1');
            const d2 = document.getElementById('dot2');
            if (d1 && d2) {
                d1.classList.remove('active');
                d1.classList.add('bg-gray-800/40');
                d2.classList.add('active');
                d2.classList.remove('bg-gray-800/30');
            }

            const dd1 = document.getElementById('ddot1');
            const dd2 = document.getElementById('ddot2');
            if (dd1 && dd2) {
                dd1.classList.remove('active', 'bg-violet-500');
                dd1.classList.add('bg-gray-300');
                dd2.classList.add('active', 'bg-violet-500');
                dd2.classList.remove('bg-gray-200', 'dark:bg-gray-700');
            }

            const ht = document.getElementById('headerTitle');
            const hs = document.getElementById('headerSub');
            if (ht) ht.textContent = 'Set New Password';
            if (hs) hs.textContent = 'Choose a strong password for your account';

            const dft = document.getElementById('desktopFormTitle');
            const dfs = document.getElementById('desktopFormSub');
            if (dft) dft.textContent = 'Set New Password';
            if (dfs) dfs.textContent = 'Choose a strong password for your account';

            const dt = document.getElementById('desktopTitle');
            const ds = document.getElementById('desktopSub');
            if (dt) dt.textContent = 'Almost there!';
            if (ds) ds.textContent = 'Set a strong new password to protect your account.';

            form.classList.remove('hidden');
            setTimeout(() => {
                const panel = document.querySelector('.scroll-panel');
                if (panel) {
                    panel.scrollTo({ top: panel.scrollHeight, behavior: 'smooth' });
                }
            }, 100);
        }

        function toggleEye(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon  = document.getElementById(iconId);
            if (!input || !icon) return;
            const show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            icon.classList.toggle('fa-eye',      !show);
            icon.classList.toggle('fa-eye-slash', show);
        }

        const newPw = document.getElementById('newPassword');
        if (newPw) {
            newPw.addEventListener('input', function () {
                const v = this.value;
                let s = 0;
                if (v.length >= 6) s++;
                if (v.length >= 8) s++;
                if (/[A-Z]/.test(v)) s++;
                if (/[0-9]/.test(v)) s++;
                if (/[^A-Za-z0-9]/.test(v)) s++;
                s = Math.min(s, 4);
                const cols  = ['','bg-red-400','bg-orange-400','bg-yellow-400','bg-emerald-400'];
                const txts  = ['','Weak','Fair','Good','Strong'];
                const tCols = ['','text-red-500','text-orange-500','text-yellow-600','text-emerald-500'];
                for (let i = 1; i <= 4; i++) {
                    const b = document.getElementById('s'+i);
                    if (b) b.className = `strength-bar flex-1 h-full rounded-full ${i<=s ? cols[s] : 'bg-gray-200 dark:bg-gray-700'}`;
                }
                const t = document.getElementById('sText');
                if (t) {
                    t.textContent = s===0 ? 'Enter a password' : txts[s];
                    t.className = `text-xs ${s===0 ? 'text-gray-400 dark:text-gray-500' : tCols[s]}`;
                }
            });
        }

        const confirmPw = document.getElementById('confirmNewPassword');
        if (confirmPw) {
            confirmPw.addEventListener('input', function () {
                const pw      = document.getElementById('newPassword')?.value;
                const msg     = document.getElementById('matchMsg');
                const btn     = document.getElementById('resetBtn');
                const matches = this.value === pw && this.value.length > 0;
                if (!msg) return;
                msg.classList.remove('hidden');
                if (matches) {
                    msg.textContent = '✓ Passwords match';
                    msg.className = 'text-xs mt-1.5 text-emerald-500 font-medium';
                    btn?.classList.remove('opacity-50','pointer-events-none');
                } else {
                    msg.textContent = '✗ Passwords do not match';
                    msg.className = 'text-xs mt-1.5 text-red-500 font-medium';
                    btn?.classList.add('opacity-50','pointer-events-none');
                }
            });
        }

        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', e => {
            if (!localStorage.theme) document.documentElement.classList.toggle('dark', e.matches);
        });
    </script>
</body>
</html>