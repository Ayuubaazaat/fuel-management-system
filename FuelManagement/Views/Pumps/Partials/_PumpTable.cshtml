@model FuelManagement.Models.PumpsViewModel

<div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg dark:shadow-gray-900/50 overflow-hidden border border-gray-100 dark:border-gray-700">
    <div class="overflow-x-auto">
        <table class="min-w-[1200px] sm:min-w-full divide-y divide-gray-200 dark:divide-gray-700">
            <thead class="bg-gradient-to-r from-yellow-50 to-amber-50 dark:from-gray-700 dark:to-gray-800">
                <tr>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-amber-800 dark:text-amber-300 uppercase tracking-wider">Pump</th>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-amber-800 dark:text-amber-300 uppercase tracking-wider">Fuel Type</th>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-amber-800 dark:text-amber-300 uppercase tracking-wider">Tank</th>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-amber-800 dark:text-amber-300 uppercase tracking-wider">Total Dispensed</th>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-amber-800 dark:text-amber-300 uppercase tracking-wider">Flow Rate</th>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-amber-800 dark:text-amber-300 uppercase tracking-wider">Transactions</th>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-amber-800 dark:text-amber-300 uppercase tracking-wider">Maintenance</th>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-amber-800 dark:text-amber-300 uppercase tracking-wider">Status</th>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-right text-xs font-medium text-amber-800 dark:text-amber-300 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
                @if (Model.PumpItems != null && Model.PumpItems.Any())
                {
                    @foreach (var item in Model.PumpItems)
                    {
                        <tr class="hover:bg-amber-50/30 dark:hover:bg-gray-700/50 transition-colors duration-200 group">
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    <div>
                                        <div class="text-xs sm:text-sm font-medium text-gray-900 dark:text-white">@item.PumpId</div>
                                        <div class="text-xs text-gray-500 dark:text-gray-400">@item.PumpName</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="text-xs sm:text-sm text-gray-900 dark:text-gray-200">@item.FuelType</div>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="text-xs sm:text-sm font-mono text-gray-900 dark:text-gray-200">@item.TankId</div>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="text-xs sm:text-sm font-medium text-gray-900 dark:text-white">@item.FormattedTotalDispensed</div>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="text-xs sm:text-sm text-gray-900 dark:text-gray-200">@item.FormattedFlowRate</div>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="text-xs sm:text-sm text-gray-900 dark:text-gray-200">@item.FormattedTransactions</div>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="flex items-center space-x-1 sm:space-x-2">
                                    <div class="w-12 sm:w-16 h-1.5 sm:h-2 bg-gray-200 dark:bg-gray-600 rounded-full overflow-hidden">
                                        <div class="h-full @item.ProgressBarColor" style="width: @item.MaintenancePercentage%;"></div>
                                    </div>
                                    <span class="text-xs text-gray-600 dark:text-gray-300">@item.DaysUntilMaintenance d</span>
                                </div>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <span class="px-2 sm:px-3 py-1 rounded-full text-xs font-medium @item.StatusColorClass">
                                    @item.Status
                                </span>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap text-right text-xs sm:text-sm font-medium">
                                <div class="flex items-center justify-end space-x-1 sm:space-x-2 opacity-100 sm:opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                                    <a href="@Url.Action("Details", new { id = item.PumpId })"
                                       class="p-1.5 sm:p-2 text-blue-600 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-900/30 rounded-lg transition-colors duration-200" title="View">
                                        <svg class="w-3 h-3 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                        </svg>
                                    </a>
                                    <a href="@Url.Action("Edit", new { id = item.PumpId })"
                                       class="p-1.5 sm:p-2 text-amber-600 dark:text-amber-400 hover:bg-amber-50 dark:hover:bg-amber-900/30 rounded-lg transition-colors duration-200" title="Edit">
                                        <svg class="w-3 h-3 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                        </svg>
                                    </a>
                                    <button type="button"
                                            onclick="showDeleteModal('@item.PumpId', '@item.PumpName')"
                                            class="p-1.5 sm:p-2 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/30 rounded-lg transition-colors duration-200" title="Delete">
                                        <svg class="w-3 h-3 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <!-- Enhanced Empty State with Add Button -->
                    <tr>
                        <td colspan="9" class="px-3 sm:px-6 py-12 text-center">
                            <div class="flex flex-col items-center justify-center">
                                <!-- Empty State Icon -->
                                <div class="w-20 h-20 sm:w-24 sm:h-24 bg-yellow-100 dark:bg-yellow-900/30 rounded-full flex items-center justify-center mb-4">
                                    <svg class="w-10 h-10 sm:w-12 sm:h-12 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
                                    </svg>
                                </div>

                                <!-- Message -->
                                <h3 class="text-lg sm:text-xl font-semibold text-gray-900 dark:text-white mb-2">No pumps found</h3>
                                <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">Get started by adding a new pump.</p>

                                <!-- Add Button -->
                                <a href="@Url.Action("Create")"
                                   class="inline-flex items-center px-4 sm:px-6 py-2.5 sm:py-3 bg-gradient-to-r from-yellow-400 to-amber-500 dark:from-yellow-600 dark:to-amber-600 text-white text-sm font-medium rounded-xl hover:from-yellow-500 dark:hover:from-yellow-700 hover:to-amber-600 dark:hover:to-amber-700 transform hover:scale-105 transition-all duration-200 shadow-lg hover:shadow-xl">
                                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                    </svg>
                                    Add Pump
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="bg-white dark:bg-gray-800 px-4 sm:px-6 py-3 sm:py-4 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-gray-200 dark:border-gray-700">
            <div class="text-sm text-gray-700 dark:text-gray-300 order-2 sm:order-1">
                Showing <span class="font-medium text-gray-900 dark:text-white">@Model.StartIndex</span> to <span class="font-medium text-gray-900 dark:text-white">@Model.EndIndex</span> of <span class="font-medium text-gray-900 dark:text-white">@Model.TotalItems</span> results
            </div>
            <div class="order-1 sm:order-2">
                <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                    <!-- Previous button -->
                    @if (Model.PageNumber > 1)
                    {
                        <a href="@Url.Action("Index", new {
                            page = Model.PageNumber - 1,
                            StartDate = Model.Filter.StartDate,
                            EndDate = Model.Filter.EndDate,
                            PumpId = Model.Filter.PumpId,
                            FuelType = Model.Filter.FuelType,
                            TankId = Model.Filter.TankId,
                            Status = Model.Filter.Status
                        })" class="relative inline-flex items-center px-2 sm:px-3 py-2 rounded-l-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-xs sm:text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700">
                            <span class="sr-only">Previous</span>
                            <svg class="h-4 w-4 sm:h-5 sm:w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                            </svg>
                        </a>
                    }
                    else
                    {
                        <button disabled class="relative inline-flex items-center px-2 sm:px-3 py-2 rounded-l-md border border-gray-300 dark:border-gray-600 bg-gray-100 dark:bg-gray-800 text-xs sm:text-sm font-medium text-gray-400 dark:text-gray-500 cursor-not-allowed">
                            <span class="sr-only">Previous</span>
                            <svg class="h-4 w-4 sm:h-5 sm:w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                            </svg>
                        </button>
                    }

                    <!-- Page numbers -->
                    @{
                        var startPage = Math.Max(1, Model.PageNumber - 2);
                        var endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);

                        if (startPage > 1)
                        {
                            <a href="@Url.Action("Index", new {
                                page = 1,
                                StartDate = Model.Filter.StartDate,
                                EndDate = Model.Filter.EndDate,
                                PumpId = Model.Filter.PumpId,
                                FuelType = Model.Filter.FuelType,
                                TankId = Model.Filter.TankId,
                                Status = Model.Filter.Status
                            })" class="relative inline-flex items-center px-3 sm:px-4 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700">1</a>

                            if (startPage > 2)
                            {
                                <span class="relative inline-flex items-center px-3 sm:px-4 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-300">...</span>
                            }
                        }

                        for (int i = startPage; i <= endPage; i++)
                        {
                            if (i == Model.PageNumber)
                            {
                                <button disabled class="relative inline-flex items-center px-3 sm:px-4 py-2 border border-gray-300 dark:border-gray-600 bg-amber-50 dark:bg-amber-900/30 text-xs sm:text-sm font-medium text-amber-600 dark:text-amber-400 cursor-default">@i</button>
                            }
                            else
                            {
                                <a href="@Url.Action("Index", new {
                                    page = i,
                                    StartDate = Model.Filter.StartDate,
                                    EndDate = Model.Filter.EndDate,
                                    PumpId = Model.Filter.PumpId,
                                    FuelType = Model.Filter.FuelType,
                                    TankId = Model.Filter.TankId,
                                    Status = Model.Filter.Status
                                })" class="relative inline-flex items-center px-3 sm:px-4 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700">@i</a>
                            }
                        }

                        if (endPage < Model.TotalPages)
                        {
                            if (endPage < Model.TotalPages - 1)
                            {
                                <span class="relative inline-flex items-center px-3 sm:px-4 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-300">...</span>
                            }

                            <a href="@Url.Action("Index", new {
                                page = Model.TotalPages,
                                StartDate = Model.Filter.StartDate,
                                EndDate = Model.Filter.EndDate,
                                PumpId = Model.Filter.PumpId,
                                FuelType = Model.Filter.FuelType,
                                TankId = Model.Filter.TankId,
                                Status = Model.Filter.Status
                            })" class="relative inline-flex items-center px-3 sm:px-4 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700">@Model.TotalPages</a>
                        }
                    }

                    <!-- Next button -->
                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <a href="@Url.Action("Index", new {
                            page = Model.PageNumber + 1,
                            StartDate = Model.Filter.StartDate,
                            EndDate = Model.Filter.EndDate,
                            PumpId = Model.Filter.PumpId,
                            FuelType = Model.Filter.FuelType,
                            TankId = Model.Filter.TankId,
                            Status = Model.Filter.Status
                        })" class="relative inline-flex items-center px-2 sm:px-3 py-2 rounded-r-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-xs sm:text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700">
                            <span class="sr-only">Next</span>
                            <svg class="h-4 w-4 sm:h-5 sm:w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                            </svg>
                        </a>
                    }
                    else
                    {
                        <button disabled class="relative inline-flex items-center px-2 sm:px-3 py-2 rounded-r-md border border-gray-300 dark:border-gray-600 bg-gray-100 dark:bg-gray-800 text-xs sm:text-sm font-medium text-gray-400 dark:text-gray-500 cursor-not-allowed">
                            <span class="sr-only">Next</span>
                            <svg class="h-4 w-4 sm:h-5 sm:w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                            </svg>
                        </button>
                    }
                </nav>
            </div>
        </div>
    }
</div>

<script>
    function showDeleteModal(pumpId, pumpName) {
        // Set the values in the delete modal
        document.getElementById('deletePumpId').value = pumpId;
        document.getElementById('deletePumpDisplay').textContent = `${pumpId} - ${pumpName}`;

        // Show the modal
        document.getElementById('deleteModal').classList.remove('hidden');

        // Lock body scroll
        document.body.style.overflow = 'hidden';
        document.body.style.paddingRight = window.innerWidth - document.documentElement.clientWidth + 'px';
    }
</script>