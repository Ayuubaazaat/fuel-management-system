@model FuelManagement.Models.PumpListItemViewModel
@{
    ViewData["Title"] = "Pump Details";
}

<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-900 dark:to-gray-800 py-4 sm:py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="mb-6 sm:mb-8 animate-slideIn">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white">Pump Details</h1>
                    <p class="text-sm sm:text-base mt-2 text-gray-600 dark:text-gray-300">Complete information for @Model.PumpId</p>
                </div>
                <span class="px-3 sm:px-4 py-1.5 sm:py-2 rounded-full text-xs sm:text-sm font-semibold @Model.StatusColorClass self-start sm:self-auto">
                    @Model.Status
                </span>
            </div>
        </div>

        <!-- Details Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 animate-fadeIn">
            <!-- Pump Info Card -->
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg dark:shadow-gray-900/50 p-4 sm:p-6 card-hover">
                <div class="flex items-center mb-3 sm:mb-4">
                    <div class="w-8 h-8 sm:w-10 sm:h-10 bg-yellow-100 dark:bg-yellow-900/50 rounded-lg flex items-center justify-center">
                        <svg class="w-4 h-4 sm:w-5 sm:h-5 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <h2 class="ml-2 sm:ml-3 text-base sm:text-lg font-semibold text-gray-900 dark:text-white">Pump Information</h2>
                </div>
                <div class="space-y-2 sm:space-y-3">
                    <div class="flex flex-col sm:flex-row sm:justify-between py-2 border-b border-gray-100 dark:border-gray-700">
                        <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-300">Pump ID:</span>
                        <span class="text-xs sm:text-sm font-semibold text-gray-900 dark:text-white">@Model.PumpId</span>
                    </div>
                    <div class="flex flex-col sm:flex-row sm:justify-between py-2 border-b border-gray-100 dark:border-gray-700">
                        <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-300">Pump Name:</span>
                        <span class="text-xs sm:text-sm font-semibold text-gray-900 dark:text-white">@Model.PumpName</span>
                    </div>
                    <div class="flex flex-col sm:flex-row sm:justify-between py-2 border-b border-gray-100 dark:border-gray-700">
                        <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-300">Fuel Type:</span>
                        <span class="text-xs sm:text-sm font-semibold text-gray-900 dark:text-white">@Model.FuelType</span>
                    </div>
                    <div class="flex flex-col sm:flex-row sm:justify-between py-2 border-b border-gray-100 dark:border-gray-700">
                        <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-300">Connected Tank:</span>
                        <span class="text-xs sm:text-sm font-semibold text-gray-900 dark:text-white">@Model.TankId</span>
                    </div>
                </div>
            </div>

            <!-- Performance Card -->
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg dark:shadow-gray-900/50 p-4 sm:p-6 card-hover">
                <div class="flex items-center mb-3 sm:mb-4">
                    <div class="w-8 h-8 sm:w-10 sm:h-10 bg-amber-100 dark:bg-amber-900/50 rounded-lg flex items-center justify-center">
                        <svg class="w-4 h-4 sm:w-5 sm:h-5 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                        </svg>
                    </div>
                    <h2 class="ml-2 sm:ml-3 text-base sm:text-lg font-semibold text-gray-900 dark:text-white">Performance</h2>
                </div>
                <div class="space-y-2 sm:space-y-3">
                    <div class="flex flex-col sm:flex-row sm:justify-between py-2 border-b border-gray-100 dark:border-gray-700">
                        <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-300">Total Dispensed:</span>
                        <span class="text-xs sm:text-sm font-semibold text-gray-900 dark:text-white">@Model.FormattedTotalDispensed</span>
                    </div>
                    <div class="flex flex-col sm:flex-row sm:justify-between py-2 border-b border-gray-100 dark:border-gray-700">
                        <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-300">Flow Rate:</span>
                        <span class="text-xs sm:text-sm font-semibold text-gray-900 dark:text-white">@Model.FormattedFlowRate</span>
                    </div>
                    <div class="flex flex-col sm:flex-row sm:justify-between py-2 border-b border-gray-100 dark:border-gray-700">
                        <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-300">Transactions:</span>
                        <span class="text-xs sm:text-sm font-semibold text-gray-900 dark:text-white">@Model.FormattedTransactions</span>
                    </div>
                </div>
            </div>

            <!-- Maintenance Card -->
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg dark:shadow-gray-900/50 p-4 sm:p-6 card-hover md:col-span-2">
                <div class="flex items-center mb-3 sm:mb-4">
                    <div class="w-8 h-8 sm:w-10 sm:h-10 bg-purple-100 dark:bg-purple-900/50 rounded-lg flex items-center justify-center">
                        <svg class="w-4 h-4 sm:w-5 sm:h-5 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <h2 class="ml-2 sm:ml-3 text-base sm:text-lg font-semibold text-gray-900 dark:text-white">Maintenance</h2>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="space-y-2">
                        <div class="flex justify-between py-2 border-b border-gray-100 dark:border-gray-700">
                            <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-300">Last Maintenance:</span>
                            <span class="text-xs sm:text-sm font-semibold text-gray-900 dark:text-white">@Model.FormattedLastMaintenance</span>
                        </div>
                        <div class="flex justify-between py-2 border-b border-gray-100 dark:border-gray-700">
                            <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-300">Next Maintenance:</span>
                            <span class="text-xs sm:text-sm font-semibold text-gray-900 dark:text-white">@Model.FormattedNextMaintenance</span>
                        </div>
                    </div>
                    <div class="space-y-2">
                        <div class="flex justify-between text-xs sm:text-sm text-gray-600 dark:text-gray-300">
                            <span>Days until maintenance: <span class="font-semibold text-gray-900 dark:text-white">@Model.DaysUntilMaintenance</span></span>
                            <span class="font-semibold text-gray-900 dark:text-white">@Model.MaintenancePercentage%</span>
                        </div>
                        <div class="w-full h-3 sm:h-4 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
                            <div class="h-full @Model.ProgressBarColor transition-all duration-500 ease-out"
                                 style="width: @Model.MaintenancePercentage%;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="mt-6 sm:mt-8 flex flex-col sm:flex-row gap-3 animate-fadeIn">
            <a href="@Url.Action("Edit", new { id = Model.PumpId })"
               class="w-full sm:w-auto px-4 sm:px-6 py-2.5 bg-gradient-to-r from-yellow-400 to-amber-500 dark:from-yellow-600 dark:to-amber-600 text-white font-medium rounded-lg hover:from-yellow-500 dark:hover:from-yellow-700 hover:to-amber-600 dark:hover:to-amber-700 transform hover:scale-105 transition-all duration-200 shadow-lg hover:shadow-xl text-center">
                Edit Pump
            </a>
            <a href="@Url.Action("Index")"
               class="w-full sm:w-auto px-4 sm:px-6 py-2.5 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-700 dark:text-gray-300 font-medium hover:bg-gray-50 dark:hover:bg-gray-700 transition-all duration-200 text-center">
                Back to List
            </a>
        </div>
    </div>
</div>

<style>
    .card-hover {
        transition: all 0.3s ease;
    }

        .card-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px -5px rgba(250, 204, 21, 0.1), 0 10px 10px -5px rgba(250, 204, 21, 0.04);
        }

    .dark .card-hover:hover {
        box-shadow: 0 20px 25px -5px rgba(250, 204, 21, 0.2), 0 10px 10px -5px rgba(250, 204, 21, 0.1);
    }

    .animate-slideIn {
        animation: slideIn 0.6s ease-out;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateX(-20px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .animate-fadeIn {
        animation: fadeIn 0.6s ease-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>