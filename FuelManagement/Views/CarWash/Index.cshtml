@model IEnumerable<FuelManagement.Models.CarWash>
@{
    ViewData["Title"] = "Car Wash";
    var isAdmin = ViewBag.IsAdmin ?? false;
}

<!-- ===================== HERO BANNER ===================== -->
<div class="relative overflow-hidden rounded-2xl mb-6 bg-gradient-to-br from-cyan-500 via-blue-600 to-indigo-700 dark:from-cyan-800 dark:via-blue-900 dark:to-indigo-950 p-6 md:p-8 shadow-lg">
    <!-- Background decoration -->
    <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full -translate-y-32 translate-x-32"></div>
    <div class="absolute bottom-0 left-0 w-48 h-48 bg-white/5 rounded-full translate-y-24 -translate-x-24"></div>
    <div class="absolute top-1/2 right-1/4 w-32 h-32 bg-white/5 rounded-full"></div>

    <div class="relative z-10 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center">
                    <i class="fas fa-soap text-white text-lg"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-semibold text-cyan-200 uppercase tracking-widest">Car Wash Module</span>
                        <span class="flex items-center gap-1 text-xs bg-green-400/20 text-green-300 px-2 py-0.5 rounded-full border border-green-400/30">
                            <span class="w-1.5 h-1.5 bg-green-400 rounded-full animate-pulse"></span>
                            Live
                        </span>
                    </div>
                    <h1 class="text-2xl md:text-3xl font-bold text-white mt-0.5">Car Wash Management</h1>
                </div>
            </div>
            <p class="text-cyan-100/80 text-sm max-w-md">Track vehicle wash services, payments, and staff assignments in real-time.</p>
            <div class="flex items-center gap-4 mt-3 text-xs text-cyan-200/70">
                <span><i class="fas fa-calendar-day mr-1"></i>@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
                <span><i class="fas fa-car mr-1"></i>@ViewBag.TodayWashes washes today</span>
            </div>
        </div>
        <div class="flex flex-wrap gap-2">
            <a href="@Url.Action("Create")"
               class="flex items-center gap-2 px-4 py-2.5 bg-white text-blue-700 hover:bg-blue-50 font-semibold text-sm rounded-xl transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5">
                <i class="fas fa-plus"></i>
                New Record
            </a>
        </div>
    </div>

    <!-- Hero quick stats strip -->
    <div class="relative z-10 grid grid-cols-2 md:grid-cols-4 gap-3 mt-6">
        <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl p-3 text-center">
            <p class="text-xs text-cyan-200/70 uppercase tracking-wide mb-1">Today's Revenue</p>
            <p class="text-xl font-bold text-white">$@ViewBag.TodayRevenue.ToString("F2")</p>
        </div>
        <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl p-3 text-center">
            <p class="text-xs text-cyan-200/70 uppercase tracking-wide mb-1">Total Revenue</p>
            <p class="text-xl font-bold text-white">$@ViewBag.TotalRevenue.ToString("F2")</p>
        </div>
        <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl p-3 text-center">
            <p class="text-xs text-cyan-200/70 uppercase tracking-wide mb-1">In Progress</p>
            <p class="text-xl font-bold text-yellow-300">@ViewBag.InProgressCount</p>
        </div>
        <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl p-3 text-center">
            <p class="text-xs text-cyan-200/70 uppercase tracking-wide mb-1">Unpaid</p>
            <p class="text-xl font-bold text-red-300">@ViewBag.UnpaidCount</p>
        </div>
    </div>
</div>

<!-- ===================== SUMMARY CARDS ===================== -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">

    <!-- Total Washes -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl p-4 shadow-sm border border-gray-100 dark:border-gray-700 card-hover">
        <div class="flex items-center justify-between mb-3">
            <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-900/40 flex items-center justify-center">
                <i class="fas fa-soap text-blue-600 dark:text-blue-400"></i>
            </div>
            <span class="text-xs font-medium text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/30 px-2 py-0.5 rounded-full">All Time</span>
        </div>
        <p class="text-2xl font-bold text-gray-800 dark:text-gray-100">@ViewBag.TotalWashes</p>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Total Washes</p>
    </div>

    <!-- Pending -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl p-4 shadow-sm border border-gray-100 dark:border-gray-700 card-hover">
        <div class="flex items-center justify-between mb-3">
            <div class="w-10 h-10 rounded-xl bg-yellow-100 dark:bg-yellow-900/40 flex items-center justify-center">
                <i class="fas fa-clock text-yellow-600 dark:text-yellow-400"></i>
            </div>
            <span class="text-xs font-medium text-yellow-600 dark:text-yellow-400 bg-yellow-50 dark:bg-yellow-900/30 px-2 py-0.5 rounded-full">Waiting</span>
        </div>
        <p class="text-2xl font-bold text-gray-800 dark:text-gray-100">@ViewBag.PendingCount</p>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Pending</p>
    </div>

    <!-- Completed -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl p-4 shadow-sm border border-gray-100 dark:border-gray-700 card-hover">
        <div class="flex items-center justify-between mb-3">
            <div class="w-10 h-10 rounded-xl bg-green-100 dark:bg-green-900/40 flex items-center justify-center">
                <i class="fas fa-check-circle text-green-600 dark:text-green-400"></i>
            </div>
            <span class="text-xs font-medium text-green-600 dark:text-green-400 bg-green-50 dark:bg-green-900/30 px-2 py-0.5 rounded-full">Done</span>
        </div>
        <p class="text-2xl font-bold text-gray-800 dark:text-gray-100">@ViewBag.CompletedCount</p>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Completed</p>
    </div>

    <!-- Cancelled -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl p-4 shadow-sm border border-gray-100 dark:border-gray-700 card-hover">
        <div class="flex items-center justify-between mb-3">
            <div class="w-10 h-10 rounded-xl bg-red-100 dark:bg-red-900/40 flex items-center justify-center">
                <i class="fas fa-times-circle text-red-600 dark:text-red-400"></i>
            </div>
            <span class="text-xs font-medium text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/30 px-2 py-0.5 rounded-full">Cancelled</span>
        </div>
        <p class="text-2xl font-bold text-gray-800 dark:text-gray-100">@ViewBag.CancelledCount</p>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Cancelled</p>
    </div>
</div>

<!-- ===================== FILTER BAR ===================== -->
<div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-4 mb-6">
    <form method="get" asp-action="Index" id="filterForm">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3">

            <!-- Search -->
            <div class="lg:col-span-2 relative">
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 dark:text-gray-500 text-sm"></i>
                <input type="text"
                       name="searchTerm"
                       value="@ViewBag.SearchTerm"
                       placeholder="Search name, plate, staff..."
                       class="w-full pl-9 pr-3 py-2.5 text-sm border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-gray-100 rounded-xl focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 placeholder-gray-400 dark:placeholder-gray-500" />
            </div>

            <!-- Status -->
            <select name="statusFilter"
                    onchange="document.getElementById('filterForm').submit()"
                    class="py-2.5 px-3 text-sm border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-gray-100 rounded-xl focus:outline-none focus:border-blue-500">
                <option value="">All Statuses</option>
                @foreach (var s in new[] { "Pending", "InProgress", "Completed", "Cancelled" })
                {
                    <option value="@s" selected="@(ViewBag.StatusFilter == s ? "selected" : null)">@s</option>
                }
            </select>

            <!-- Service Type -->
            <select name="serviceFilter"
                    onchange="document.getElementById('filterForm').submit()"
                    class="py-2.5 px-3 text-sm border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-gray-100 rounded-xl focus:outline-none focus:border-blue-500">
                <option value="">All Services</option>
                @foreach (var s in new[] { "Basic", "Standard", "Full", "Premium" })
                {
                    <option value="@s" selected="@(ViewBag.ServiceFilter == s ? "selected" : null)">@s</option>
                }
            </select>

            <!-- Payment -->
            <select name="paymentFilter"
                    onchange="document.getElementById('filterForm').submit()"
                    class="py-2.5 px-3 text-sm border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-gray-100 rounded-xl focus:outline-none focus:border-blue-500">
                <option value="">All Payments</option>
                <option value="Paid" selected="@(ViewBag.PaymentFilter == "Paid"   ? "selected" : null)">Paid</option>
                <option value="Unpaid" selected="@(ViewBag.PaymentFilter == "Unpaid" ? "selected" : null)">Unpaid</option>
            </select>

            <!-- Actions -->
            <div class="flex gap-2">
                <button type="submit"
                        class="flex-1 flex items-center justify-center gap-1.5 px-3 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-xl transition-colors">
                    <i class="fas fa-filter text-xs"></i> Filter
                </button>
                <a href="@Url.Action("Index")"
                   class="flex items-center justify-center px-3 py-2.5 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-600 dark:text-gray-300 text-sm rounded-xl transition-colors">
                    <i class="fas fa-times text-xs"></i>
                </a>
            </div>
        </div>

        <!-- Date range row -->
        <div class="flex flex-col sm:flex-row gap-3 mt-3">
            <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
                <i class="fas fa-calendar-alt"></i>
                <span>Date range:</span>
            </div>
            <input type="date" name="dateFrom" value="@ViewBag.DateFrom"
                   onchange="document.getElementById('filterForm').submit()"
                   class="px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-gray-100 rounded-xl focus:outline-none focus:border-blue-500" />
            <span class="text-gray-400 dark:text-gray-500 self-center text-sm">to</span>
            <input type="date" name="dateTo" value="@ViewBag.DateTo"
                   onchange="document.getElementById('filterForm').submit()"
                   class="px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-gray-100 rounded-xl focus:outline-none focus:border-blue-500" />
        </div>
    </form>
</div>

<!-- ===================== TABLE ===================== -->
<div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">

    <!-- Table header -->
    <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100 dark:border-gray-700">
        <div class="flex items-center gap-2">
            <i class="fas fa-list text-blue-500 dark:text-blue-400"></i>
            <h2 class="text-sm font-semibold text-gray-800 dark:text-gray-100">Records</h2>
            <span class="text-xs bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 px-2 py-0.5 rounded-full font-medium">
                @Model.Count() found
            </span>
        </div>
        <a href="@Url.Action("Create")"
           class="flex items-center gap-1.5 px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-medium rounded-lg transition-colors">
            <i class="fas fa-plus text-xs"></i> Add New
        </a>
    </div>

    @if (!Model.Any())
    {
        <!-- Empty state -->
        <div class="flex flex-col items-center justify-center py-20 text-center">
            <div class="w-16 h-16 bg-gray-100 dark:bg-gray-700 rounded-2xl flex items-center justify-center mb-4">
                <i class="fas fa-soap text-3xl text-gray-300 dark:text-gray-500"></i>
            </div>
            <p class="text-gray-500 dark:text-gray-400 font-medium">No car wash records found</p>
            <p class="text-gray-400 dark:text-gray-500 text-sm mt-1">Try adjusting your filters or add a new record</p>
            <a href="@Url.Action("Create")"
               class="mt-4 flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-xl transition-colors">
                <i class="fas fa-plus"></i> Add First Record
            </a>
        </div>
    }
    else
    {
        <!-- Desktop Table -->
        <div class="hidden md:block overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-gray-50 dark:bg-gray-700/60 text-xs uppercase tracking-wider">
                        <th class="px-4 py-3 text-left text-gray-500 dark:text-gray-400 font-semibold">#</th>
                        <th class="px-4 py-3 text-left text-gray-500 dark:text-gray-400 font-semibold">Customer</th>
                        <th class="px-4 py-3 text-left text-gray-500 dark:text-gray-400 font-semibold">Vehicle</th>
                        <th class="px-4 py-3 text-left text-gray-500 dark:text-gray-400 font-semibold">Service</th>
                        <th class="px-4 py-3 text-left text-gray-500 dark:text-gray-400 font-semibold">Price</th>
                        <th class="px-4 py-3 text-left text-gray-500 dark:text-gray-400 font-semibold">Status</th>
                        <th class="px-4 py-3 text-left text-gray-500 dark:text-gray-400 font-semibold">Payment</th>
                        <th class="px-4 py-3 text-left text-gray-500 dark:text-gray-400 font-semibold">Assigned To</th>
                        <th class="px-4 py-3 text-left text-gray-500 dark:text-gray-400 font-semibold">Date</th>
                        <th class="px-4 py-3 text-center text-gray-500 dark:text-gray-400 font-semibold">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/40 transition-colors group">

                            <!-- ID -->
                            <td class="px-4 py-3 text-gray-400 dark:text-gray-500 font-mono text-xs">#@item.Id</td>

                            <!-- Customer -->
                            <td class="px-4 py-3">
                                <div class="flex items-center gap-2">
                                    <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-cyan-400 to-blue-500 flex items-center justify-center text-white text-xs font-bold flex-shrink-0">
                                        @item.CustomerName.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <p class="font-medium text-gray-800 dark:text-gray-100 text-xs">@item.CustomerName</p>
                                    </div>
                                </div>
                            </td>

                            <!-- Vehicle -->
                            <td class="px-4 py-3">
                                <p class="font-semibold text-gray-800 dark:text-gray-100 text-xs font-mono">@item.VehiclePlate</p>
                                <p class="text-gray-400 dark:text-gray-500 text-xs">@item.VehicleType</p>
                            </td>

                            <!-- Service -->
                            <td class="px-4 py-3">
                                @{
                                    var serviceColor = item.ServiceType switch
                                    {
                                        "Basic" => "bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300",
                                        "Standard" => "bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300",
                                        "Full" => "bg-purple-100 dark:bg-purple-900/40 text-purple-700 dark:text-purple-300",
                                        "Premium" => "bg-amber-100 dark:bg-amber-900/40 text-amber-700 dark:text-amber-300",
                                        _ => "bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300"
                                    };
                                }
                                <span class="px-2 py-0.5 rounded-lg text-xs font-medium @serviceColor">@item.ServiceType</span>
                            </td>

                            <!-- Price -->
                            <td class="px-4 py-3">
                                <span class="font-semibold text-gray-800 dark:text-gray-100 text-xs">$@item.Price.ToString("F2")</span>
                            </td>

                            <!-- Status -->
                            <td class="px-4 py-3">
                                @{
                                    var (statusColor, statusIcon) = item.Status switch
                                    {
                                        "Pending" => ("bg-yellow-100 dark:bg-yellow-900/40 text-yellow-700 dark:text-yellow-300", "fa-clock"),
                                        "InProgress" => ("bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300", "fa-spinner fa-spin"),
                                        "Completed" => ("bg-green-100 dark:bg-green-900/40 text-green-700 dark:text-green-300", "fa-check-circle"),
                                        "Cancelled" => ("bg-red-100 dark:bg-red-900/40 text-red-700 dark:text-red-300", "fa-times-circle"),
                                        _ => ("bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300", "fa-circle")
                                    };
                                }
                                <div class="flex items-center gap-1">
                                    <span class="px-2 py-0.5 rounded-lg text-xs font-medium flex items-center gap-1 @statusColor">
                                        <i class="fas @statusIcon text-xs"></i>
                                        @item.Status
                                    </span>
                                    <!-- Quick status dropdown -->
                                    <div class="relative opacity-0 group-hover:opacity-100 transition-opacity">
                                        <button onclick="toggleStatusMenu(@item.Id)"
                                                class="w-5 h-5 flex items-center justify-center text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 rounded">
                                            <i class="fas fa-chevron-down text-xs"></i>
                                        </button>
                                        <div id="statusMenu-@item.Id"
                                             class="hidden absolute left-0 top-full mt-1 w-36 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-600 rounded-xl shadow-lg z-20 py-1">
                                            @foreach (var st in new[] { "Pending", "InProgress", "Completed", "Cancelled" })
                                            {
                                                <button onclick="quickUpdateStatus(@item.Id, '@st')"
                                                        class="w-full text-left px-3 py-1.5 text-xs text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors @(item.Status == st ? "font-semibold" : "")">
                                                    @st
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <!-- Payment -->
                            <td class="px-4 py-3">
                                @{
                                    var payColor = item.PaymentStatus == "Paid"
                                    ? "bg-green-100 dark:bg-green-900/40 text-green-700 dark:text-green-300"
                                    : "bg-red-100 dark:bg-red-900/40 text-red-700 dark:text-red-300";
                                    var payIcon = item.PaymentStatus == "Paid" ? "fa-check" : "fa-exclamation";
                                }
                                <button onclick="quickUpdatePayment(@item.Id, '@(item.PaymentStatus == "Paid" ? "Unpaid" : "Paid")')"
                                        class="px-2 py-0.5 rounded-lg text-xs font-medium flex items-center gap-1 @payColor hover:opacity-80 transition-opacity cursor-pointer"
                                        title="Click to toggle payment">
                                    <i class="fas @payIcon text-xs"></i>
                                    @item.PaymentStatus
                                </button>
                                <p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5">@item.PaymentMethod</p>
                            </td>

                            <!-- Assigned To -->
                            <td class="px-4 py-3">
                                @if (!string.IsNullOrEmpty(item.AssignedTo))
                                {
                                    <div class="flex items-center gap-1.5">
                                        <div class="w-5 h-5 rounded-md bg-indigo-100 dark:bg-indigo-900/40 flex items-center justify-center">
                                            <i class="fas fa-user text-indigo-500 dark:text-indigo-400 text-xs"></i>
                                        </div>
                                        <span class="text-xs text-gray-700 dark:text-gray-300">@item.AssignedTo</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-xs text-gray-400 dark:text-gray-500 italic">Unassigned</span>
                                }
                            </td>

                            <!-- Date -->
                            <td class="px-4 py-3">
                                <p class="text-xs text-gray-600 dark:text-gray-300">@item.CreatedAt.ToString("MMM dd, yyyy")</p>
                                <p class="text-xs text-gray-400 dark:text-gray-500">@item.CreatedAt.ToString("hh:mm tt")</p>
                            </td>

                            <!-- Actions -->
                            <td class="px-4 py-3">
                                <div class="flex items-center justify-center gap-1">
                                    <a href="@Url.Action("Details", new { id = item.Id })"
                                       title="View Details"
                                       class="w-7 h-7 flex items-center justify-center rounded-lg bg-gray-100 dark:bg-gray-700 hover:bg-blue-100 dark:hover:bg-blue-900/40 text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                                        <i class="fas fa-eye text-xs"></i>
                                    </a>
                                    <a href="@Url.Action("Edit", new { id = item.Id })"
                                       title="Edit"
                                       class="w-7 h-7 flex items-center justify-center rounded-lg bg-gray-100 dark:bg-gray-700 hover:bg-yellow-100 dark:hover:bg-yellow-900/40 text-gray-500 dark:text-gray-400 hover:text-yellow-600 dark:hover:text-yellow-400 transition-colors">
                                        <i class="fas fa-edit text-xs"></i>
                                    </a>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <button onclick="confirmDelete(@item.Id, '@item.CustomerName', '@item.VehiclePlate')"
                                                title="Delete"
                                                class="w-7 h-7 flex items-center justify-center rounded-lg bg-gray-100 dark:bg-gray-700 hover:bg-red-100 dark:hover:bg-red-900/40 text-gray-500 dark:text-gray-400 hover:text-red-600 dark:hover:text-red-400 transition-colors">
                                            <i class="fas fa-trash text-xs"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- ===================== MOBILE CARDS ===================== -->
        <div class="md:hidden divide-y divide-gray-100 dark:divide-gray-700">
            @foreach (var item in Model)
            {
                <div class="p-4">
                    <div class="flex items-start justify-between mb-3">
                        <div class="flex items-center gap-2">
                            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-cyan-400 to-blue-500 flex items-center justify-center text-white text-sm font-bold">
                                @item.CustomerName.Substring(0, 1).ToUpper()
                            </div>
                            <div>
                                <p class="font-semibold text-gray-800 dark:text-gray-100 text-sm">@item.CustomerName</p>
                                <p class="text-xs font-mono text-gray-500 dark:text-gray-400">@item.VehiclePlate · @item.VehicleType</p>
                            </div>
                        </div>
                        <span class="font-bold text-gray-800 dark:text-gray-100 text-sm">$@item.Price.ToString("F2")</span>
                    </div>

                    <div class="flex flex-wrap gap-2 mb-3">
                        @{
                            var mServiceColor = item.ServiceType switch
                            {
                                "Basic" => "bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300",
                                "Standard" => "bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300",
                                "Full" => "bg-purple-100 dark:bg-purple-900/40 text-purple-700 dark:text-purple-300",
                                "Premium" => "bg-amber-100 dark:bg-amber-900/40 text-amber-700 dark:text-amber-300",
                                _ => "bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300"
                            };
                            var mStatusColor = item.Status switch
                            {
                                "Pending" => "bg-yellow-100 dark:bg-yellow-900/40 text-yellow-700 dark:text-yellow-300",
                                "InProgress" => "bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300",
                                "Completed" => "bg-green-100 dark:bg-green-900/40 text-green-700 dark:text-green-300",
                                "Cancelled" => "bg-red-100 dark:bg-red-900/40 text-red-700 dark:text-red-300",
                                _ => "bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300"
                            };
                            var mPayColor = item.PaymentStatus == "Paid"
                            ? "bg-green-100 dark:bg-green-900/40 text-green-700 dark:text-green-300"
                            : "bg-red-100 dark:bg-red-900/40 text-red-700 dark:text-red-300";
                        }
                        <span class="px-2 py-0.5 rounded-lg text-xs font-medium @mServiceColor">@item.ServiceType</span>
                        <span class="px-2 py-0.5 rounded-lg text-xs font-medium @mStatusColor">@item.Status</span>
                        <span class="px-2 py-0.5 rounded-lg text-xs font-medium @mPayColor">@item.PaymentStatus</span>
                    </div>

                    <div class="flex items-center justify-between text-xs text-gray-400 dark:text-gray-500">
                        <span><i class="fas fa-calendar mr-1"></i>@item.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</span>
                        <div class="flex gap-2">
                            <a href="@Url.Action("Details", new { id = item.Id })" class="text-blue-500 dark:text-blue-400 hover:underline">View</a>
                            <a href="@Url.Action("Edit", new { id = item.Id })" class="text-yellow-500 dark:text-yellow-400 hover:underline">Edit</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <button onclick="confirmDelete(@item.Id, '@item.CustomerName', '@item.VehiclePlate')"
                                        class="text-red-500 dark:text-red-400 hover:underline">
                                    Delete
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- ===================== DELETE MODAL ===================== -->
<div id="deleteModal" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-2xl w-full max-w-md border border-gray-200 dark:border-gray-700 animate-scaleIn">
        <div class="p-6">
            <div class="w-12 h-12 bg-red-100 dark:bg-red-900/40 rounded-2xl flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-trash text-red-500 dark:text-red-400 text-xl"></i>
            </div>
            <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100 text-center mb-1">Delete Record</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 text-center mb-1">Are you sure you want to delete the record for</p>
            <p id="deleteInfo" class="text-sm font-semibold text-gray-800 dark:text-gray-100 text-center mb-6"></p>
            <div class="flex gap-3">
                <button onclick="closeDeleteModal()"
                        class="flex-1 px-4 py-2.5 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 text-sm font-medium rounded-xl transition-colors">
                    Cancel
                </button>
                <form id="deleteForm" method="post" class="flex-1">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="w-full px-4 py-2.5 bg-red-600 hover:bg-red-700 text-white text-sm font-medium rounded-xl transition-colors">
                        Yes, Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ========== DELETE MODAL ==========
        function confirmDelete(id, name, plate) {
            document.getElementById('deleteInfo').textContent = name + ' (' + plate + ')';
            document.getElementById('deleteForm').action = '/CarWash/Delete/' + id;
            document.getElementById('deleteModal').classList.remove('hidden');
        }

        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.add('hidden');
        }

        document.getElementById('deleteModal').addEventListener('click', function(e) {
            if (e.target === this) closeDeleteModal();
        });

        // ========== STATUS QUICK MENU ==========
        function toggleStatusMenu(id) {
            const menu = document.getElementById('statusMenu-' + id);
            document.querySelectorAll('[id^="statusMenu-"]').forEach(m => {
                if (m !== menu) m.classList.add('hidden');
            });
            menu.classList.toggle('hidden');
        }

        document.addEventListener('click', function(e) {
            if (!e.target.closest('[id^="statusMenu-"]') && !e.target.closest('button[onclick^="toggleStatusMenu"]')) {
                document.querySelectorAll('[id^="statusMenu-"]').forEach(m => m.classList.add('hidden'));
            }
        });

        // ========== QUICK STATUS UPDATE (AJAX) ==========
        async function quickUpdateStatus(id, status) {
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
                const res = await fetch('/CarWash/UpdateStatus', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `id=${id}&status=${status}&__RequestVerificationToken=${encodeURIComponent(token)}`
                });
                const data = await res.json();
                if (data.success) location.reload();
            } catch (e) { console.error(e); }
        }

        // ========== QUICK PAYMENT TOGGLE (AJAX) ==========
        async function quickUpdatePayment(id, paymentStatus) {
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
                const res = await fetch('/CarWash/UpdatePayment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `id=${id}&paymentStatus=${paymentStatus}&__RequestVerificationToken=${encodeURIComponent(token)}`
                });
                const data = await res.json();
                if (data.success) location.reload();
            } catch (e) { console.error(e); }
        }

        // Hidden CSRF token for AJAX calls
    </script>
    <input type="hidden" name="__RequestVerificationToken" value="@Html.AntiForgeryToken()" />
}