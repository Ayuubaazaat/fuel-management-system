@model FuelManagement.Models.TripFilterViewModel

<div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-lg rounded-2xl shadow-lg dark:shadow-gray-900/50 p-4 sm:p-6 border border-blue-100 dark:border-blue-900/30">
    <form method="get" asp-action="Index" asp-controller="Trips" class="space-y-4" id="filterForm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 sm:gap-0 mb-4">
            <h3 class="text-base sm:text-lg font-semibold text-gray-900 dark:text-white">Filter Trips</h3>
            <button type="button" onclick="clearAllFilters()"
                    class="text-sm text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-medium text-left sm:text-right">
                Clear All
            </button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 sm:gap-4">
            <!-- Date Range -->
            <div class="space-y-1 sm:space-y-2">
                <label class="text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-300">From</label>
                <input type="date" name="StartDate" id="StartDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                       class="w-full px-3 sm:px-4 py-2 sm:py-2.5 text-sm rounded-xl border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:border-blue-500 dark:focus:border-blue-400 focus:ring-2 focus:ring-blue-200 dark:focus:ring-blue-800 transition-all duration-200" />
            </div>

            <div class="space-y-1 sm:space-y-2">
                <label class="text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-300">To</label>
                <input type="date" name="EndDate" id="EndDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                       class="w-full px-3 sm:px-4 py-2 sm:py-2.5 text-sm rounded-xl border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:border-blue-500 dark:focus:border-blue-400 focus:ring-2 focus:ring-blue-200 dark:focus:ring-blue-800 transition-all duration-200" />
            </div>

            <!-- Trip ID Input - Changed from Vehicle to Trip ID -->
            <div class="space-y-1 sm:space-y-2">
                <label class="text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-300">Trip ID</label>
                <input type="text" name="TripId" id="TripId" value="@Model.TripId"
                       placeholder="e.g. TRP-001, TRP-002"
                       class="w-full px-3 sm:px-4 py-2 sm:py-2.5 text-sm rounded-xl border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:border-blue-500 dark:focus:border-blue-400 focus:ring-2 focus:ring-blue-200 dark:focus:ring-blue-800 transition-all duration-200" />
            </div>

            <!-- Driver Input -->
            <div class="space-y-1 sm:space-y-2">
                <label class="text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-300">Driver</label>
                <input type="text" name="DriverName" id="DriverName" value="@Model.DriverName"
                       placeholder="e.g. feetarka"
                       class="w-full px-3 sm:px-4 py-2 sm:py-2.5 text-sm rounded-xl border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:border-blue-500 dark:focus:border-blue-400 focus:ring-2 focus:ring-blue-200 dark:focus:ring-blue-800 transition-all duration-200" />
            </div>

            <!-- Min Distance -->
            <div class="space-y-1 sm:space-y-2">
                <label class="text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-300">Min Distance</label>
                <input type="number" name="MinDistance" id="MinDistance" value="@Model.MinDistance"
                       placeholder="e.g. 10"
                       class="w-full px-3 sm:px-4 py-2 sm:py-2.5 text-sm rounded-xl border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:border-blue-500 dark:focus:border-blue-400 focus:ring-2 focus:ring-blue-200 dark:focus:ring-blue-800 transition-all duration-200" />
            </div>
        </div>

        <div class="flex justify-end pt-2 sm:pt-4">
            <button type="submit"
                    class="w-full sm:w-auto px-4 sm:px-6 py-2.5 sm:py-2.5 bg-gradient-to-r from-blue-400 to-indigo-500 dark:from-blue-600 dark:to-indigo-600 text-white font-medium rounded-xl hover:from-blue-500 dark:hover:from-blue-700 hover:to-indigo-600 dark:hover:to-indigo-700 transform hover:scale-105 transition-all duration-200 shadow-lg hover:shadow-xl text-sm sm:text-base">
                Apply Filters
            </button>
        </div>
    </form>
</div>

<script>
    function clearAllFilters() {
        document.getElementById('StartDate').value = '';
        document.getElementById('EndDate').value = '';
        document.getElementById('TripId').value = '';
        document.getElementById('DriverName').value = '';
        document.getElementById('MinDistance').value = '';
        document.getElementById('filterForm').submit();
    }

    // Date validation
    document.getElementById('StartDate')?.addEventListener('change', function() {
        const toDate = document.getElementById('EndDate');
        if (toDate.value && this.value > toDate.value) {
            alert('From date cannot be after To date');
            this.value = '';
        }
    });

    document.getElementById('EndDate')?.addEventListener('change', function() {
        const fromDate = document.getElementById('StartDate');
        if (fromDate.value && this.value < fromDate.value) {
            alert('To date cannot be before From date');
            this.value = '';
        }
    });
</script>