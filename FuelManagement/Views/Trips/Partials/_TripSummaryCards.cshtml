@model FuelManagement.Models.TripsViewModel

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
    <!-- Total Trips Card -->
    <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl shadow-lg dark:shadow-gray-900/50 p-4 sm:p-6 card-hover animate-fadeIn border border-blue-100 dark:border-blue-900/30 group" style="animation-delay: 0.1s;">
        <div class="flex items-center justify-between mb-3 sm:mb-4">
            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-blue-100 dark:bg-blue-900/50 rounded-xl flex items-center justify-center group-hover:bg-blue-200 dark:group-hover:bg-blue-800/40 transition-colors duration-300">
                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-blue-600 dark:text-blue-400 group-hover:text-blue-700 dark:group-hover:text-blue-300 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A2 2 0 013 15.382V4a1 1 0 011-1h4a1 1 0 011 1v1m0 0h8m-8 0V4a1 1 0 00-1-1H8m10 6v9a2 2 0 01-2 2H6a2 2 0 01-2-2v-9m14 0h.01M8 10h.01M12 10h.01M16 10h.01M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01M16 18h.01"></path>
                </svg>
            </div>
            <span class="text-xs sm:text-sm font-semibold text-green-600 dark:text-green-400 bg-green-50 dark:bg-green-900/30 px-2 sm:px-2.5 py-1 rounded-full group-hover:bg-green-100 dark:group-hover:bg-green-800/40 transition-colors duration-300">+@Model.NewTripsThisMonth this month</span>
        </div>
        <h3 class="text-gray-500 dark:text-gray-400 text-xs sm:text-sm mb-1 group-hover:text-gray-700 dark:group-hover:text-gray-300 transition-colors duration-300">Total Trips</h3>
        <p class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors duration-300">@Model.TotalTrips</p>
        <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 mt-2 group-hover:text-gray-600 dark:group-hover:text-gray-300 transition-colors duration-300">Across all vehicles</p>
    </div>

    <!-- Total Distance Card -->
    <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl shadow-lg dark:shadow-gray-900/50 p-4 sm:p-6 card-hover animate-fadeIn border border-indigo-100 dark:border-indigo-900/30 group" style="animation-delay: 0.2s;">
        <div class="flex items-center justify-between mb-3 sm:mb-4">
            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-indigo-100 dark:bg-indigo-900/50 rounded-xl flex items-center justify-center group-hover:bg-indigo-200 dark:group-hover:bg-indigo-800/40 transition-colors duration-300">
                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-indigo-600 dark:text-indigo-400 group-hover:text-indigo-700 dark:group-hover:text-indigo-300 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                </svg>
            </div>
            <!-- FIXED: Use FormattedAverageDistance instead of raw AverageDistance -->
            <span class="text-xs sm:text-sm font-semibold text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/30 px-2 sm:px-2.5 py-1 rounded-full group-hover:bg-blue-100 dark:group-hover:bg-blue-800/40 transition-colors duration-300">@Model.FormattedAverageDistance avg</span>
        </div>
        <h3 class="text-gray-500 dark:text-gray-400 text-xs sm:text-sm mb-1 group-hover:text-gray-700 dark:group-hover:text-gray-300 transition-colors duration-300">Total Distance</h3>
        <p class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors duration-300">@Model.FormattedTotalDistance</p>
        <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 mt-2 group-hover:text-gray-600 dark:group-hover:text-gray-300 transition-colors duration-300">All time distance</p>
    </div>

    <!-- Total Fuel Used Card -->
    <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl shadow-lg dark:shadow-gray-900/50 p-4 sm:p-6 card-hover animate-fadeIn border border-purple-100 dark:border-purple-900/30 group" style="animation-delay: 0.3s;">
        <div class="flex items-center justify-between mb-3 sm:mb-4">
            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-purple-100 dark:bg-purple-900/50 rounded-xl flex items-center justify-center group-hover:bg-purple-200 dark:group-hover:bg-purple-800/40 transition-colors duration-300">
                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-purple-600 dark:text-purple-400 group-hover:text-purple-700 dark:group-hover:text-purple-300 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
                </svg>
            </div>
            <!-- FIXED: Use FormattedAverageEfficiency instead of raw AverageEfficiency -->
            <span class="text-xs sm:text-sm font-semibold text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-900/30 px-2 sm:px-2.5 py-1 rounded-full group-hover:bg-amber-100 dark:group-hover:bg-amber-800/40 transition-colors duration-300">@Model.FormattedAverageEfficiency avg</span>
        </div>
        <h3 class="text-gray-500 dark:text-gray-400 text-xs sm:text-sm mb-1 group-hover:text-gray-700 dark:group-hover:text-gray-300 transition-colors duration-300">Total Fuel Used</h3>
        <p class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors duration-300">@Model.FormattedTotalFuelUsed</p>
        <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 mt-2 group-hover:text-gray-600 dark:group-hover:text-gray-300 transition-colors duration-300">All time consumption</p>
    </div>

    <!-- Total Cost Card -->
    <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl shadow-lg dark:shadow-gray-900/50 p-4 sm:p-6 card-hover animate-fadeIn border border-green-100 dark:border-green-900/30 group" style="animation-delay: 0.4s;">
        <div class="flex items-center justify-between mb-3 sm:mb-4">
            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-green-100 dark:bg-green-900/50 rounded-xl flex items-center justify-center group-hover:bg-green-200 dark:group-hover:bg-green-800/40 transition-colors duration-300">
                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-green-600 dark:text-green-400 group-hover:text-green-700 dark:group-hover:text-green-300 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
            </div>
            <!-- FIXED: Use FormattedAverageCostPerTrip instead of raw AverageCostPerTrip -->
            <span class="text-xs sm:text-sm font-semibold text-green-600 dark:text-green-400 bg-green-50 dark:bg-green-900/30 px-2 sm:px-2.5 py-1 rounded-full group-hover:bg-green-100 dark:group-hover:bg-green-800/40 transition-colors duration-300">@Model.FormattedAverageCostPerTrip avg</span>
        </div>
        <h3 class="text-gray-500 dark:text-gray-400 text-xs sm:text-sm mb-1 group-hover:text-gray-700 dark:group-hover:text-gray-300 transition-colors duration-300">Total Cost</h3>
        <p class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white group-hover:text-green-600 dark:group-hover:text-green-400 transition-colors duration-300">@Model.FormattedTotalCost</p>
        <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 mt-2 group-hover:text-gray-600 dark:group-hover:text-gray-300 transition-colors duration-300">All time cost</p>
    </div>
</div>

<style>
    .card-hover {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .card-hover:nth-child(1):hover {
            box-shadow: 0 20px 25px -5px rgba(59, 130, 246, 0.15), 0 10px 10px -5px rgba(59, 130, 246, 0.05);
        }

        .card-hover:nth-child(2):hover {
            box-shadow: 0 20px 25px -5px rgba(99, 102, 241, 0.15), 0 10px 10px -5px rgba(99, 102, 241, 0.05);
        }

        .card-hover:nth-child(3):hover {
            box-shadow: 0 20px 25px -5px rgba(168, 85, 247, 0.15), 0 10px 10px -5px rgba(168, 85, 247, 0.05);
        }

        .card-hover:nth-child(4):hover {
            box-shadow: 0 20px 25px -5px rgba(34, 197, 94, 0.15), 0 10px 10px -5px rgba(34, 197, 94, 0.05);
        }

    .dark .card-hover:nth-child(1):hover {
        box-shadow: 0 20px 25px -5px rgba(59, 130, 246, 0.25), 0 10px 10px -5px rgba(59, 130, 246, 0.15);
    }

    .dark .card-hover:nth-child(2):hover {
        box-shadow: 0 20px 25px -5px rgba(99, 102, 241, 0.25), 0 10px 10px -5px rgba(99, 102, 241, 0.15);
    }

    .dark .card-hover:nth-child(3):hover {
        box-shadow: 0 20px 25px -5px rgba(168, 85, 247, 0.25), 0 10px 10px -5px rgba(168, 85, 247, 0.15);
    }

    .dark .card-hover:nth-child(4):hover {
        box-shadow: 0 20px 25px -5px rgba(34, 197, 94, 0.25), 0 10px 10px -5px rgba(34, 197, 94, 0.15);
    }

    .animate-fadeIn {
        animation: fadeIn 0.6s ease-out forwards;
        opacity: 0;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>