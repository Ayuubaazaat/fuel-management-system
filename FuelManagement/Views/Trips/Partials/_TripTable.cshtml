@model FuelManagement.Models.TripsViewModel

@{
    var pageNumber = Model.PageNumber;
    var pageSize = Model.PageSize;
    var totalCount = Model.TotalItems;
    var totalPages = Model.TotalPages;
    var startIndex = Model.StartIndex;
    var endIndex = Model.EndIndex;
}

<div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg dark:shadow-gray-900/50 overflow-hidden border border-gray-100 dark:border-gray-700">
    <div class="overflow-x-auto">
        <table class="min-w-[1300px] sm:min-w-full divide-y divide-gray-200 dark:divide-gray-700">
            <thead class="bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-gray-700 dark:to-gray-800">
                <tr>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-blue-800 dark:text-blue-300 uppercase tracking-wider">Trip ID</th>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-blue-800 dark:text-blue-300 uppercase tracking-wider">Vehicle</th>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-blue-800 dark:text-blue-300 uppercase tracking-wider">License</th>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-blue-800 dark:text-blue-300 uppercase tracking-wider">Driver</th>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-blue-800 dark:text-blue-300 uppercase tracking-wider">Date</th>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-blue-800 dark:text-blue-300 uppercase tracking-wider">Distance</th>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-blue-800 dark:text-blue-300 uppercase tracking-wider">Fuel Used</th>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-blue-800 dark:text-blue-300 uppercase tracking-wider">Efficiency</th>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-blue-800 dark:text-blue-300 uppercase tracking-wider">Cost</th>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-right text-xs font-medium text-blue-800 dark:text-blue-300 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
                @if (Model.TripItems != null && Model.TripItems.Any())
                {
                    @foreach (var item in Model.TripItems)
                    {
                        <tr class="hover:bg-blue-50/30 dark:hover:bg-gray-700/50 transition-colors duration-200 group">
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <span class="text-xs sm:text-sm font-medium text-gray-900 dark:text-white">@item.TripId</span>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="text-xs sm:text-sm font-medium text-gray-900 dark:text-white">@item.VehicleName</div>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="text-xs sm:text-sm font-mono text-gray-900 dark:text-gray-200">@item.LicensePlate</div>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="text-xs sm:text-sm text-gray-900 dark:text-gray-200">@item.DriverName</div>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="text-xs sm:text-sm text-gray-900 dark:text-gray-200">@item.FormattedDate</div>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="text-xs sm:text-sm text-gray-900 dark:text-gray-200">@item.FormattedDistance</div>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="text-xs sm:text-sm text-gray-900 dark:text-gray-200">@item.FormattedFuelUsed</div>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="flex items-center space-x-2">
                                    <div class="w-12 sm:w-16 h-1.5 sm:h-2 bg-gray-200 dark:bg-gray-600 rounded-full overflow-hidden">
                                        <div class="h-full @item.ProgressBarColor" style="width: @item.EfficiencyPercentage%;"></div>
                                    </div>
                                    <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-300">@item.FormattedEfficiency</span>
                                </div>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="text-xs sm:text-sm font-medium text-gray-900 dark:text-white">@item.FormattedCost</div>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap text-right text-xs sm:text-sm font-medium">
                                <div class="flex items-center justify-end space-x-1 sm:space-x-2 opacity-100 sm:opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                                    <a href="@Url.Action("Details", new { id = item.TripId })"
                                       class="p-1.5 sm:p-2 text-blue-600 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-gray-700 rounded-lg transition-colors duration-200" title="View">
                                        <svg class="w-3 h-3 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                        </svg>
                                    </a>
                                    <a href="@Url.Action("Edit", new { id = item.TripId })"
                                       class="p-1.5 sm:p-2 text-amber-600 dark:text-amber-400 hover:bg-amber-50 dark:hover:bg-gray-700 rounded-lg transition-colors duration-200" title="Edit">
                                        <svg class="w-3 h-3 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                        </svg>
                                    </a>
                                    <button type="button"
                                            onclick="showDeleteModal('@item.TripId', '@item.VehicleName')"
                                            class="p-1.5 sm:p-2 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-gray-700 rounded-lg transition-colors duration-200" title="Delete">
                                        <svg class="w-3 h-3 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="px-3 sm:px-6 py-12 text-center">
                            <div class="flex flex-col items-center justify-center">
                                <div class="w-20 h-20 sm:w-24 sm:h-24 bg-blue-100 dark:bg-blue-900/30 rounded-full flex items-center justify-center mb-4">
                                    <svg class="w-10 h-10 sm:w-12 sm:h-12 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A2 2 0 013 15.382V4a1 1 0 011-1h4a1 1 0 011 1v1m0 0h8m-8 0V4a1 1 0 00-1-1H8m10 6v9a2 2 0 01-2 2H6a2 2 0 01-2-2v-9m14 0h.01M8 10h.01M12 10h.01M16 10h.01M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01M16 18h.01"></path>
                                    </svg>
                                </div>
                                <h3 class="text-lg sm:text-xl font-semibold text-gray-900 dark:text-white mb-2">No trips found</h3>
                                <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">Get started by logging a new trip.</p>
                                <a href="@Url.Action("Create")"
                                   class="inline-flex items-center px-4 sm:px-6 py-2.5 sm:py-3 bg-gradient-to-r from-blue-400 to-indigo-500 dark:from-blue-600 dark:to-indigo-600 text-white text-sm font-medium rounded-xl hover:from-blue-500 dark:hover:from-blue-700 hover:to-indigo-600 dark:hover:to-indigo-700 transform hover:scale-105 transition-all duration-200 shadow-lg hover:shadow-xl">
                                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                    </svg>
                                    Log Trip
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="bg-white dark:bg-gray-800 px-4 sm:px-6 py-3 sm:py-4 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-gray-200 dark:border-gray-700">
            <div class="text-sm text-gray-700 dark:text-gray-300 order-2 sm:order-1">
                Showing <span class="font-medium">@startIndex</span> to <span class="font-medium">@endIndex</span> of <span class="font-medium">@totalCount</span> results
            </div>
            <div class="order-1 sm:order-2">
                <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                    <!-- Previous button -->
                    @if (pageNumber > 1)
                    {
                        <a href="@Url.Action("Index", new {
                            page = pageNumber - 1,
                            startDate = Model.Filter?.StartDate,
                            endDate = Model.Filter?.EndDate,
                            tripId = Model.Filter?.TripId,  // Changed from vehicleId to tripId
                            driverName = Model.Filter?.DriverName,
                            minDistance = Model.Filter?.MinDistance
                        })" class="relative inline-flex items-center px-2 sm:px-3 py-2 rounded-l-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-xs sm:text-sm font-medium text-gray-500 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-600">
                            <span class="sr-only">Previous</span>
                            <svg class="h-4 w-4 sm:h-5 sm:w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                            </svg>
                        </a>
                    }
                    else
                    {
                        <span class="relative inline-flex items-center px-2 sm:px-3 py-2 rounded-l-md border border-gray-300 dark:border-gray-600 bg-gray-100 dark:bg-gray-800 text-xs sm:text-sm font-medium text-gray-400 dark:text-gray-500 cursor-not-allowed">
                            <span class="sr-only">Previous</span>
                            <svg class="h-4 w-4 sm:h-5 sm:w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                            </svg>
                        </span>
                    }

                    <!-- Page numbers -->
                    @{
                        var startPage = Math.Max(1, pageNumber - 2);
                        var endPage = Math.Min(totalPages, pageNumber + 2);

                        if (startPage > 1)
                        {
                            <a href="@Url.Action("Index", new {
                                page = 1,
                                startDate = Model.Filter?.StartDate,
                                endDate = Model.Filter?.EndDate,
                                tripId = Model.Filter?.TripId,  // Changed from vehicleId to tripId
                                driverName = Model.Filter?.DriverName,
                                minDistance = Model.Filter?.MinDistance
                            })" class="relative inline-flex items-center px-3 sm:px-4 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-600">
                                1
                            </a>
                            if (startPage > 2)
                            {
                                <span class="relative inline-flex items-center px-3 sm:px-4 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-200">...</span>
                            }
                        }

                        for (int i = startPage; i <= endPage; i++)
                        {
                            if (i == pageNumber)
                            {
                                <span class="relative inline-flex items-center px-3 sm:px-4 py-2 border border-gray-300 dark:border-gray-600 bg-blue-50 dark:bg-blue-900/30 text-xs sm:text-sm font-medium text-blue-600 dark:text-blue-400">@i</span>
                            }
                            else
                            {
                                <a href="@Url.Action("Index", new {
                                    page = i,
                                    startDate = Model.Filter?.StartDate,
                                    endDate = Model.Filter?.EndDate,
                                    tripId = Model.Filter?.TripId,  // Changed from vehicleId to tripId
                                    driverName = Model.Filter?.DriverName,
                                    minDistance = Model.Filter?.MinDistance
                                })" class="relative inline-flex items-center px-3 sm:px-4 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-600">
                                    @i
                                </a>
                            }
                        }

                        if (endPage < totalPages)
                        {
                            if (endPage < totalPages - 1)
                            {
                                <span class="relative inline-flex items-center px-3 sm:px-4 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-200">...</span>
                            }
                            <a href="@Url.Action("Index", new {
                                page = totalPages,
                                startDate = Model.Filter?.StartDate,
                                endDate = Model.Filter?.EndDate,
                                tripId = Model.Filter?.TripId,  // Changed from vehicleId to tripId
                                driverName = Model.Filter?.DriverName,
                                minDistance = Model.Filter?.MinDistance
                            })" class="relative inline-flex items-center px-3 sm:px-4 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-600">
                                @totalPages
                            </a>
                        }
                    }

                    <!-- Next button -->
                    @if (pageNumber < totalPages)
                    {
                        <a href="@Url.Action("Index", new {
                            page = pageNumber + 1,
                            startDate = Model.Filter?.StartDate,
                            endDate = Model.Filter?.EndDate,
                            tripId = Model.Filter?.TripId,  // Changed from vehicleId to tripId
                            driverName = Model.Filter?.DriverName,
                            minDistance = Model.Filter?.MinDistance
                        })" class="relative inline-flex items-center px-2 sm:px-3 py-2 rounded-r-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-xs sm:text-sm font-medium text-gray-500 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-600">
                            <span class="sr-only">Next</span>
                            <svg class="h-4 w-4 sm:h-5 sm:w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                            </svg>
                        </a>
                    }
                    else
                    {
                        <span class="relative inline-flex items-center px-2 sm:px-3 py-2 rounded-r-md border border-gray-300 dark:border-gray-600 bg-gray-100 dark:bg-gray-800 text-xs sm:text-sm font-medium text-gray-400 dark:text-gray-500 cursor-not-allowed">
                            <span class="sr-only">Next</span>
                            <svg class="h-4 w-4 sm:h-5 sm:w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                            </svg>
                        </span>
                    }
                </nav>
            </div>
        </div>
    }
</div>

<script>
    function showDeleteModal(tripId, vehicleName) {
        document.getElementById('deleteTripId').value = tripId;
        document.getElementById('deleteTripDisplay').textContent = `Trip #${tripId} - ${vehicleName}`;
        document.getElementById('deleteModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        document.body.style.paddingRight = window.innerWidth - document.documentElement.clientWidth + 'px';
    }
</script>