@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const canvas = document.getElementById('salesChart');
            if (!canvas) return;

            const ctx = canvas.getContext('2d');

            if (window.salesChart instanceof Chart) {
                window.salesChart.destroy();
            }

            const monthlyData   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySales.Select(m => m.Sales)));
            const monthlyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySales.Select(m => m.Month)));
            const weeklyData    = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeeklySales.Select(w => w.Sales)));
            const weeklyLabels  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeeklySales.Select(w => w.DisplayLabel)));

            const isDark = document.documentElement.classList.contains('dark');

            window.salesChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: monthlyLabels,
                    datasets: [{
                        label: 'Sales',
                        data: monthlyData,
                        borderColor: isDark ? '#a78bfa' : '#9333ea',
                        backgroundColor: isDark ? 'rgba(167,139,250,0.2)' : 'rgba(147,51,234,0.1)',
                        tension: 0.4,
                        fill: true,
                        borderWidth: 2,
                        pointBackgroundColor: isDark ? '#a78bfa' : '#9333ea',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: { duration: 2000, easing: 'easeInOutQuart' },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: isDark ? '#374151' : '#1f2937',
                            titleColor: '#f3f4f6',
                            bodyColor: '#d1d5db',
                            padding: 12,
                            cornerRadius: 8,
                            displayColors: false,
                            callbacks: {
                                label: function(context) {
                                    return '$' + context.parsed.y.toLocaleString();
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: isDark ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.05)' },
                            ticks: {
                                callback: function(value) { return '$' + value.toLocaleString(); },
                                color: isDark ? '#e5e7eb' : '#4b5563'
                            }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: isDark ? '#e5e7eb' : '#4b5563' }
                        }
                    }
                }
            });

            document.getElementById('monthlyBtn').addEventListener('click', function() {
                this.className = 'px-4 py-2 bg-gradient-to-r from-purple-600 to-indigo-600 text-white text-sm rounded-lg hover:from-purple-700 hover:to-indigo-700 transition-all duration-300 transform hover:scale-105';
                document.getElementById('weeklyBtn').className = 'px-4 py-2 text-gray-600 dark:text-gray-300 text-sm rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-all duration-300';
                window.salesChart.data.labels = monthlyLabels;
                window.salesChart.data.datasets[0].data = monthlyData;
                window.salesChart.update();
            });

            document.getElementById('weeklyBtn').addEventListener('click', function() {
                this.className = 'px-4 py-2 bg-gradient-to-r from-purple-600 to-indigo-600 text-white text-sm rounded-lg hover:from-purple-700 hover:to-indigo-700 transition-all duration-300 transform hover:scale-105';
                document.getElementById('monthlyBtn').className = 'px-4 py-2 text-gray-600 dark:text-gray-300 text-sm rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-all duration-300';
                window.salesChart.data.labels = weeklyLabels;
                window.salesChart.data.datasets[0].data = weeklyData;
                window.salesChart.update();
            });

            const observer = new MutationObserver((mutations) => {
                mutations.forEach((mutation) => {
                    if (mutation.attributeName === 'class') {
                        const isDarkNow = document.documentElement.classList.contains('dark');
                        if (window.salesChart) {
                            window.salesChart.data.datasets[0].borderColor          = isDarkNow ? '#a78bfa' : '#9333ea';
                            window.salesChart.data.datasets[0].backgroundColor      = isDarkNow ? 'rgba(167,139,250,0.2)' : 'rgba(147,51,234,0.1)';
                            window.salesChart.data.datasets[0].pointBackgroundColor = isDarkNow ? '#a78bfa' : '#9333ea';
                            window.salesChart.options.scales.y.grid.color           = isDarkNow ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.05)';
                            window.salesChart.options.scales.y.ticks.color          = isDarkNow ? '#e5e7eb' : '#4b5563';
                            window.salesChart.options.scales.x.ticks.color          = isDarkNow ? '#e5e7eb' : '#4b5563';
                            window.salesChart.options.plugins.tooltip.backgroundColor = isDarkNow ? '#374151' : '#1f2937';
                            window.salesChart.update();
                        }
                    }
                });
            });

            observer.observe(document.documentElement, { attributes: true });

            const observer2 = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) entry.target.classList.add('animate-fadeIn');
                });
            }, { threshold: 0.1 });

            document.querySelectorAll('.card-hover, .group').forEach((el) => {
                observer2.observe(el);
            });
        });
    </script>
}