@model FuelManagement.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";

    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var pageSize = ViewBag.PageSize ?? 10;
    var totalCount = ViewBag.TotalCount ?? 0;
    var startIndex = ((currentPage - 1) * pageSize) + 1;
    var endIndex = Math.Min(currentPage * pageSize, totalCount);
}

@{
    string GetCompactRevenue(decimal revenue)
    {
        if (revenue >= 1000000000000) return $"${(revenue / 1000000000000):F1}T";
        else if (revenue >= 1000000000) return $"${(revenue / 1000000000):F1}B";
        else if (revenue >= 1000000) return $"${(revenue / 1000000):F1}M";
        else if (revenue >= 1000) return $"${(revenue / 1000):F1}K";
        else return revenue.ToString("C0");
    }

    string GetActivePumpsPercentage()
    {
        if (Model.TotalPumps == 0) return "0%";
        var percentage = (Model.ActivePumps * 100.0) / Model.TotalPumps;
        return percentage.ToString("F1") + "%";
    }
}

<!-- Purple Hero Section -->
<div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-purple-600 via-purple-500 to-indigo-600 dark:from-purple-800 dark:via-purple-700 dark:to-indigo-800 mb-8 animate-gradient">
    <div class="absolute inset-0 bg-grid-white/[0.1] bg-grid-16"></div>
    <div class="absolute -top-24 -right-24 w-64 h-64 bg-purple-300 dark:bg-purple-900 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob"></div>
    <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-indigo-300 dark:bg-indigo-900 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob animation-delay-2000"></div>
    <!-- Team Hero Image -->
    <div class="hidden md:block absolute top-0 right-0 h-full w-1/3 lg:w-2/5 pointer-events-none">
    <img src="~/images/theboys.png"
         alt="Uniso Fuel Team"
         class="h-full w-full object-cover object-top opacity-90 rounded-r-3xl"
         style="mask-image: linear-gradient(to left, black 85%, transparent 100%); -webkit-mask-image: linear-gradient(to left, black 85%, transparent 100%);" />
    </div>
    <div class="relative px-8 py-12">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between">
            <div class="animate-slideIn">
                <div class="flex items-center gap-3 mb-2">
                    <span class="px-3 py-1 bg-white/20 backdrop-blur-sm rounded-full text-xs font-semibold text-white">Dashboard Overview</span>
                    <span class="px-3 py-1 bg-emerald-400/20 backdrop-blur-sm rounded-full text-xs font-semibold text-emerald-100">Live</span>
                </div>
                <h1 class="text-3xl md:text-4xl font-bold text-white mb-2">Welcome back, <span class="text-transparent bg-clip-text bg-gradient-to-r from-yellow-200 to-pink-200">@(User.IsInRole("Admin") ? "Admin" : "User")</span></h1>
                <p class="text-purple-100 dark:text-purple-300 text-sm md:text-base max-w-2xl">Track your fuel management metrics and performance in real-time</p>
                <div class="flex items-center gap-4 mt-4">
                    <div class="flex items-center gap-2">
                        <div class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></div>
                        <span class="text-xs text-purple-200 dark:text-purple-300">All systems operational</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <i class="fas fa-calendar-alt text-purple-200 dark:text-purple-300 text-xs"></i>
                        <span class="text-xs text-purple-200 dark:text-purple-300">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex flex-wrap gap-3 mt-8 animate-fadeIn animation-delay-300">
            <div class="px-4 py-2 bg-white/5 backdrop-blur-sm rounded-xl border border-white/10">
                <span class="text-xs text-purple-200 dark:text-purple-300">Total Revenue</span>
                <p class="text-lg font-semibold text-white">@GetCompactRevenue(Model.TotalRevenue)</p>
            </div>
            <div class="px-4 py-2 bg-white/5 backdrop-blur-sm rounded-xl border border-white/10">
                <span class="text-xs text-purple-200 dark:text-purple-300">Active Pumps</span>
                <p class="text-lg font-semibold text-white">@Model.ActivePumps/@Model.TotalPumps</p>
            </div>
            <div class="px-4 py-2 bg-white/5 backdrop-blur-sm rounded-xl border border-white/10">
                <span class="text-xs text-purple-200 dark:text-purple-300">Today's Sales</span>
                <p class="text-lg font-semibold text-white">@Model.GetFormattedTodaysRevenue()</p>
            </div>
            <div class="px-4 py-2 bg-white/5 backdrop-blur-sm rounded-xl border border-white/10">
                <span class="text-xs text-purple-200 dark:text-purple-300">Pending Invoices</span>
                <p class="text-lg font-semibold text-white">@Model.PendingInvoices</p>
            </div>
        </div>
    </div>
</div>

<!-- Stats Grid -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="group bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-xl transition-all duration-300 hover:-translate-y-1 animate-fadeIn animation-delay-100">
        <div class="flex items-start justify-between mb-4">
            <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center transform group-hover:scale-110 transition-transform duration-300">
                <i class="fas fa-gas-pump text-white text-xl"></i>
            </div>
            <span class="text-sm font-semibold text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/30 px-2.5 py-1 rounded-lg">
                @Model.GetFormattedTotalFuelSales()
            </span>
        </div>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">TOTAL FUEL SALES</p>
        <p class="text-2xl font-bold text-gray-800 dark:text-gray-100 mb-3">@Model.TotalFuelSales.ToString("C0")</p>
        <div class="flex items-center justify-between text-sm">
            <span class="text-gray-500 dark:text-gray-400">SOLD</span>
            <span class="font-semibold text-gray-800 dark:text-gray-100">@Model.TotalLitersSold.ToString("N0")L</span>
        </div>
    </div>

    <div class="group bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-xl transition-all duration-300 hover:-translate-y-1 animate-fadeIn animation-delay-200">
        <div class="flex items-start justify-between mb-4">
            <div class="w-12 h-12 bg-gradient-to-br from-amber-500 to-amber-600 rounded-xl flex items-center justify-center transform group-hover:scale-110 transition-transform duration-300">
                <i class="fas fa-flask text-white text-xl"></i>
            </div>
            <span class="text-sm font-semibold text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-900/30 px-2.5 py-1 rounded-lg">
                @Model.GetFormattedTotalLitersSold()
            </span>
        </div>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">TOTAL LITERS SOLD</p>
        <p class="text-2xl font-bold text-gray-800 dark:text-gray-100 mb-3">@Model.TotalLitersSold.ToString("N0")L</p>
        <div class="flex items-center justify-between text-sm">
            <span class="text-gray-500 dark:text-gray-400">INVENTORY</span>
            <span class="font-semibold text-gray-800 dark:text-gray-100">@Model.TotalInventory.ToString("N0")L</span>
        </div>
    </div>

    <div class="group bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-xl transition-all duration-300 hover:-translate-y-1 animate-fadeIn animation-delay-300">
        <div class="flex items-start justify-between mb-4">
            <div class="w-12 h-12 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-xl flex items-center justify-center transform group-hover:scale-110 transition-transform duration-300">
                <i class="fas fa-oil-can text-white text-xl"></i>
            </div>
            <span class="text-sm font-medium text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/30 px-2.5 py-1 rounded-lg">All systems operational</span>
        </div>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">ACTIVE PUMPS</p>
        <p class="text-2xl font-bold text-gray-800 dark:text-gray-100 mb-3">@Model.ActivePumps / @Model.TotalPumps</p>
        <div class="flex items-center justify-between text-sm">
            <span class="text-gray-500 dark:text-gray-400">ACTIVE %</span>
            <span class="font-semibold text-green-600 dark:text-green-400">@GetActivePumpsPercentage()</span>
        </div>
        <span class="text-xs text-red-500 dark:text-red-400 block mt-2">
            <i class="fas fa-exclamation-triangle mr-1"></i>@(Model.TodaysVsAveragePercentage.ToString("+0.0;-#.0"))% low activity today
        </span>
    </div>

    <div class="group bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-xl transition-all duration-300 hover:-translate-y-1 animate-fadeIn animation-delay-400">
        <div class="flex items-start justify-between mb-4">
            <div class="w-12 h-12 bg-gradient-to-br from-purple-500 to-purple-600 rounded-xl flex items-center justify-center transform group-hover:scale-110 transition-transform duration-300">
                <i class="fas fa-chart-line text-white text-xl"></i>
            </div>
            <span class="text-sm font-medium text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-900/30 px-2.5 py-1 rounded-lg">Within Limit</span>
        </div>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">FUEL LOSS/VAR</p>
        <p class="text-2xl font-bold text-gray-800 dark:text-gray-100 mb-3">@Model.FuelLossVariance.ToString("P1")</p>
        <div class="flex items-center justify-between text-sm">
            <span class="text-gray-500 dark:text-gray-400">PENDING INVOICES</span>
            <span class="font-semibold text-red-600 dark:text-red-400">@Model.PendingInvoices</span>
        </div>
        <span class="text-xs text-gray-500 dark:text-gray-400 block mt-2">
            <i class="fas fa-clock mr-1"></i>Requires Action
        </span>
    </div>
</div>

<!-- Module Summary Cards — Clients, Compensation, Car Wash -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">

    <!-- Fuel Clients -->
    <a href="/FuelClients"
       class="group bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-xl transition-all duration-300 hover:-translate-y-1 animate-fadeIn animation-delay-500 block">
        <div class="flex items-start justify-between mb-4">
            <div class="w-12 h-12 bg-gradient-to-br from-teal-500 to-teal-600 rounded-xl flex items-center justify-center transform group-hover:scale-110 transition-transform duration-300">
                <i class="fas fa-user-tie text-white text-xl"></i>
            </div>
            <span class="text-sm font-semibold text-teal-600 dark:text-teal-400 bg-teal-50 dark:bg-teal-900/30 px-2.5 py-1 rounded-lg">
                @Model.ActiveClients Active
            </span>
        </div>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">FUEL CLIENTS</p>
        <p class="text-2xl font-bold text-gray-800 dark:text-gray-100 mb-3">@Model.TotalClients Total</p>
        <div class="flex items-center justify-between text-sm">
            <span class="text-gray-500 dark:text-gray-400">NEW THIS MONTH</span>
            <span class="font-semibold text-teal-600 dark:text-teal-400">+@Model.NewClientsThisMonth</span>
        </div>
    </a>

    <!-- Compensation -->
    @if (Model.IsAdmin)
    {
        <a href="/Compensation"
           class="group bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-xl transition-all duration-300 hover:-translate-y-1 animate-fadeIn animation-delay-600 block">
            <div class="flex items-start justify-between mb-4">
                <div class="w-12 h-12 bg-gradient-to-br from-orange-500 to-orange-600 rounded-xl flex items-center justify-center transform group-hover:scale-110 transition-transform duration-300">
                    <i class="fas fa-hand-holding-usd text-white text-xl"></i>
                </div>
                <span class="text-sm font-semibold text-orange-600 dark:text-orange-400 bg-orange-50 dark:bg-orange-900/30 px-2.5 py-1 rounded-lg">
                    @Model.TotalEmployees Staff
                </span>
            </div>
            <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">COMPENSATION</p>
            <p class="text-2xl font-bold text-gray-800 dark:text-gray-100 mb-3">@Model.TotalCompensationPaidThisMonth.ToString("C0")</p>
            <div class="flex items-center justify-between text-sm">
                <span class="text-gray-500 dark:text-gray-400">PENDING</span>
                <span class="font-semibold @(Model.PendingCompensations > 0 ? "text-red-600 dark:text-red-400" : "text-green-600 dark:text-green-400")">
                    @Model.PendingCompensations
                </span>
            </div>
        </a>
    }

    <!-- Car Wash -->
    <a href="/CarWash"
       class="group bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-xl transition-all duration-300 hover:-translate-y-1 animate-fadeIn animation-delay-700 block">
        <div class="flex items-start justify-between mb-4">
            <div class="w-12 h-12 bg-gradient-to-br from-cyan-500 to-blue-600 rounded-xl flex items-center justify-center transform group-hover:scale-110 transition-transform duration-300">
                <i class="fas fa-soap text-white text-xl"></i>
            </div>
            <span class="text-sm font-semibold text-cyan-600 dark:text-cyan-400 bg-cyan-50 dark:bg-cyan-900/30 px-2.5 py-1 rounded-lg">
                @Model.TodayCarWashes today
            </span>
        </div>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">CAR WASH</p>
        <p class="text-2xl font-bold text-gray-800 dark:text-gray-100 mb-3">@Model.TotalCarWashRevenue.ToString("C0")</p>
        <div class="flex items-center justify-between text-sm">
            <span class="text-gray-500 dark:text-gray-400">PENDING / IN PROGRESS</span>
            <span class="font-semibold @(Model.PendingCarWashes > 0 ? "text-amber-600 dark:text-amber-400" : "text-green-600 dark:text-green-400")">
                @Model.PendingCarWashes
            </span>
        </div>
        <div class="flex items-center justify-between text-sm mt-1">
            <span class="text-gray-500 dark:text-gray-400">TODAY'S REVENUE</span>
            <span class="font-semibold text-cyan-600 dark:text-cyan-400">@Model.TodayCarWashRevenue.ToString("C0")</span>
        </div>
    </a>
</div>

<!-- Second Row Stats -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
    <div class="group bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-xl transition-all duration-300 hover:-translate-y-1 animate-fadeIn animation-delay-500">
        <div class="flex items-start justify-between">
            <div>
                <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">TODAY'S REVENUE</p>
                <p class="text-2xl font-bold text-gray-800 dark:text-gray-100">@Model.TodaysRevenue.ToString("C0")</p>
                <span class="text-sm text-emerald-600 dark:text-emerald-400 font-medium flex items-center gap-1">
                    <i class="fas fa-arrow-up text-xs"></i>@Model.TodaysVsAveragePercentage.ToString("+0.0;-#.0")% vs avg. day
                </span>
            </div>
            <div class="w-12 h-12 bg-gradient-to-br from-indigo-500 to-indigo-600 rounded-xl flex items-center justify-center transform group-hover:rotate-12 transition-transform duration-300">
                <i class="fas fa-dollar-sign text-white text-xl"></i>
            </div>
        </div>
    </div>

    <div class="group bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-xl transition-all duration-300 hover:-translate-y-1 animate-fadeIn animation-delay-600">
        <div class="flex items-start justify-between">
            <div>
                <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">AVG TRANSACTION</p>
                <p class="text-2xl font-bold text-gray-800 dark:text-gray-100">@Model.AverageTransaction.ToString("C2")</p>
                <span class="text-sm text-gray-600 dark:text-gray-300 font-medium flex items-center gap-1">
                    <i class="fas fa-chart-line text-xs"></i>@Model.TodaysTrend
                </span>
            </div>
            <div class="w-12 h-12 bg-gradient-to-br from-rose-500 to-rose-600 rounded-xl flex items-center justify-center transform group-hover:rotate-12 transition-transform duration-300">
                <i class="fas fa-receipt text-white text-xl"></i>
            </div>
        </div>
    </div>

    <div class="group bg-gradient-to-br from-purple-600 to-indigo-700 dark:from-purple-800 dark:to-indigo-900 rounded-2xl p-6 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 animate-fadeIn animation-delay-700">
        <div class="flex items-start justify-between text-white">
            <div>
                <p class="text-purple-200 dark:text-purple-300 text-sm mb-1">ACTIVE SESSIONS</p>
                <p class="text-2xl font-bold mb-2">@Model.ActiveSessions</p>
                <span class="text-purple-200 dark:text-purple-300 text-sm flex items-center gap-1">
                    <i class="fas fa-fire"></i>@Model.FuelingNow fueling now
                </span>
            </div>
            <div class="w-12 h-12 bg-white/20 rounded-xl flex items-center justify-center backdrop-blur-sm transform group-hover:scale-110 transition-transform duration-300">
                <i class="fas fa-users text-white text-xl"></i>
            </div>
        </div>
    </div>
</div>

<!-- Yearly Sales Overview and Distribution -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
    <div class="lg:col-span-2 bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700 animate-fadeIn animation-delay-800">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6 gap-4">
            <div>
                <h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Yearly Sales Overview</h2>
                <p class="text-sm text-gray-500 dark:text-gray-400">Revenue performance over the current fiscal year</p>
            </div>
            <div class="flex gap-2">
                <button id="monthlyBtn" class="px-4 py-2 bg-gradient-to-r from-purple-600 to-indigo-600 text-white text-sm rounded-lg hover:from-purple-700 hover:to-indigo-700 transition-all duration-300 transform hover:scale-105">Monthly</button>
                <button id="weeklyBtn" class="px-4 py-2 text-gray-600 dark:text-gray-300 text-sm rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-all duration-300">Weekly</button>
            </div>
        </div>
        <div class="relative w-full" style="height: 300px;">
            <canvas id="salesChart"></canvas>
        </div>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700 animate-fadeIn animation-delay-900">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Distribution</h2>
            <a href="/FuelSales" class="text-sm text-purple-600 dark:text-purple-400 hover:text-purple-700 dark:hover:text-purple-300 font-medium flex items-center gap-1 group">
                View All <i class="fas fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
            </a>
        </div>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">Vendor compensation list</p>
        <div class="space-y-4">
            @foreach (var item in Model.DistributionItems)
            {
                <div class="flex items-center justify-between p-3 hover:bg-purple-50 dark:hover:bg-gray-700 rounded-xl transition-all duration-300 group">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-gradient-to-br @item.InitialsColor rounded-lg flex items-center justify-center group-hover:scale-110 transition-transform">
                            <span class="text-sm font-semibold">@item.Initials</span>
                        </div>
                        <div>
                            <p class="font-medium text-gray-800 dark:text-gray-200">@item.ClientName</p>
                            <p class="text-xs text-gray-500 dark:text-gray-400">ID: @item.ClientId</p>
                        </div>
                    </div>
                    <div class="text-right">
                        <p class="font-semibold text-gray-800 dark:text-gray-200">@item.Amount.ToString("C2")</p>
                        <span class="text-xs @item.StatusColor px-2 py-0.5 rounded-full">@item.Status</span>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Recent Transactions -->
<div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700 animate-fadeIn animation-delay-1000">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6 gap-4">
        <h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Recent Transactions</h2>
        <a href="/FuelSales" class="text-sm text-purple-600 dark:text-purple-400 hover:text-purple-700 dark:hover:text-purple-300 font-medium flex items-center gap-1 group">
            View All <i class="fas fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
        </a>
    </div>

    <!-- ── DESKTOP TABLE (hidden on mobile) ── -->
    <div class="hidden sm:block overflow-x-auto">
        <table class="w-full">
            <thead>
                <tr class="text-left text-sm text-gray-500 dark:text-gray-400 border-b border-gray-200 dark:border-gray-700">
                    <th class="pb-3 font-medium">PAYMENT METHOD</th>
                    <th class="pb-3 font-medium">TRANSACTION ID</th>
                    <th class="pb-3 font-medium">PUMP</th>
                    <th class="pb-3 font-medium">LITERS</th>
                    <th class="pb-3 font-medium">AMOUNT</th>
                </tr>
            </thead>
            <tbody class="text-sm">
                @foreach (var transaction in Model.RecentTransactions)
                {
                    <tr class="border-b border-gray-100 dark:border-gray-700 hover:bg-purple-50 dark:hover:bg-gray-700 transition-colors duration-300">
                        <td class="py-3">
                            <span class="px-3 py-1 rounded-full text-xs font-medium
                                @(transaction.PaymentMethod == "EvcPlus"   ? "bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300" :
                                  transaction.PaymentMethod == "Waafi"     ? "bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300" :
                                  transaction.PaymentMethod == "Somtel"    ? "bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-300" :
                                  transaction.PaymentMethod == "Somnet"    ? "bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-300" :
                                  transaction.PaymentMethod == "E-Dahab" || transaction.PaymentMethod == "EDahab" ? "bg-orange-100 text-orange-800 dark:bg-orange-900/30 dark:text-orange-300" :
                                  "bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300")">
                                @transaction.PaymentMethod
                            </span>
                        </td>
                        <td class="py-3 font-mono text-gray-800 dark:text-gray-200">@transaction.TransactionId</td>
                        <td class="py-3"><span class="bg-purple-100 dark:bg-purple-900 px-2 py-1 rounded-lg text-purple-700 dark:text-purple-300">@transaction.PumpNumber</span></td>
                        <td class="py-3 font-medium text-gray-800 dark:text-gray-200">@transaction.FormattedLiters</td>
                        <td class="py-3 font-semibold text-gray-800 dark:text-gray-200">@transaction.FormattedAmount</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- ── MOBILE CARDS (hidden on sm+) ── -->
    <div class="sm:hidden space-y-3">
        @foreach (var transaction in Model.RecentTransactions)
        {
            <div class="bg-gray-50 dark:bg-gray-700/50 rounded-2xl p-4 border border-gray-100 dark:border-gray-700">
                <!-- Top row: payment badge + amount -->
                <div class="flex items-center justify-between mb-3">
                    <span class="px-3 py-1 rounded-full text-xs font-medium
                        @(transaction.PaymentMethod == "EvcPlus"   ? "bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300" :
                          transaction.PaymentMethod == "Waafi"     ? "bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300" :
                          transaction.PaymentMethod == "Somtel"    ? "bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-300" :
                          transaction.PaymentMethod == "Somnet"    ? "bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-300" :
                          transaction.PaymentMethod == "E-Dahab" || transaction.PaymentMethod == "EDahab" ? "bg-orange-100 text-orange-800 dark:bg-orange-900/30 dark:text-orange-300" :
                          "bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300")">
                        @transaction.PaymentMethod
                    </span>
                    <span class="text-base font-bold text-gray-800 dark:text-gray-100">@transaction.FormattedAmount</span>
                </div>
                <!-- Bottom row: transaction ID, pump, liters -->
                <div class="grid grid-cols-3 gap-2 text-xs">
                    <div>
                        <p class="text-gray-400 dark:text-gray-500 mb-0.5">TXN ID</p>
                        <p class="font-mono font-semibold text-gray-700 dark:text-gray-200 truncate">@transaction.TransactionId</p>
                    </div>
                    <div>
                        <p class="text-gray-400 dark:text-gray-500 mb-0.5">PUMP</p>
                        <span class="bg-purple-100 dark:bg-purple-900 px-2 py-0.5 rounded-lg text-purple-700 dark:text-purple-300 font-medium">@transaction.PumpNumber</span>
                    </div>
                    <div>
                        <p class="text-gray-400 dark:text-gray-500 mb-0.5">LITERS</p>
                        <p class="font-semibold text-gray-700 dark:text-gray-200">@transaction.FormattedLiters</p>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mt-4 pt-4 border-t border-gray-100 dark:border-gray-700 gap-4">
            <p class="text-sm text-gray-500 dark:text-gray-400 order-2 sm:order-1">
                Showing <span class="font-medium">@startIndex</span> to
                <span class="font-medium">@endIndex</span> of
                <span class="font-medium">@totalCount</span> transactions
            </p>
            <div class="flex gap-2 order-1 sm:order-2">
                @if (currentPage > 1)
                {
                    <a href="@Url.Action("Index", new { page = currentPage - 1 })"
                       class="px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-purple-50 dark:hover:bg-gray-600 transition-all duration-200">
                        <i class="fas fa-chevron-left text-xs"></i>
                        <span class="hidden sm:inline ml-1">Previous</span>
                    </a>
                }
                else
                {
                    <span class="px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-sm font-medium text-gray-400 dark:text-gray-500 cursor-not-allowed opacity-50">
                        <i class="fas fa-chevron-left text-xs"></i>
                        <span class="hidden sm:inline ml-1">Previous</span>
                    </span>
                }

                @{
                    int startPage = Math.Max(1, currentPage - 2);
                    int endPage = Math.Min(totalPages, startPage + 4);
                    if (endPage - startPage < 4) startPage = Math.Max(1, endPage - 4);
                }

                @for (int i = startPage; i <= endPage; i++)
                {
                    if (i == currentPage)
                    {
                        <span class="px-3 py-2 rounded-lg bg-gradient-to-r from-purple-600 to-indigo-600 text-white text-sm font-medium">@i</span>
                    }
                    else
                    {
                        <a href="@Url.Action("Index", new { page = i })"
                           class="px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-purple-50 dark:hover:bg-gray-600 transition-all duration-200">@i</a>
                    }
                }

                @if (currentPage < totalPages)
                {
                    <a href="@Url.Action("Index", new { page = currentPage + 1 })"
                       class="px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-purple-50 dark:hover:bg-gray-600 transition-all duration-200">
                        <span class="hidden sm:inline mr-1">Next</span>
                        <i class="fas fa-chevron-right text-xs"></i>
                    </a>
                }
                else
                {
                    <span class="px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-sm font-medium text-gray-400 dark:text-gray-500 cursor-not-allowed opacity-50">
                        <span class="hidden sm:inline mr-1">Next</span>
                        <i class="fas fa-chevron-right text-xs"></i>
                    </span>
                }
            </div>
        </div>
    }
    else
    {
        <div class="flex justify-between items-center mt-4 pt-4 border-t border-gray-100 dark:border-gray-700">
            <p class="text-sm text-gray-500 dark:text-gray-400">
                Showing 1-@Model.RecentTransactions.Count of @Model.TotalTransactions transactions
            </p>
        </div>
    }
</div>

