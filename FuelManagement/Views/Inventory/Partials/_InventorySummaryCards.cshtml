@model FuelManagement.Models.InventoryViewModel

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
    <!-- Total Fuel Stock Card -->
    <div class="bg-white dark:bg-gray-800 backdrop-blur-sm rounded-2xl shadow-lg dark:shadow-gray-900 p-4 sm:p-6 card-hover animate-fadeIn border border-red-100 dark:border-gray-700" style="animation-delay: 0.1s;">
        <div class="flex items-center justify-between mb-3 sm:mb-4">
            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-red-100 dark:bg-red-900/50 rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-red-600 dark:text-red-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
                </svg>
            </div>
            <span class="text-xs sm:text-sm font-semibold text-green-600 dark:text-green-300 bg-green-50 dark:bg-green-900/30 px-2 sm:px-2.5 py-1 rounded-full">
                @Model.FuelStockGrowthPercentage.ToString("F1")% of total
            </span>
        </div>
        <h3 class="text-gray-600 dark:text-gray-300 text-xs sm:text-sm mb-1">Total Fuel Stock</h3>
        <p class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-gray-100">@Model.TotalFuelStock.ToString("N0")L</p>
        <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 mt-2">Across all tanks</p>
    </div>

    <!-- Low Stock Items Card -->
    <div class="bg-white dark:bg-gray-800 backdrop-blur-sm rounded-2xl shadow-lg dark:shadow-gray-900 p-4 sm:p-6 card-hover animate-fadeIn border border-red-100 dark:border-gray-700" style="animation-delay: 0.2s;">
        <div class="flex items-center justify-between mb-3 sm:mb-4">
            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-yellow-100 dark:bg-yellow-900/50 rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-yellow-600 dark:text-yellow-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
            </div>
            <span class="text-xs sm:text-sm font-semibold @(Model.LowStockItems > 0 ? "text-red-600 dark:text-red-300 bg-red-50 dark:bg-red-900/30" : "text-green-600 dark:text-green-300 bg-green-50 dark:bg-green-900/30") px-2 sm:px-2.5 py-1 rounded-full">
                @(Model.LowStockItems > 0 ? "Needs Attention" : "Good")
            </span>
        </div>
        <h3 class="text-gray-600 dark:text-gray-300 text-xs sm:text-sm mb-1">Low Stock Items</h3>
        <p class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-gray-100">@Model.LowStockItems</p>
        <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 mt-2">Require refill soon</p>
    </div>

    <!-- Total Capacity Card -->
    <div class="bg-white dark:bg-gray-800 backdrop-blur-sm rounded-2xl shadow-lg dark:shadow-gray-900 p-4 sm:p-6 card-hover animate-fadeIn border border-red-100 dark:border-gray-700" style="animation-delay: 0.3s;">
        <div class="flex items-center justify-between mb-3 sm:mb-4">
            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-blue-100 dark:bg-blue-900/50 rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-blue-600 dark:text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"></path>
                </svg>
            </div>
            <span class="text-xs sm:text-sm font-semibold text-blue-600 dark:text-blue-300 bg-blue-50 dark:bg-blue-900/30 px-2 sm:px-2.5 py-1 rounded-full">@Model.AverageFillLevel.ToString("F1")% Avg</span>
        </div>
        <h3 class="text-gray-600 dark:text-gray-300 text-xs sm:text-sm mb-1">Total Capacity</h3>
        <p class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-gray-100">@Model.TotalCapacity.ToString("N0")L</p>
        <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 mt-2">Maximum storage</p>
    </div>

    <!-- Inventory Value Card -->
    <div class="bg-white dark:bg-gray-800 backdrop-blur-sm rounded-2xl shadow-lg dark:shadow-gray-900 p-4 sm:p-6 card-hover animate-fadeIn border border-red-100 dark:border-gray-700" style="animation-delay: 0.4s;">
        <div class="flex items-center justify-between mb-3 sm:mb-4">
            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-green-100 dark:bg-green-900/50 rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-green-600 dark:text-green-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
            </div>
            <span class="text-xs sm:text-sm font-semibold text-green-600 dark:text-green-300 bg-green-50 dark:bg-green-900/30 px-2 sm:px-2.5 py-1 rounded-full">
                @Model.InventoryValueGrowthPercentage.ToString("F1")% of total
            </span>
        </div>
        <h3 class="text-gray-600 dark:text-gray-300 text-xs sm:text-sm mb-1">Inventory Value</h3>
        <p class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-gray-100">@Model.InventoryValue.ToString("C")</p>
       <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 mt-2">Estimated at $3.50/L average</p>
    </div>
</div>

<style>
    .card-hover {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .card-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px -5px rgba(239, 68, 68, 0.1), 0 10px 10px -5px rgba(239, 68, 68, 0.04);
        }

    .dark .card-hover:hover {
        box-shadow: 0 20px 25px -5px rgba(239, 68, 68, 0.3), 0 10px 10px -5px rgba(239, 68, 68, 0.2);
    }

    .animate-fadeIn {
        animation: fadeIn 0.6s ease-out forwards;
        opacity: 0;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>