@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-4 sticky top-24">
    <nav class="space-y-1">
        <!-- Overview -->
        <a href="/Profile" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-200 group @(currentAction == "Index" ? "bg-purple-50 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400" : "text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700")">
            <i class="fas fa-user-circle w-5 @(currentAction == "Index" ? "text-purple-600 dark:text-purple-400" : "text-gray-400 dark:text-gray-500 group-hover:text-gray-600 dark:group-hover:text-gray-300")"></i>
            <span class="font-medium">Overview</span>
            @if (currentAction == "Index")
            {
                <i class="fas fa-chevron-right ml-auto text-sm text-purple-600 dark:text-purple-400"></i>
            }
        </a>

        <!-- Edit Profile -->
        <a href="/Profile/Edit" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-200 group @(currentAction == "Edit" ? "bg-purple-50 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400" : "text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700")">
            <i class="fas fa-edit w-5 @(currentAction == "Edit" ? "text-purple-600 dark:text-purple-400" : "text-gray-400 dark:text-gray-500 group-hover:text-gray-600 dark:group-hover:text-gray-300")"></i>
            <span class="font-medium">Edit Profile</span>
            @if (currentAction == "Edit")
            {
                <i class="fas fa-chevron-right ml-auto text-sm text-purple-600 dark:text-purple-400"></i>
            }
        </a>

        <!-- Security -->
        <a href="/Profile/Security" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-200 group @(currentAction == "Security" ? "bg-purple-50 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400" : "text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700")">
            <i class="fas fa-shield-alt w-5 @(currentAction == "Security" ? "text-purple-600 dark:text-purple-400" : "text-gray-400 dark:text-gray-500 group-hover:text-gray-600 dark:group-hover:text-gray-300")"></i>
            <span class="font-medium">Security</span>
            @if (currentAction == "Security")
            {
                <i class="fas fa-chevron-right ml-auto text-sm text-purple-600 dark:text-purple-400"></i>
            }
        </a>
    </nav>

    <!-- Account Status Widget - WITH REAL DATA -->
    <div class="mt-6 pt-6 border-t border-gray-100 dark:border-gray-700">
        <div class="bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-800 dark:to-gray-700 rounded-xl p-4">
            <p class="text-sm text-gray-500 dark:text-gray-400 mb-2">Account Status</p>
            <div class="flex items-center gap-2 mb-3">
                <div class="w-2 h-2 @(ViewBag.AccountStatus == "Active" ? "bg-emerald-500" : "bg-gray-400") rounded-full animate-pulse"></div>
                <span class="text-sm font-medium text-gray-700 dark:text-gray-300">@ViewBag.AccountStatus</span>
            </div>
            <div class="space-y-2 text-xs">
                <div class="flex justify-between">
                    <span class="text-gray-500 dark:text-gray-400">Last Login</span>
                    <span class="text-gray-700 dark:text-gray-300">@ViewBag.LastLoginFormatted</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-500 dark:text-gray-400">Member Since</span>
                    <span class="text-gray-700 dark:text-gray-300">@ViewBag.MemberSince</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-500 dark:text-gray-400">Total Logins</span>
                    <span class="text-gray-700 dark:text-gray-300">@ViewBag.TotalLogins</span>
                </div>
            </div>
        </div>
    </div>
</div>