@model FuelManagement.Models.ProfileViewModel

<div class="bg-gradient-to-r from-purple-600 to-blue-600 rounded-2xl p-8 text-white relative overflow-hidden animate-slideDown">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-10">
        <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
            <path d="M0 0 L100 100 M100 0 L0 100" stroke="white" stroke-width="2" />
        </svg>
    </div>

    <!-- Content -->
    <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-8">
        <!-- Avatar -->
        <div class="relative group">
            <div class="w-28 h-28 bg-white/20 backdrop-blur-sm rounded-2xl border-4 border-white/30 flex items-center justify-center overflow-hidden">
                @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                {
                    <img src="@Model.ProfileImageUrl" alt="Profile" class="w-full h-full object-cover" />
                }
                else
                {
                    <span class="text-4xl font-semibold text-white">@Model.FirstName[0]@Model.LastName[0]</span>
                }
            </div>
            <a href="/Profile/Edit" class="absolute -bottom-2 -right-2 w-10 h-10 bg-white rounded-xl flex items-center justify-center text-purple-600 shadow-lg hover:scale-110 transition-transform duration-200">
                <i class="fas fa-pen"></i>
            </a>
        </div>

        <!-- Info -->
        <div class="flex-1">
            <h1 class="text-3xl font-bold">@Model.FirstName @Model.LastName</h1>
            <div class="flex items-center gap-3 mt-2">
                <span class="px-3 py-1 bg-white/20 backdrop-blur-sm rounded-lg text-sm">@Model.Role</span>
                <span class="text-white/80"><i class="far fa-envelope mr-2"></i>@Model.Email</span>
            </div>
            <p class="text-white/80 mt-4 flex items-center gap-2">
                <i class="far fa-calendar-alt"></i>
                Member since @Model.JoinDate.ToString("MMMM yyyy")
            </p>
        </div>

        <!-- Quick Actions -->
        <div class="flex gap-3">
            <a href="/Profile/Edit" class="px-6 py-3 bg-white text-purple-600 rounded-xl hover:bg-purple-50 transition-colors duration-200 font-medium flex items-center gap-2 shadow-lg">
                <i class="fas fa-edit"></i>
                Edit Profile
            </a>
            <a href="/Profile/Security" class="px-6 py-3 bg-purple-700/20 backdrop-blur-sm border border-white/30 text-white rounded-xl hover:bg-purple-700/30 transition-colors duration-200 font-medium flex items-center gap-2">
                <i class="fas fa-shield-alt"></i>
                Security
            </a>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-8 pt-8 border-t border-white/20">
        <div>
            <p class="text-white/70 text-sm">Total Logins</p>
            <p class="text-2xl font-semibold">@Model.TotalLogins.ToString("N0")</p>
        </div>
        <div>
            <p class="text-white/70 text-sm">Last Login</p>
            <p class="text-2xl font-semibold">@Model.LastActive.ToString("MMM dd")</p>
        </div>
        <div>
            <p class="text-white/70 text-sm">Devices</p>
            <p class="text-2xl font-semibold">@Model.DeviceCount</p>
        </div>
        <div>
            <p class="text-white/70 text-sm">Account Status</p>
            <p class="text-2xl font-semibold @(Model.AccountStatus == "Active" ? "text-emerald-300" : "text-yellow-300")">
                @Model.AccountStatus
            </p>
        </div>
    </div>
</div>

<style>
    @@keyframes slideDown {
        from {
            transform: translateY(-20px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    .animate-slideDown {
        animation: slideDown 0.5s ease-out forwards;
    }
</style>