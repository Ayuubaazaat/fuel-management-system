@model FuelManagement.Models.ProfileViewModel
@{
    ViewData["Title"] = "Edit Profile";
}

<div class="max-w-3xl mx-auto animate-fadeIn px-4 sm:px-0">
    <!-- Header -->
    <div class="mb-6 sm:mb-8">
        <h1 class="text-2xl sm:text-3xl font-bold text-gray-800 dark:text-gray-100">Edit Profile</h1>
        <p class="text-sm sm:text-base text-gray-500 dark:text-gray-400 mt-1">Update your personal information</p>
    </div>

    <!-- Edit Form -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-4 sm:p-6 lg:p-8">
        <form asp-action="Edit" method="post" enctype="multipart/form-data" id="profileForm">
            @Html.AntiForgeryToken()

            <!-- Avatar Upload -->
            <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-6 mb-6 sm:mb-8 pb-6 sm:pb-8 border-b border-gray-100 dark:border-gray-700">
                <div class="relative group">
                    <div class="w-20 h-20 sm:w-24 sm:h-24 bg-gradient-to-br from-blue-500 to-blue-600 dark:from-blue-700 dark:to-blue-800 rounded-2xl flex items-center justify-center text-white text-2xl sm:text-3xl font-semibold overflow-hidden">
                        @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                        {
                            <img src="@Model.ProfileImageUrl" alt="Profile" class="w-full h-full object-cover" id="avatarPreview" />
                        }
                        else
                        {
                            <span>@(Model.FirstName?.Length > 0 ? Model.FirstName[0].ToString() : "")@(Model.LastName?.Length > 0 ? Model.LastName[0].ToString() : "")</span>
                        }
                    </div>
                    <label for="avatarInput" class="absolute inset-0 bg-black bg-opacity-50 dark:bg-gray-900 dark:bg-opacity-70 rounded-2xl flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-200 cursor-pointer">
                        <i class="fas fa-camera text-white text-base sm:text-lg"></i>
                    </label>
                    <input type="file" id="avatarInput" name="avatar" accept="image/*" class="hidden" />
                </div>
                <div>
                    <h3 class="font-semibold text-gray-800 dark:text-gray-200 text-base sm:text-lg">Profile Photo</h3>
                    <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 mt-1">JPG, PNG or GIF (max. 5MB)</p>
                    <div id="uploadStatus" class="text-xs mt-2 hidden"></div>
                </div>
            </div>

            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly" class="text-red-500 dark:text-red-400 text-sm mb-6 bg-red-50 dark:bg-red-900/30 p-4 rounded-xl" role="alert"></div>

            <!-- Form Fields -->
            <div class="space-y-4 sm:space-y-6">
                <!-- First Name -->
                <div>
                    <label asp-for="FirstName" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">First Name</label>
                    <input asp-for="FirstName"
                           class="w-full px-3 sm:px-4 py-2.5 sm:py-3 border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all duration-200" />
                    <span asp-validation-for="FirstName" class="text-red-500 dark:text-red-400 text-xs sm:text-sm mt-1"></span>
                </div>

                <!-- Last Name -->
                <div>
                    <label asp-for="LastName" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Last Name</label>
                    <input asp-for="LastName"
                           class="w-full px-3 sm:px-4 py-2.5 sm:py-3 border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all duration-200" />
                    <span asp-validation-for="LastName" class="text-red-500 dark:text-red-400 text-xs sm:text-sm mt-1"></span>
                </div>

                <!-- Email - READ ONLY and DISABLED -->
                <div>
                    <label asp-for="Email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Email Address</label>
                    <input asp-for="Email" type="email"
                           class="w-full px-4 py-3 bg-gray-100 dark:bg-gray-600 border border-gray-200 dark:border-gray-600 rounded-xl text-gray-600 dark:text-gray-400 cursor-not-allowed"
                           readonly />
                    <p class="text-xs text-red-500 dark:text-gray-400 mt-1">Email address cannot be changed</p>
                </div>

                <!-- Phone - READ ONLY and DISABLED -->
                <div>
                    <label asp-for="Phone" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Phone </label>
                    <input asp-for="Phone" type="tel"
                           class="w-full px-4 py-3 bg-gray-100 dark:bg-gray-600 border border-gray-200 dark:border-gray-600 rounded-xl text-gray-600 dark:text-gray-400 cursor-not-allowed"
                           readonly />
                    <p class="text-xs text-red-500 dark:text-gray-400 mt-1">Phone number cannot be changed</p>
                </div>

                <!-- Bio -->
                <div>
                    <label asp-for="Bio" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Bio</label>
                    <textarea asp-for="Bio" rows="4"
                              class="w-full px-3 sm:px-4 py-2.5 sm:py-3 border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all duration-200 resize-none"></textarea>
                    <span asp-validation-for="Bio" class="text-red-500 dark:text-red-400 text-xs sm:text-sm mt-1"></span>
                    <p class="text-xs sm:text-sm text-gray-400 dark:text-gray-500 mt-2"><span id="charCount">0</span>/500 characters</p>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 mt-6 sm:mt-8 pt-4 sm:pt-6 border-t border-gray-100 dark:border-gray-700">
                <button type="submit"
                        class="w-full sm:w-auto px-4 sm:px-6 py-2.5 sm:py-3 bg-gradient-to-r from-blue-600 to-blue-700 dark:from-blue-700 dark:to-blue-800 text-white rounded-xl hover:from-blue-700 dark:hover:from-blue-800 hover:to-blue-800 dark:hover:to-blue-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800 transition-all duration-200 font-medium flex items-center justify-center gap-2 text-sm sm:text-base" id="submitBtn">
                    <i class="fas fa-save"></i>
                    Save Changes
                </button>
                <a href="/Profile"
                   class="w-full sm:w-auto px-4 sm:px-6 py-2.5 sm:py-3 border border-gray-200 dark:border-gray-600 text-gray-600 dark:text-gray-300 rounded-xl hover:bg-gray-50 dark:hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-500 dark:focus:ring-gray-400 focus:ring-offset-2 dark:focus:ring-offset-gray-800 transition-all duration-200 font-medium text-center text-sm sm:text-base">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Toast Container -->
<div id="toastContainer" class="fixed bottom-4 right-4 z-50 space-y-3"></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Character counter for bio
        const bioTextarea = document.getElementById('Bio');
        const charCount = document.getElementById('charCount');

        if (bioTextarea) {
            charCount.textContent = bioTextarea.value.length;
            bioTextarea.addEventListener('input', function() {
                charCount.textContent = this.value.length;
            });
        }

        // Toast notification function
        function showToast(type, message) {
            const toast = document.createElement('div');
            toast.className = `flex items-center gap-3 px-6 py-4 rounded-xl shadow-lg transform transition-all duration-300 translate-x-full ${
                type === 'success' ? 'bg-emerald-50 dark:bg-emerald-900/30 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-400' :
                'bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-400'
            }`;
            toast.innerHTML = `
                <i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'}"></i>
                <span>${message}</span>
            `;

            document.getElementById('toastContainer').appendChild(toast);

            setTimeout(() => {
                toast.classList.remove('translate-x-full');
            }, 100);

            setTimeout(() => {
                toast.classList.add('translate-x-full');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // Avatar upload handling
        const avatarInput = document.getElementById('avatarInput');
        const uploadStatus = document.getElementById('uploadStatus');

        if (avatarInput) {
            avatarInput.addEventListener('change', async function() {
                if (!this.files || !this.files[0]) return;

                const file = this.files[0];

                // Validate file size
                if (file.size > 5 * 1024 * 1024) {
                    showToast('error', 'File size must be less than 5MB');
                    this.value = '';
                    return;
                }

                // Validate file type
                if (!file.type.match('image.*')) {
                    showToast('error', 'Please select an image file');
                    this.value = '';
                    return;
                }

                // Show preview
                const reader = new FileReader();
                reader.onload = function(e) {
                    const avatarContainer = document.querySelector('.w-20.h-20.sm\\:w-24.sm\\:h-24');
                    if (avatarContainer) {
                        let img = document.getElementById('avatarPreview');
                        if (!img) {
                            img = document.createElement('img');
                            img.id = 'avatarPreview';
                            img.className = 'w-full h-full object-cover';
                            avatarContainer.innerHTML = '';
                            avatarContainer.appendChild(img);
                        }
                        img.src = e.target.result;
                    }
                };
                reader.readAsDataURL(file);

                // Upload immediately
                uploadStatus.classList.remove('hidden');
                uploadStatus.textContent = 'Uploading...';

                const formData = new FormData();
                formData.append('avatar', file);

                try {
                    const response = await fetch('/Profile/UploadAvatar', {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    });

                    const result = await response.json();

                    uploadStatus.classList.add('hidden');

                    if (result.success) {
                        showToast('success', 'Avatar uploaded successfully');

                        // ===== ADDED: Trigger avatar update in layout =====
                        window.dispatchEvent(new Event('avatarUpdated'));
                        // =================================================

                    } else {
                        showToast('error', result.message || 'Failed to upload avatar');
                    }
                } catch (error) {
                    uploadStatus.classList.add('hidden');
                    showToast('error', 'Failed to upload avatar');
                }
            });
        }

        // Form submission handling
        const form = document.getElementById('profileForm');
        if (form) {
            form.addEventListener('submit', function(e) {
                const submitBtn = document.getElementById('submitBtn');
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
                }
            });
        }
    </script>
}

<style>
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fadeIn {
        animation: fadeIn 0.5s ease-out forwards;
    }

    .dark input[type="file"] {
        color: #e5e7eb;
        background-color: #374151;
    }

    @@media (max-width: 640px) {
        .w-20.h-20 {
            width: 5rem;
            height: 5rem;
        }
    }
</style>