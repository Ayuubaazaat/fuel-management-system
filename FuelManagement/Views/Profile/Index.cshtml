@model FuelManagement.Models.ProfileViewModel
@{
    ViewData["Title"] = "Profile";
}

<div class="max-w-7xl mx-auto animate-fadeIn">
    <!-- Profile Header Partial -->
    <partial name="Partials/_ProfileHeader" model="Model" />

    <!-- Profile Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 mt-8">
        <!-- Sidebar Partial -->
        <div class="lg:col-span-1">
            <partial name="Partials/_ProfileSidebar" />
        </div>

        <!-- Main Content -->
        <div class="lg:col-span-3 space-y-6">
            <!-- Personal Information Card -->
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-6 card-hover transition-all duration-300 hover:shadow-md">
                <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-4">Personal Information</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">Full Name</p>
                        <p class="text-gray-800 dark:text-gray-200 font-medium">@Model.FirstName @Model.LastName</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">Role</p>
                        <p class="text-gray-800 dark:text-gray-200 font-medium">@Model.Role</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">Join Date</p>
                        <p class="text-gray-800 dark:text-gray-200 font-medium">@Model.JoinDate.ToString("MMMM dd, yyyy")</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">Last Active</p>
                        <p class="text-gray-800 dark:text-gray-200 font-medium">@Model.LastActive.ToString("hh:mm tt")</p>
                    </div>
                </div>
            </div>

            <!-- Contact Information Card -->
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-6 card-hover transition-all duration-300 hover:shadow-md">
                <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-4">Contact Information</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">Email Address</p>
                        <div class="flex items-center gap-2">
                            <p class="text-gray-800 dark:text-gray-200 font-medium">@Model.Email</p>
                            @if (Model.EmailVerified)
                            {
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400">
                                    <i class="fas fa-check-circle mr-1 text-xs"></i> Verified
                                </span>
                            }
                        </div>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">Phone Number</p>
                        <div class="flex items-center gap-2">
                            <p class="text-gray-800 dark:text-gray-200 font-medium">@Model.Phone</p>
                            @if (Model.PhoneVerified)
                            {
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400">
                                    <i class="fas fa-check-circle mr-1 text-xs"></i> Verified
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Account Status Card -->
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-6 card-hover transition-all duration-300 hover:shadow-md">
                <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-4">Account Status</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div>
                        <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">Account Status</p>
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400">
                            <i class="fas fa-circle mr-2 text-xs"></i> @Model.AccountStatus
                        </span>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">Active Status</p>
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium @(Model.AccountStatus == "Active" ? "bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400" : "bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300")">
                            <i class="fas @(Model.AccountStatus == "Active" ? "fa-check-circle" : "fa-circle") mr-2"></i>
                            @Model.AccountStatus
                        </span>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">Total Logins</p>
                        <p class="text-gray-800 dark:text-gray-200 font-medium">@Model.TotalLogins.ToString("N0")</p>
                    </div>
                </div>
            </div>

            <!-- Recent Activity Card -->
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-6 card-hover transition-all duration-300 hover:shadow-md">
                <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-4">Recent Activity</h3>
                <div class="space-y-4">
                    <div class="flex items-start gap-4">
                        <div class="w-8 h-8 bg-blue-100 dark:bg-blue-900/30 rounded-lg flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-sign-in-alt text-blue-600 dark:text-blue-400 text-sm"></i>
                        </div>
                        <div>
                            <p class="text-gray-800 dark:text-gray-200 font-medium">Last Login</p>
                            <p class="text-sm text-gray-500 dark:text-gray-400">@Model.LastActive.ToString("MMMM dd, yyyy 'at' hh:mm tt") from @Model.LastLoginIp</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <div class="w-8 h-8 bg-amber-100 dark:bg-amber-900/30 rounded-lg flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-laptop text-amber-600 dark:text-amber-400 text-sm"></i>
                        </div>
                        <div>
                            <p class="text-gray-800 dark:text-gray-200 font-medium">Device</p>
                            <p class="text-sm text-gray-500 dark:text-gray-400">@Model.LoginDevice</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Security Section Link -->
            <div class="mt-6 text-center">
                <a href="/Profile/Security" class="inline-flex items-center gap-2 text-purple-600 dark:text-purple-400 hover:text-purple-700 dark:hover:text-purple-300 font-medium transition-colors">
                    <i class="fas fa-shield-alt"></i>
                    <span>Manage Security Settings</span>
                    <i class="fas fa-arrow-right text-sm"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Toast Notifications -->
@if (TempData["Success"] != null)
{
    <div class="fixed bottom-4 right-4 bg-emerald-50 dark:bg-emerald-900/30 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-400 px-6 py-4 rounded-xl shadow-lg flex items-center gap-3 animate-slideIn z-50">
        <i class="fas fa-check-circle text-emerald-500 dark:text-emerald-400"></i>
        <span>@TempData["Success"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="fixed bottom-4 right-4 bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-400 px-6 py-4 rounded-xl shadow-lg flex items-center gap-3 animate-slideIn z-50">
        <i class="fas fa-exclamation-circle text-red-500 dark:text-red-400"></i>
        <span>@TempData["Error"]</span>
    </div>
}

<style>
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fadeIn {
        animation: fadeIn 0.5s ease-out forwards;
    }

    @@keyframes slideIn {
        from {
            transform: translateX(100%);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    .animate-slideIn {
        animation: slideIn 0.3s ease-out forwards;
    }
</style>