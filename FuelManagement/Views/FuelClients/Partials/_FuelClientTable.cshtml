@model FuelManagement.Models.FuelClientIndexViewModel

<div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg dark:shadow-gray-900/30 overflow-hidden border border-gray-200 dark:border-gray-700">
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
            <thead class="bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-gray-700 dark:to-gray-800">
                <tr>
                    <th scope="col" class="px-4 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-blue-800 dark:text-blue-400 uppercase tracking-wider">Client ID</th>
                    <th scope="col" class="px-4 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-blue-800 dark:text-blue-400 uppercase tracking-wider">Name/Company</th>
                    <th scope="col" class="px-4 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-blue-800 dark:text-blue-400 uppercase tracking-wider">Type</th>
                    <th scope="col" class="px-4 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-blue-800 dark:text-blue-400 uppercase tracking-wider">Phone</th>
                    <th scope="col" class="px-4 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-blue-800 dark:text-blue-400 uppercase tracking-wider">Email</th>
                    <th scope="col" class="px-4 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-blue-800 dark:text-blue-400 uppercase tracking-wider">City</th>
                    <th scope="col" class="px-4 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-blue-800 dark:text-blue-400 uppercase tracking-wider">Status</th>
                    <th scope="col" class="px-4 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-blue-800 dark:text-blue-400 uppercase tracking-wider">Added</th>
                    <th scope="col" class="px-4 sm:px-6 py-3 sm:py-4 text-right text-xs font-medium text-blue-800 dark:text-blue-400 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
                @if (Model.Clients.Any())
                {
                    @foreach (var client in Model.Clients)
                    {
                        <tr class="hover:bg-blue-50/50 dark:hover:bg-gray-700/50 transition-colors duration-200 group">
                            <td class="px-4 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <span class="text-xs sm:text-sm font-mono font-medium text-gray-900 dark:text-gray-100">@client.ClientId</span>
                            </td>
                            <td class="px-4 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="text-xs sm:text-sm font-medium text-gray-900 dark:text-gray-100">@client.FullName</div>
                                @if (!string.IsNullOrEmpty(client.CompanyName))
                                {
                                    <div class="text-xs text-gray-500 dark:text-gray-400">@client.CompanyName</div>
                                }
                            </td>
                            <td class="px-4 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <span class="px-2 py-1 text-xs rounded-full bg-blue-100 text-blue-800 dark:bg-blue-900/50 dark:text-blue-300">
                                    @client.ClientType
                                </span>
                            </td>
                            <td class="px-4 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="text-xs sm:text-sm text-gray-600 dark:text-gray-300">@client.Phone</div>
                            </td>
                            <td class="px-4 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 truncate max-w-[150px]">@(client.Email ?? "-")</div>
                            </td>
                            <td class="px-4 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="text-xs sm:text-sm text-gray-600 dark:text-gray-300">@(client.City ?? "-")</div>
                            </td>
                            <td class="px-4 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <span class="px-2 py-1 text-xs rounded-full @client.StatusColor">
                                    @(client.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="px-4 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="text-xs sm:text-sm text-gray-600 dark:text-gray-300">@client.CreatedAt.ToString("MMM dd, yyyy")</div>
                            </td>
                            <td class="px-4 sm:px-6 py-3 sm:py-4 whitespace-nowrap text-right text-xs sm:text-sm font-medium">
                                <div class="flex items-center justify-end space-x-2 opacity-100 sm:opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                                    <a href="@Url.Action("Details", new { id = client.Id })"
                                       class="p-1.5 text-blue-600 hover:bg-blue-50 dark:text-blue-400 dark:hover:bg-gray-700 rounded-lg transition-colors duration-200" title="View">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                        </svg>
                                    </a>
                                    <a href="@Url.Action("Edit", new { id = client.Id })"
                                       class="p-1.5 text-blue-600 hover:bg-blue-50 dark:text-blue-400 dark:hover:bg-gray-700 rounded-lg transition-colors duration-200" title="Edit">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                        </svg>
                                    </a>
                                    <button type="button"
                                            onclick="openDeleteModal(@client.Id, '@client.FullName')"
                                            class="p-1.5 text-red-600 hover:bg-red-50 dark:text-red-400 dark:hover:bg-gray-700 rounded-lg transition-colors duration-200" title="Delete">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="px-4 sm:px-6 py-8 text-center">
                            <div class="flex flex-col items-center justify-center">
                                <div class="w-16 h-16 bg-blue-100 dark:bg-blue-900/30 rounded-full flex items-center justify-center mb-3">
                                    <svg class="w-8 h-8 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                                    </svg>
                                </div>
                                <h3 class="text-sm sm:text-base font-medium text-gray-900 dark:text-gray-100 mb-1">No clients found</h3>
                                <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 mb-4">Get started by adding a new fuel client.</p>
                                <a href="@Url.Action("Create")" class="px-4 py-2 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700 transition-colors">
                                    Add Client
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="bg-gray-50 dark:bg-gray-700 px-4 sm:px-6 py-3 sm:py-4 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-gray-200 dark:border-gray-700">
            <div class="text-sm text-gray-700 dark:text-gray-300 order-2 sm:order-1">
                Showing <span class="font-medium">@(((Model.CurrentPage - 1) * Model.PageSize) + 1)</span> to
                <span class="font-medium">@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount)</span> of
                <span class="font-medium">@Model.TotalCount</span> results
            </div>
            <div class="order-1 sm:order-2">
                <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                    <!-- Previous Button -->
                    <a href="@Url.Action("Index", new {
                        page = Model.CurrentPage - 1,
                        SearchTerm = Model.Filter.SearchTerm,
                        ClientType = Model.Filter.ClientType,
                        Status = Model.Filter.Status,
                        City = Model.Filter.City,
                        FromDate = Model.Filter.FromDate,
                        ToDate = Model.Filter.ToDate
                    })"
                       class="relative inline-flex items-center px-2 sm:px-3 py-2 rounded-l-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-xs sm:text-sm font-medium @(Model.HasPreviousPage ? "text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-600" : "text-gray-400 dark:text-gray-500 cursor-not-allowed pointer-events-none")"
                    @(!Model.HasPreviousPage ? "aria-disabled=true" : "")>
                        <span class="sr-only">Previous</span>
                        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                        </svg>
                    </a>

                    <!-- Page Numbers -->
                    @{
                        int startPage = Math.Max(1, Model.CurrentPage - 2);
                        int endPage = Math.Min(Model.TotalPages, startPage + 4);
                        if (endPage - startPage < 4)
                        {
                            startPage = Math.Max(1, endPage - 4);
                        }
                    }

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <a href="@Url.Action("Index", new {
                            page = i,
                            SearchTerm = Model.Filter.SearchTerm,
                            ClientType = Model.Filter.ClientType,
                            Status = Model.Filter.Status,
                            City = Model.Filter.City,
                            FromDate = Model.Filter.FromDate,
                            ToDate = Model.Filter.ToDate
                        })"
                           class="relative inline-flex items-center px-3 sm:px-4 py-2 border border-gray-300 dark:border-gray-600 text-xs sm:text-sm font-medium @(i == Model.CurrentPage ? "bg-blue-600 text-white hover:bg-blue-700 dark:bg-blue-700 dark:hover:bg-blue-800" : "bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-600")">
                            @i
                        </a>
                    }

                    <!-- Next Button -->
                    <a href="@Url.Action("Index", new {
                        page = Model.CurrentPage + 1,
                        SearchTerm = Model.Filter.SearchTerm,
                        ClientType = Model.Filter.ClientType,
                        Status = Model.Filter.Status,
                        City = Model.Filter.City,
                        FromDate = Model.Filter.FromDate,
                        ToDate = Model.Filter.ToDate
                    })"
                       class="relative inline-flex items-center px-2 sm:px-3 py-2 rounded-r-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-xs sm:text-sm font-medium @(Model.HasNextPage ? "text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-600" : "text-gray-400 dark:text-gray-500 cursor-not-allowed pointer-events-none")"
                    @(!Model.HasNextPage ? "aria-disabled=true" : "")>
                        <span class="sr-only">Next</span>
                        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                        </svg>
                    </a>
                </nav>
            </div>
        </div>
    }
</div>