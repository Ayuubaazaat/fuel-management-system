@model FuelManagement.Models.FuelClientFilterViewModel

<div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-lg rounded-2xl shadow-lg dark:shadow-gray-900/30 p-4 sm:p-6 border border-blue-200 dark:border-blue-800/50">
    <form method="get" action="@Url.Action("Index")" id="filterForm" class="space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 sm:gap-0 mb-4">
            <h3 class="text-base sm:text-lg font-semibold text-gray-800 dark:text-gray-100">Filter Clients</h3>
            <button type="button" onclick="clearAllFilters()"
                    class="text-sm text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 font-medium text-left sm:text-right">
                Clear All
            </button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
            <!-- Date Range -->
            <div class="space-y-1 sm:space-y-2">
                <label class="text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-300">From</label>
                <input type="date" name="FromDate" id="FromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                       class="w-full px-3 sm:px-4 py-2 sm:py-2.5 text-sm rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:border-blue-500 dark:focus:border-blue-400 focus:ring-2 focus:ring-blue-200 dark:focus:ring-blue-800 transition-all duration-200" />
            </div>

            <div class="space-y-1 sm:space-y-2">
                <label class="text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-300">To</label>
                <input type="date" name="ToDate" id="ToDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                       class="w-full px-3 sm:px-4 py-2 sm:py-2.5 text-sm rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:border-blue-500 dark:focus:border-blue-400 focus:ring-2 focus:ring-blue-200 dark:focus:ring-blue-800 transition-all duration-200" />
            </div>

            <!-- Client Type -->
            <div class="space-y-1 sm:space-y-2">
                <label class="text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-300">Client Type</label>
                <select name="ClientType" id="ClientType" class="w-full px-3 sm:px-4 py-2 sm:py-2.5 text-sm rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:border-blue-500 dark:focus:border-blue-400 focus:ring-2 focus:ring-blue-200 dark:focus:ring-blue-800 transition-all duration-200">
                    <option value="">All Types</option>
                    @foreach (var type in Model.AvailableClientTypes)
                    {
                        <option value="@type" selected="@(Model.ClientType == type)">@type</option>
                    }
                </select>
            </div>

            <!-- Status -->
            <div class="space-y-1 sm:space-y-2">
                <label class="text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-300">Status</label>
                <select name="Status" id="Status" class="w-full px-3 sm:px-4 py-2 sm:py-2.5 text-sm rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:border-blue-500 dark:focus:border-blue-400 focus:ring-2 focus:ring-blue-200 dark:focus:ring-blue-800 transition-all duration-200">
                    <option value="">All Status</option>
                    <option value="Active" selected="@(Model.Status == "Active")">Active</option>
                    <option value="Inactive" selected="@(Model.Status == "Inactive")">Inactive</option>
                </select>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
            <!-- City - CHANGED FROM DROPDOWN TO INPUT FIELD -->
            <div class="space-y-1 sm:space-y-2">
                <label class="text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-300">City</label>
                <input type="text"
                       name="City"
                       id="City"
                       value="@Model.City"
                       placeholder="Enter city name..."
                       class="w-full px-3 sm:px-4 py-2 sm:py-2.5 text-sm rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:border-blue-500 dark:focus:border-blue-400 focus:ring-2 focus:ring-blue-200 dark:focus:ring-blue-800 transition-all duration-200" />
            </div>

            <!-- Search -->
            <div class="space-y-1 sm:space-y-2">
                <label class="text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-300">Search</label>
                <input type="text" name="SearchTerm" id="SearchTerm" value="@Model.SearchTerm" placeholder="Name, Phone, Email, ID..."
                       class="w-full px-3 sm:px-4 py-2 sm:py-2.5 text-sm rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:border-blue-500 dark:focus:border-blue-400 focus:ring-2 focus:ring-blue-200 dark:focus:ring-blue-800 transition-all duration-200" />
            </div>
        </div>

        <div class="flex justify-end pt-2 sm:pt-4">
            <button type="submit"
                    class="w-full sm:w-auto px-4 sm:px-6 py-2.5 sm:py-2.5 bg-gradient-to-r from-blue-600 to-blue-800 dark:from-blue-700 dark:to-blue-800 text-white font-medium rounded-xl hover:from-blue-700 dark:hover:from-blue-800 hover:to-blue-900 dark:hover:to-blue-900 transform hover:scale-105 transition-all duration-200 shadow-lg hover:shadow-xl text-sm sm:text-base">
                Apply Filters
            </button>
        </div>
    </form>
</div>

<script>
    function clearAllFilters() {
        document.getElementById('FromDate').value = '';
        document.getElementById('ToDate').value = '';
        document.getElementById('ClientType').value = '';
        document.getElementById('Status').value = '';
        document.getElementById('City').value = '';
        document.getElementById('SearchTerm').value = '';
        document.getElementById('filterForm').submit();
    }
</script>