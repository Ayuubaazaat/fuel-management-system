@model FuelManagement.Models.FuelSaleViewModel

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
    <!-- Total Sales Card -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg dark:shadow-2xl p-4 sm:p-6 card-hover animate-fadeIn border border-gray-100 dark:border-gray-700 group" style="animation-delay: 0.1s;">
        <div class="flex items-center justify-between mb-3 sm:mb-4">
            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-orange-100 dark:bg-orange-900/30 rounded-xl flex items-center justify-center group-hover:bg-orange-200 dark:group-hover:bg-orange-800/40 transition-colors duration-300">
                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-orange-600 dark:text-orange-400 group-hover:text-orange-700 dark:group-hover:text-orange-300 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
            </div>
            <!-- FIXED: Compact formatted sales amount badge using GetCompactRevenue -->
            <span class="text-xs sm:text-sm font-semibold text-orange-500 dark:text-orange-400 bg-orange-50 dark:bg-orange-900/30 px-2 sm:px-2.5 py-1 rounded-full group-hover:bg-orange-100 dark:group-hover:bg-orange-800/40 transition-colors duration-300">
                @Model.GetCompactRevenue(Model.TotalSalesAmount)
            </span>
        </div>
        <h3 class="text-gray-500 dark:text-gray-400 text-xs sm:text-sm mb-1 group-hover:text-gray-700 dark:group-hover:text-gray-300 transition-colors duration-300">Total Fuel Sales</h3>
        <!-- Full amount for main display (can keep as is or also format) -->
        <p class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors duration-300">@Model.TotalSalesAmount.ToString("C")</p>
        <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-500 mt-2 group-hover:text-gray-600 dark:group-hover:text-gray-400 transition-colors duration-300">vs last month</p>
    </div>

    <!-- Total Liters Card -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg dark:shadow-2xl p-4 sm:p-6 card-hover animate-fadeIn border border-gray-100 dark:border-gray-700 group" style="animation-delay: 0.2s;">
        <div class="flex items-center justify-between mb-3 sm:mb-4">
            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-amber-100 dark:bg-amber-900/30 rounded-xl flex items-center justify-center group-hover:bg-amber-200 dark:group-hover:bg-amber-800/40 transition-colors duration-300">
                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-amber-600 dark:text-amber-400 group-hover:text-amber-700 dark:group-hover:text-amber-300 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
                </svg>
            </div>
            <!-- FIXED: Compact formatted liters badge -->
            <span class="text-xs sm:text-sm font-semibold text-amber-500 dark:text-amber-400 bg-amber-50 dark:bg-amber-900/30 px-2 sm:px-2.5 py-1 rounded-full group-hover:bg-amber-100 dark:group-hover:bg-amber-800/40 transition-colors duration-300">
                @Model.GetFormattedTotalLitersSold()
            </span>
        </div>
        <h3 class="text-gray-500 dark:text-gray-400 text-xs sm:text-sm mb-1 group-hover:text-gray-700 dark:group-hover:text-gray-300 transition-colors duration-300">Total Liters Sold</h3>
        <!-- Full liters for main display -->
        <p class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors duration-300">@Model.TotalLitersSold.ToString("N0")L</p>
        <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-500 mt-2 group-hover:text-gray-600 dark:group-hover:text-gray-400 transition-colors duration-300">vs last month</p>
    </div>

    <!-- Today's Revenue Card -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg dark:shadow-2xl p-4 sm:p-6 card-hover animate-fadeIn border border-gray-100 dark:border-gray-700 group" style="animation-delay: 0.3s;">
        <div class="flex items-center justify-between mb-3 sm:mb-4">
            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-green-100 dark:bg-green-900/30 rounded-xl flex items-center justify-center group-hover:bg-green-200 dark:group-hover:bg-green-800/40 transition-colors duration-300">
                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-green-600 dark:text-green-400 group-hover:text-green-700 dark:group-hover:text-green-300 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                </svg>
            </div>
            @if (ViewBag.RevenueVsAverageIsNew)
            {
                <span class="text-xs sm:text-sm font-semibold text-blue-500 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/30 px-2 sm:px-2.5 py-1 rounded-full group-hover:bg-blue-100 dark:group-hover:bg-blue-800/40 transition-colors duration-300">
                    @ViewBag.RevenueVsAverageValue
                </span>
            }
            else
            {
                <span class="text-xs sm:text-sm font-semibold @(ViewBag.RevenueVsAverageRaw >= 0 ? "text-green-500 dark:text-green-400 bg-green-50 dark:bg-green-900/30" : "text-red-500 dark:text-red-400 bg-red-50 dark:bg-red-900/30") px-2 sm:px-2.5 py-1 rounded-full group-hover:bg-opacity-80 dark:group-hover:bg-opacity-40 transition-all duration-300">
                    @ViewBag.RevenueVsAverageValue
                </span>
            }
        </div>
        <h3 class="text-gray-500 dark:text-gray-400 text-xs sm:text-sm mb-1 group-hover:text-gray-700 dark:group-hover:text-gray-300 transition-colors duration-300">Today's Revenue</h3>
        <p class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white group-hover:text-green-600 dark:group-hover:text-green-400 transition-colors duration-300">@Model.TodaysRevenue.ToString("C")</p>
        <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-500 mt-2 group-hover:text-gray-600 dark:group-hover:text-gray-400 transition-colors duration-300">vs avg. day</p>
    </div>

    <!-- Pending Invoices Card -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg dark:shadow-2xl p-4 sm:p-6 card-hover animate-fadeIn border border-gray-100 dark:border-gray-700 group" style="animation-delay: 0.4s;">
        <div class="flex items-center justify-between mb-3 sm:mb-4">
            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-red-100 dark:bg-red-900/30 rounded-xl flex items-center justify-center group-hover:bg-red-200 dark:group-hover:bg-red-800/40 transition-colors duration-300">
                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-red-600 dark:text-red-400 group-hover:text-red-700 dark:group-hover:text-red-300 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
            </div>
            @if (ViewBag.PendingChangeIsNew)
            {
                <span class="text-xs sm:text-sm font-semibold text-blue-500 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/30 px-2 sm:px-2.5 py-1 rounded-full group-hover:bg-blue-100 dark:group-hover:bg-blue-800/40 transition-colors duration-300">
                    @ViewBag.PendingChangeValue
                </span>
            }
            else
            {
                <span class="text-xs sm:text-sm font-semibold @(ViewBag.PendingChangeRaw <= 0 ? "text-green-500 dark:text-green-400 bg-green-50 dark:bg-green-900/30" : "text-red-500 dark:text-red-400 bg-red-50 dark:bg-red-900/30") px-2 sm:px-2.5 py-1 rounded-full group-hover:bg-opacity-80 dark:group-hover:bg-opacity-40 transition-all duration-300">
                    @ViewBag.PendingChangeValue
                </span>
            }
        </div>
        <h3 class="text-gray-500 dark:text-gray-400 text-xs sm:text-sm mb-1 group-hover:text-gray-700 dark:group-hover:text-gray-300 transition-colors duration-300">Pending Invoices</h3>
        <p class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors duration-300">@Model.PendingInvoices</p>
        <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-500 mt-2 group-hover:text-gray-600 dark:group-hover:text-gray-400 transition-colors duration-300">requires action</p>
    </div>
</div>

<style>
    .card-hover {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .card-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px -5px rgba(249, 115, 22, 0.1), 0 10px 10px -5px rgba(249, 115, 22, 0.04);
        }

        /* Card 1 - Orange shadow */
        .card-hover:nth-child(1):hover {
            box-shadow: 0 20px 25px -5px rgba(249, 115, 22, 0.15), 0 10px 10px -5px rgba(249, 115, 22, 0.05);
        }

        /* Card 2 - Amber shadow */
        .card-hover:nth-child(2):hover {
            box-shadow: 0 20px 25px -5px rgba(245, 158, 11, 0.15), 0 10px 10px -5px rgba(245, 158, 11, 0.05);
        }

        /* Card 3 - Green shadow */
        .card-hover:nth-child(3):hover {
            box-shadow: 0 20px 25px -5px rgba(34, 197, 94, 0.15), 0 10px 10px -5px rgba(34, 197, 94, 0.05);
        }

        /* Card 4 - Red shadow */
        .card-hover:nth-child(4):hover {
            box-shadow: 0 20px 25px -5px rgba(239, 68, 68, 0.15), 0 10px 10px -5px rgba(239, 68, 68, 0.05);
        }

    .dark .card-hover:nth-child(1):hover {
        box-shadow: 0 20px 25px -5px rgba(249, 115, 22, 0.25), 0 10px 10px -5px rgba(249, 115, 22, 0.15);
    }

    .dark .card-hover:nth-child(2):hover {
        box-shadow: 0 20px 25px -5px rgba(245, 158, 11, 0.25), 0 10px 10px -5px rgba(245, 158, 11, 0.15);
    }

    .dark .card-hover:nth-child(3):hover {
        box-shadow: 0 20px 25px -5px rgba(34, 197, 94, 0.25), 0 10px 10px -5px rgba(34, 197, 94, 0.15);
    }

    .dark .card-hover:nth-child(4):hover {
        box-shadow: 0 20px 25px -5px rgba(239, 68, 68, 0.25), 0 10px 10px -5px rgba(239, 68, 68, 0.15);
    }

    .animate-fadeIn {
        animation: fadeIn 0.6s ease-out forwards;
        opacity: 0;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>