@{
    var currentDate = DateTime.Now.ToString("dddd, MMMM dd, yyyy");
}

<div class="bg-gradient-to-r from-orange-500 via-amber-500 to-orange-500 text-white animate-gradient">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 animate-slideIn">
            <div>
                <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold mb-2">Fuel Sales Dashboard</h1>
                <p class="text-orange-100 text-sm sm:text-base">Manage and track all fuel sales transactions</p>
                <p class="text-xs sm:text-sm text-orange-200 mt-2">
                    <i class="far fa-calendar-alt mr-2"></i>@currentDate
                </p>
            </div>
            <div>
                <a href="@Url.Action("Create")"
                   class="inline-flex w-full sm:w-auto items-center justify-center px-4 sm:px-6 py-3 bg-white text-orange-600 rounded-xl font-semibold hover:bg-orange-50 transform hover:scale-105 transition-all duration-200 shadow-lg hover:shadow-xl group text-sm sm:text-base">
                    <svg class="w-4 h-4 sm:w-5 sm:h-5 mr-2 group-hover:rotate-90 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                    </svg>
                    New Sale
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .animate-gradient {
        background-size: 200% 200%;
        animation: gradient 15s ease infinite;
    }

    @@keyframes gradient {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    .animate-slideIn {
        animation: slideIn 0.6s ease-out;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>