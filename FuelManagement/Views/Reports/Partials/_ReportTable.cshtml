@model IEnumerable<FuelManagement.Models.ReportListItemViewModel>
@{
    var pageNumber = ViewBag.PageNumber ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var pageSize = ViewBag.PageSize ?? 10;
    var totalCount = ViewBag.TotalCount ?? 0;
    var filter = ViewBag.CurrentFilter as FuelManagement.Models.ReportFilterViewModel ?? new FuelManagement.Models.ReportFilterViewModel();
    var startIndex = (pageNumber - 1) * pageSize + 1;
    var endIndex = Math.Min(pageNumber * pageSize, totalCount);
    var hasItems = Model != null && Model.Any();
}

<div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg overflow-hidden border border-indigo-100 dark:border-indigo-800">
    @if (hasItems)
    {
        <div class="overflow-x-auto">
            <table class="min-w-[800px] sm:min-w-full divide-y divide-indigo-200 dark:divide-indigo-700">
                <thead class="bg-gradient-to-r from-indigo-50 to-blue-50 dark:from-gray-700 dark:to-gray-800">
                    <tr>
                        <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-indigo-800 dark:text-indigo-300 uppercase tracking-wider">Period</th>
                        <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-right text-xs font-medium text-indigo-800 dark:text-indigo-300 uppercase tracking-wider">Revenue</th>
                        <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-right text-xs font-medium text-indigo-800 dark:text-indigo-300 uppercase tracking-wider">VAT (5%)</th>
                        <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-right text-xs font-medium text-indigo-800 dark:text-indigo-300 uppercase tracking-wider">Outstanding</th>
                        <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-right text-xs font-medium text-indigo-800 dark:text-indigo-300 uppercase tracking-wider">Invoices</th>
                        <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-indigo-800 dark:text-indigo-300 uppercase tracking-wider">Payment Rate</th>
                        <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-indigo-800 dark:text-indigo-300 uppercase tracking-wider">Status</th>
                    </tr>
                </thead>
                <tbody class="bg-white dark:bg-gray-800 divide-y divide-indigo-200 dark:divide-indigo-700">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-indigo-50/30 dark:hover:bg-gray-700 transition-colors duration-200">
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <span class="text-xs sm:text-sm font-medium text-slate-800 dark:text-gray-200">@item.FormattedMonth</span>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap text-right">
                                <span class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-gray-200">@item.FormattedRevenue</span>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap text-right">
                                <span class="text-xs sm:text-sm text-indigo-600 dark:text-indigo-400 font-medium">@item.FormattedVAT</span>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap text-right">
                                <span class="text-xs sm:text-sm text-amber-600 dark:text-amber-400 font-medium">@item.FormattedOutstanding</span>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap text-right">
                                <span class="text-xs sm:text-sm text-slate-600 dark:text-gray-400">@item.FormattedPaidInvoices / @item.FormattedTotalInvoices</span>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    <div class="w-12 sm:w-16 bg-gray-200 dark:bg-gray-700 rounded-full h-1.5 sm:h-2 mr-1 sm:mr-2">
                                        <div class="bg-gradient-to-r from-indigo-500 to-blue-500 dark:from-indigo-400 dark:to-blue-400 h-1.5 sm:h-2 rounded-full" style="width: @item.PaidPercentage%;"></div>
                                    </div>
                                    <span class="text-xs text-slate-600 dark:text-gray-400">@item.PaidPercentage.ToString("F0")%</span>
                                </div>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <span class="px-2 sm:px-3 py-1 rounded-full text-xs font-medium @item.StatusColor">
                                    @item.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="bg-indigo-50 dark:bg-gray-700 px-4 sm:px-6 py-3 sm:py-4 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-indigo-200 dark:border-indigo-700">
            <div class="text-sm text-slate-700 dark:text-gray-300 order-2 sm:order-1">
                Showing <span class="font-medium">@startIndex</span> to <span class="font-medium">@endIndex</span> of <span class="font-medium">@totalCount</span> results
            </div>
            <div class="order-1 sm:order-2">
                <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                    <!-- Previous Button -->
                    <a href="@Url.Action("Index", new {
                        pageNumber = pageNumber - 1,
                        pageSize = pageSize,
                        StartDate = filter.StartDate,
                        EndDate = filter.EndDate,
                        ReportType = filter.ReportType
                    })"
                       class="relative inline-flex items-center px-2 sm:px-3 py-2 rounded-l-md border border-indigo-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-xs sm:text-sm font-medium @(pageNumber > 1 ? "text-slate-500 dark:text-gray-400 hover:bg-indigo-50 dark:hover:bg-gray-700" : "text-slate-300 dark:text-gray-600 cursor-not-allowed pointer-events-none")"
                    @(pageNumber <= 1 ? "aria-disabled=true" : "")>
                        <span class="sr-only">Previous</span>
                        <svg class="h-4 w-4 sm:h-5 sm:w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                        </svg>
                    </a>

                    <!-- Page Numbers -->
                    @{
                        int startPage = Math.Max(1, pageNumber - 2);
                        int endPage = Math.Min(totalPages, startPage + 4);
                        if (endPage - startPage < 4)
                        {
                            startPage = Math.Max(1, endPage - 4);
                        }
                    }

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <a href="@Url.Action("Index", new {
                            pageNumber = i,
                            pageSize = pageSize,
                            StartDate = filter.StartDate,
                            EndDate = filter.EndDate,
                            ReportType = filter.ReportType
                        })"
                           class="relative inline-flex items-center px-3 sm:px-4 py-2 border border-indigo-300 dark:border-gray-600 text-xs sm:text-sm font-medium @(i == pageNumber ? "bg-indigo-100 dark:bg-indigo-900/50 text-indigo-700 dark:text-indigo-400 hover:bg-indigo-200 dark:hover:bg-indigo-800/50" : "bg-white dark:bg-gray-800 text-slate-700 dark:text-gray-300 hover:bg-indigo-50 dark:hover:bg-gray-700")">
                            @i
                        </a>
                    }

                    <!-- Next Button -->
                    <a href="@Url.Action("Index", new {
                        pageNumber = pageNumber + 1,
                        pageSize = pageSize,
                        StartDate = filter.StartDate,
                        EndDate = filter.EndDate,
                        ReportType = filter.ReportType
                    })"
                       class="relative inline-flex items-center px-2 sm:px-3 py-2 rounded-r-md border border-indigo-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-xs sm:text-sm font-medium @(pageNumber < totalPages ? "text-slate-500 dark:text-gray-400 hover:bg-indigo-50 dark:hover:bg-gray-700" : "text-slate-300 dark:text-gray-600 cursor-not-allowed pointer-events-none")"
                    @(pageNumber >= totalPages ? "aria-disabled=true" : "")>
                        <span class="sr-only">Next</span>
                        <svg class="h-4 w-4 sm:h-5 sm:w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                        </svg>
                    </a>
                </nav>
            </div>
        </div>
    }
    else
    {
        <!-- No Data Found Message -->
        <div class="py-12 sm:py-16 text-center">
            <div class="flex justify-center mb-4">
                <div class="w-16 h-16 sm:w-20 sm:h-20 bg-indigo-100 dark:bg-indigo-900/30 rounded-full flex items-center justify-center">
                    <svg class="w-8 h-8 sm:w-10 sm:h-10 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                </div>
            </div>
            <h3 class="text-lg sm:text-xl font-semibold text-slate-800 dark:text-gray-200 mb-2">No report data found</h3>
            <p class="text-sm sm:text-base text-slate-600 dark:text-gray-400">Try adjusting your filters or adding more invoices.</p>
        </div>
    }
</div>