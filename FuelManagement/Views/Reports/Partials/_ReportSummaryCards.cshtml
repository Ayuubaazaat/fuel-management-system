@model FuelManagement.Models.ReportSummaryViewModel

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
    <!-- Total Revenue Card -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-4 sm:p-6 card-hover animate-fadeIn border border-indigo-100 dark:border-indigo-800" style="animation-delay: 0.1s;">
        <div class="flex items-center justify-between mb-3 sm:mb-4">
            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-indigo-100 dark:bg-indigo-900/50 rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
            </div>
            <span class="text-xs sm:text-sm font-semibold text-green-500 dark:text-green-400 bg-green-50 dark:bg-green-900/30 px-2 sm:px-2.5 py-1 rounded-full">+@((Model.PaidInvoices * 100 / (Model.TotalInvoices > 0 ? Model.TotalInvoices : 1)).ToString("F0"))%</span>
        </div>
        <h3 class="text-gray-500 dark:text-gray-400 text-xs sm:text-sm mb-1">Total Revenue</h3>
        <!-- FIXED: Shows compact format with B, M, K -->
        <p class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-gray-100">@Model.FormattedTotalRevenue</p>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-2">@Model.TotalInvoices invoices processed</p>
    </div>

    <!-- VAT Collected Card -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-4 sm:p-6 card-hover animate-fadeIn border border-indigo-100 dark:border-indigo-800" style="animation-delay: 0.2s;">
        <div class="flex items-center justify-between mb-3 sm:mb-4">
            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-blue-100 dark:bg-blue-900/50 rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2zM10 8.5a.5.5 0 11-1 0 .5.5 0 011 0zm5 5a.5.5 0 11-1 0 .5.5 0 011 0z"></path>
                </svg>
            </div>
            <span class="text-xs sm:text-sm font-semibold text-blue-500 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/30 px-2 sm:px-2.5 py-1 rounded-full">5% Somali VAT</span>
        </div>
        <h3 class="text-gray-500 dark:text-gray-400 text-xs sm:text-sm mb-1">VAT Collected</h3>
        <!-- FIXED: Shows compact format with B, M, K -->
        <p class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-gray-100">@Model.FormattedTotalVAT</p>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-2">@((Model.TotalRevenue * 0.05m).ToString("C")) total collected</p>
    </div>

    <!-- Outstanding Balance Card -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-4 sm:p-6 card-hover animate-fadeIn border border-indigo-100 dark:border-indigo-800" style="animation-delay: 0.3s;">
        <div class="flex items-center justify-between mb-3 sm:mb-4">
            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-amber-100 dark:bg-amber-900/50 rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
            </div>
            <span class="text-xs sm:text-sm font-semibold text-amber-500 dark:text-amber-400 bg-amber-50 dark:bg-amber-900/30 px-2 sm:px-2.5 py-1 rounded-full">@Model.OverdueInvoices overdue</span>
        </div>
        <h3 class="text-gray-500 dark:text-gray-400 text-xs sm:text-sm mb-1">Outstanding Balance</h3>
        <!-- FIXED: Shows compact format with B, M, K -->
        <p class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-gray-100">@Model.FormattedTotalOutstanding</p>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-2">Across @Model.OverdueInvoices invoices</p>
    </div>

    <!-- Collection Rate Card -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-4 sm:p-6 card-hover animate-fadeIn border border-indigo-100 dark:border-indigo-800" style="animation-delay: 0.4s;">
        <div class="flex items-center justify-between mb-3 sm:mb-4">
            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-purple-100 dark:bg-purple-900/50 rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
            </div>
            <span class="text-xs sm:text-sm font-semibold text-purple-500 dark:text-purple-400 bg-purple-50 dark:bg-purple-900/30 px-2 sm:px-2.5 py-1 rounded-full">@Model.PaidInvoices paid</span>
        </div>
        <h3 class="text-gray-500 dark:text-gray-400 text-xs sm:text-sm mb-1">Collection Rate</h3>
        <p class="text-xl sm:text-2xl font-bold @Model.CollectionRateColor">@Model.FormattedCollectionRate</p>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-2">@Model.PaidInvoices of @Model.TotalInvoices invoices paid</p>
    </div>
</div>

<style>
    .card-hover {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .card-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px -5px rgba(79, 70, 229, 0.1), 0 10px 10px -5px rgba(79, 70, 229, 0.04);
        }

    .dark .card-hover:hover {
        box-shadow: 0 20px 25px -5px rgba(79, 70, 229, 0.3), 0 10px 10px -5px rgba(79, 70, 229, 0.2);
    }

    .animate-fadeIn {
        animation: fadeIn 0.6s ease-out forwards;
        opacity: 0;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>