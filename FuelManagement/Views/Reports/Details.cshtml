@{
    ViewData["Title"] = "Report Details";
}

<div class="min-h-screen bg-gradient-to-br from-slate-50 to-gray-50 dark:from-gray-900 dark:to-gray-800 py-4 sm:py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center py-8 sm:py-12">
            <svg class="mx-auto h-12 w-12 sm:h-16 sm:w-16 text-indigo-400 dark:text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
            <h2 class="mt-3 sm:mt-4 text-xl sm:text-2xl font-semibold text-slate-800 dark:text-gray-200">Detailed Report View</h2>
            <p class="mt-1 sm:mt-2 text-sm sm:text-base text-slate-600 dark:text-gray-400">This feature will be available in the next update.</p>
            <a href="@Url.Action("Index")"
               class="mt-4 sm:mt-6 inline-flex items-center px-4 sm:px-6 py-2 sm:py-2.5 bg-gradient-to-r from-indigo-600 to-blue-600 dark:from-indigo-700 dark:to-blue-700 text-white text-sm sm:text-base rounded-lg hover:from-indigo-700 dark:hover:from-indigo-800 hover:to-blue-700 dark:hover:to-blue-800 transition-all duration-200">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                Back to Reports
            </a>
        </div>
    </div>
</div>