@using FuelManagement.Models.ViewModels
@model List<FuelManagement.Models.ViewModels.NotificationViewModel>

@{
    ViewData["Title"] = "Notifications";
    var unreadCount = ViewBag.UnreadCount ?? 0;
    var totalCount = ViewBag.TotalCount ?? 0;
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var filter = ViewBag.Filter as NotificationFilterViewModel ?? new NotificationFilterViewModel();
}

<!-- Page Header -->
<div class="mb-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="text-2xl md:text-3xl font-bold text-gray-800 dark:text-gray-100">Notifications</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Manage your enterprise fuel system alerts and activity</p>
        </div>
        <div class="flex items-center gap-3">
            <button id="markAllReadBtn" class="px-4 py-2 text-sm bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 transition-colors">
                <i class="fas fa-check-double mr-2"></i>Mark All as Read
            </button>
            <button id="clearHistoryBtn" class="px-4 py-2 text-sm bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl hover:bg-red-50 dark:hover:bg-red-900/20 text-red-600 dark:text-red-400 transition-colors">
                <i class="fas fa-trash-alt mr-2"></i>Clear History
            </button>
        </div>
    </div>
</div>

<div class="flex flex-col lg:flex-row gap-8">
    <!-- Sidebar - Module Filters -->
    <div class="lg:w-64 shrink-0">
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-6 sticky top-24">
            <h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-4">Modules</h2>

            <!-- All Modules -->
            <div class="space-y-2 mb-4">
                <a href="@Url.Action("Index", "Notification")" class="module-filter-link flex items-center gap-3 px-4 py-2 rounded-xl text-sm font-medium transition-all duration-300 @(string.IsNullOrEmpty(Context.Request.Query["module"]) ? "bg-purple-50 dark:bg-purple-900/30 text-purple-700 dark:text-purple-400" : "text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700")" data-module="">
                    <i class="fas fa-globe w-5"></i>
                    <span>All Modules</span>
                </a>
            </div>

            <!-- MANAGEMENT SECTION -->
            <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2 px-4">Management</p>
            <div class="space-y-2 mb-4">
                <!-- Users -->
                <a href="@Url.Action("Index", "Notification", new { module = "Users" })" class="module-filter-link flex items-center gap-3 px-4 py-2 rounded-xl text-sm font-medium transition-all duration-300 @(Context.Request.Query["module"] == "Users" ? "bg-purple-50 dark:bg-purple-900/30 text-purple-700 dark:text-purple-400" : "text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700")" data-module="Users">
                    <i class="fas fa-users w-5"></i>
                    <span>Users</span>
                </a>

                <!-- Fuel Clients -->
                <a href="@Url.Action("Index", "Notification", new { module = "Fuel Clients" })" class="module-filter-link flex items-center gap-3 px-4 py-2 rounded-xl text-sm font-medium transition-all duration-300 @(Context.Request.Query["module"] == "Fuel Clients" ? "bg-purple-50 dark:bg-purple-900/30 text-purple-700 dark:text-purple-400" : "text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700")" data-module="Fuel Clients">
                    <i class="fas fa-user-tie w-5"></i>
                    <span>Fuel Clients</span>
                </a>

                <!-- Fuel Sales -->
                <a href="@Url.Action("Index", "Notification", new { module = "Fuel Sales" })" class="module-filter-link flex items-center gap-3 px-4 py-2 rounded-xl text-sm font-medium transition-all duration-300 @(Context.Request.Query["module"] == "Fuel Sales" ? "bg-purple-50 dark:bg-purple-900/30 text-purple-700 dark:text-purple-400" : "text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700")" data-module="Fuel Sales">
                    <i class="fas fa-gas-pump w-5"></i>
                    <span>Fuel Sales</span>
                </a>

                <!-- Inventory -->
                <a href="@Url.Action("Index", "Notification", new { module = "Inventory" })" class="module-filter-link flex items-center gap-3 px-4 py-2 rounded-xl text-sm font-medium transition-all duration-300 @(Context.Request.Query["module"] == "Inventory" ? "bg-purple-50 dark:bg-purple-900/30 text-purple-700 dark:text-purple-400" : "text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700")" data-module="Inventory">
                    <i class="fas fa-warehouse w-5"></i>
                    <span>Inventory</span>
                </a>

                <!-- Fleet Mgmt -->
                <a href="@Url.Action("Index", "Notification", new { module = "Fleet Mgmt" })" class="module-filter-link flex items-center gap-3 px-4 py-2 rounded-xl text-sm font-medium transition-all duration-300 @(Context.Request.Query["module"] == "Fleet Mgmt" ? "bg-purple-50 dark:bg-purple-900/30 text-purple-700 dark:text-purple-400" : "text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700")" data-module="Fleet Mgmt">
                    <i class="fas fa-truck w-5"></i>
                    <span>Fleet Mgmt</span>
                </a>

                <!-- Trips -->
                <a href="@Url.Action("Index", "Notification", new { module = "Trips" })" class="module-filter-link flex items-center gap-3 px-4 py-2 rounded-xl text-sm font-medium transition-all duration-300 @(Context.Request.Query["module"] == "Trips" ? "bg-purple-50 dark:bg-purple-900/30 text-purple-700 dark:text-purple-400" : "text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700")" data-module="Trips">
                    <i class="fas fa-route w-5"></i>
                    <span>Trips</span>
                </a>

                <!-- Pumps -->
                <a href="@Url.Action("Index", "Notification", new { module = "Pumps" })" class="module-filter-link flex items-center gap-3 px-4 py-2 rounded-xl text-sm font-medium transition-all duration-300 @(Context.Request.Query["module"] == "Pumps" ? "bg-purple-50 dark:bg-purple-900/30 text-purple-700 dark:text-purple-400" : "text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700")" data-module="Pumps">
                    <i class="fas fa-oil-can w-5"></i>
                    <span>Pumps</span>
                </a>

                <!-- Compensation -->
                <a href="@Url.Action("Index", "Notification", new { module = "Compensation" })" class="module-filter-link flex items-center gap-3 px-4 py-2 rounded-xl text-sm font-medium transition-all duration-300 @(Context.Request.Query["module"] == "Compensation" ? "bg-purple-50 dark:bg-purple-900/30 text-purple-700 dark:text-purple-400" : "text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700")" data-module="Compensation">
                    <i class="fas fa-hand-holding-usd w-5"></i>
                    <span>Compensation</span>
                </a>
            </div>
            <!-- Shifts -->
            <a href="@Url.Action("Index", "Notification", new { module = "Shifts" })"
               class="module-filter-link flex items-center gap-3 px-4 py-2 rounded-xl text-sm font-medium transition-all duration-300 @(Context.Request.Query["module"] == "Shifts" ? "bg-purple-50 dark:bg-purple-900/30 text-purple-700 dark:text-purple-400" : "text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700")"
               data-module="Shifts">
                <i class="fas fa-clock w-5"></i>
                <span>Shifts</span>
            </a>
            <!-- Car Wash -->
            <a href="@Url.Action("Index", "Notification", new { module = "Car Wash" })"
               class="module-filter-link flex items-center gap-3 px-4 py-2 rounded-xl text-sm font-medium transition-all duration-300 @(Context.Request.Query["module"] == "Car Wash" ? "bg-purple-50 dark:bg-purple-900/30 text-purple-700 dark:text-purple-400" : "text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700")"
               data-module="Car Wash">
                 <i class="fas fa-soap w-5"></i>
                 <span>Car Wash</span>
            </a>

            <!-- FINANCIAL SECTION -->
            <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2 px-4">Financial</p>
            <div class="space-y-2 mb-4">
                <!-- Invoices -->
                <a href="@Url.Action("Index", "Notification", new { module = "Invoices" })" class="module-filter-link flex items-center gap-3 px-4 py-2 rounded-xl text-sm font-medium transition-all duration-300 @(Context.Request.Query["module"] == "Invoices" ? "bg-purple-50 dark:bg-purple-900/30 text-purple-700 dark:text-purple-400" : "text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700")" data-module="Invoices">
                    <i class="fas fa-file-invoice-dollar w-5"></i>
                    <span>Invoices</span>
                </a>

                <!-- Receipts -->
                <a href="@Url.Action("Index", "Notification", new { module = "Receipts" })" class="module-filter-link flex items-center gap-3 px-4 py-2 rounded-xl text-sm font-medium transition-all duration-300 @(Context.Request.Query["module"] == "Receipts" ? "bg-purple-50 dark:bg-purple-900/30 text-purple-700 dark:text-purple-400" : "text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700")" data-module="Receipts">
                    <i class="fas fa-receipt w-5"></i>
                    <span>Receipts</span>
                </a>
            </div>

            <!-- Stats -->
            <div class="pt-4 mt-4 border-t border-gray-200 dark:border-gray-700">
                <div class="flex items-center justify-between text-sm mb-2">
                    <span class="text-gray-500 dark:text-gray-400">Unread</span>
                    <span class="font-semibold text-gray-800 dark:text-gray-200" id="unreadCount">@unreadCount</span>
                </div>
                <div class="flex items-center justify-between text-sm">
                    <span class="text-gray-500 dark:text-gray-400">Total</span>
                    <span class="font-semibold text-gray-800 dark:text-gray-200">@totalCount</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="flex-1">
        <!-- Filters -->
        @await Html.PartialAsync("_PartialFilters", filter)

        <!-- Notifications List -->
        <div class="space-y-4" id="notificationsList">
            @if (Model.Any())
            {
                @foreach (var notification in Model)
                {
                    @await Html.PartialAsync("_PartialNotificationItem", notification)
                }
            }
            else
            {
                <div class="bg-white dark:bg-gray-800 rounded-2xl p-12 text-center border border-gray-100 dark:border-gray-700">
                    <div class="w-20 h-20 bg-purple-100 dark:bg-purple-900/30 rounded-2xl flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-bell-slash text-3xl text-purple-600 dark:text-purple-400"></i>
                    </div>
                    <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-2">No notifications found</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Try adjusting your filters or check back later.</p>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="mt-8 flex justify-center">
                <nav class="flex items-center gap-2">
                    <button class="pagination-btn w-10 h-10 flex items-center justify-center rounded-xl border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors @(currentPage <= 1 ? "opacity-50 cursor-not-allowed" : "")" data-page="@(currentPage - 1)" @(currentPage <= 1 ? "disabled" : "")>
                        <i class="fas fa-chevron-left text-sm text-gray-600 dark:text-gray-400"></i>
                    </button>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                        {
                            <button class="pagination-btn w-10 h-10 flex items-center justify-center rounded-xl @(i == currentPage ? "bg-gradient-to-r from-purple-600 to-blue-600 text-white" : "border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300") transition-colors" data-page="@i">
                                @i
                            </button>
                        }
                        else if (i == currentPage - 3 || i == currentPage + 3)
                        {
                            <span class="text-gray-400">...</span>
                        }
                    }

                    <button class="pagination-btn w-10 h-10 flex items-center justify-center rounded-xl border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors @(currentPage >= totalPages ? "opacity-50 cursor-not-allowed" : "")" data-page="@(currentPage + 1)" @(currentPage >= totalPages ? "disabled" : "")>
                        <i class="fas fa-chevron-right text-sm text-gray-600 dark:text-gray-400"></i>
                    </button>
                </nav>
            </div>
        }

        <!-- Load More -->
        @if (Model.Any() && totalPages > currentPage)
        {
            <div class="mt-6 text-center">
                <button id="loadMoreBtn" class="px-6 py-3 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 font-medium rounded-xl transition-colors">
                    <i class="fas fa-sync-alt mr-2"></i>Load More Activity
                </button>
            </div>
        }
    </div>
</div>

<!-- Modern Clear History Modal -->
<div id="clearHistoryModal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 hidden">
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-2xl max-w-md w-full mx-4 p-6 animate-scaleIn">
        <div class="flex items-center justify-center w-16 h-16 bg-red-100 dark:bg-red-900/30 rounded-2xl mx-auto mb-4">
            <i class="fas fa-exclamation-triangle text-3xl text-red-600 dark:text-red-400"></i>
        </div>

        <h3 class="text-xl font-bold text-gray-800 dark:text-gray-100 text-center mb-2">Clear Notification History</h3>
        <p class="text-sm text-gray-600 dark:text-gray-400 text-center mb-6">
            Are you sure you want to clear all notification history?<br>
            This action cannot be undone and will remove all associated data.
        </p>

        <div class="flex gap-3">
            <button id="cancelClearBtn" class="flex-1 px-4 py-3 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 font-medium rounded-xl transition-colors">
                Cancel
            </button>
            <button id="confirmClearBtn" class="flex-1 px-4 py-3 bg-gradient-to-r from-red-600 to-red-500 hover:from-red-700 hover:to-red-600 text-white font-medium rounded-xl transition-all duration-300 transform hover:scale-105">
                Clear History
            </button>
        </div>
    </div>
</div>
<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script src="~/js/notifications.js"></script>
}