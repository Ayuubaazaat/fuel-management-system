@model FuelManagement.Models.CompensationListItemViewModel
@{
    ViewData["Title"] = "Compensation Details";
}

<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-900 dark:to-gray-800 py-4 sm:py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="mb-6 sm:mb-8 animate-slideIn">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white">Compensation Details</h1>
                    <p class="text-sm sm:text-base mt-2 text-gray-600 dark:text-gray-400">Complete information for @Model.EmployeeName</p>
                </div>
                <span class="px-3 sm:px-4 py-1.5 sm:py-2 rounded-full text-xs sm:text-sm font-semibold @Model.StatusColor dark:opacity-90 self-start sm:self-auto">
                    <svg class="w-3 h-3 sm:w-4 sm:h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@Model.StatusIcon"></path>
                    </svg>
                    @Model.Status
                </span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 animate-fadeIn">

            <!-- Employee Info Card -->
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg dark:shadow-gray-900/30 p-4 sm:p-6 card-hover border border-gray-100 dark:border-gray-700">
                <div class="flex items-center mb-3 sm:mb-4">
                    <div class="w-8 h-8 sm:w-10 sm:h-10 bg-green-100 dark:bg-green-900/50 rounded-lg flex items-center justify-center">
                        <svg class="w-4 h-4 sm:w-5 sm:h-5 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                    </div>
                    <h2 class="ml-2 sm:ml-3 text-base sm:text-lg font-semibold text-gray-900 dark:text-white">Employee Information</h2>
                </div>
                <div class="space-y-2 sm:space-y-3">
                    <div class="flex flex-col sm:flex-row sm:justify-between py-2 border-b border-gray-100 dark:border-gray-700">
                        <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-400">Employee ID:</span>
                        <span class="text-xs sm:text-sm font-semibold text-gray-900 dark:text-white">@Model.EmployeeId</span>
                    </div>
                    <div class="flex flex-col sm:flex-row sm:justify-between py-2 border-b border-gray-100 dark:border-gray-700">
                        <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-400">Employee Name:</span>
                        <span class="text-xs sm:text-sm font-semibold text-gray-900 dark:text-white">@Model.EmployeeName</span>
                    </div>
                    <div class="flex flex-col sm:flex-row sm:justify-between py-2 border-b border-gray-100 dark:border-gray-700">
                        <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-400">Phone Number:</span>
                        <span class="text-xs sm:text-sm font-semibold text-gray-900 dark:text-white flex items-center gap-1.5">
                            <i class="fas fa-phone text-emerald-500 text-xs"></i>
                            @(string.IsNullOrEmpty(Model.PhoneNumber) ? "—" : Model.PhoneNumber)
                        </span>
                    </div>
                    <div class="flex flex-col sm:flex-row sm:justify-between py-2 border-b border-gray-100 dark:border-gray-700">
                        <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-400">Position:</span>
                        <span class="text-xs sm:text-sm font-semibold text-gray-900 dark:text-white">@Model.Position</span>
                    </div>
                    <div class="flex flex-col sm:flex-row sm:justify-between py-2 border-b border-gray-100 dark:border-gray-700">
                        <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-400">Department:</span>
                        <span class="text-xs sm:text-sm font-semibold text-gray-900 dark:text-white">@Model.Department</span>
                    </div>
                </div>
            </div>

            <!-- Payment Info Card -->
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg dark:shadow-gray-900/30 p-4 sm:p-6 card-hover border border-gray-100 dark:border-gray-700">
                <div class="flex items-center mb-3 sm:mb-4">
                    <div class="w-8 h-8 sm:w-10 sm:h-10 bg-emerald-100 dark:bg-emerald-900/50 rounded-lg flex items-center justify-center">
                        <svg class="w-4 h-4 sm:w-5 sm:h-5 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
                        </svg>
                    </div>
                    <h2 class="ml-2 sm:ml-3 text-base sm:text-lg font-semibold text-gray-900 dark:text-white">Payment Information</h2>
                </div>
                <div class="space-y-2 sm:space-y-3">
                    <div class="flex flex-col sm:flex-row sm:justify-between py-2 border-b border-gray-100 dark:border-gray-700">
                        <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-400">Payment Date:</span>
                        <span class="text-xs sm:text-sm font-semibold text-gray-900 dark:text-white">@Model.FormattedPaymentDate</span>
                    </div>
                    <div class="flex flex-col sm:flex-row sm:justify-between py-2 border-b border-gray-100 dark:border-gray-700">
                        <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-400">Payment Method:</span>
                        <span class="text-xs sm:text-sm font-semibold text-gray-900 dark:text-white">@Model.PaymentMethod</span>
                    </div>
                    <div class="flex flex-col sm:flex-row sm:justify-between py-2 border-b border-gray-100 dark:border-gray-700">
                        <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-400">Days Until Payment:</span>
                        <span class="text-xs sm:text-sm font-semibold @(Model.DaysUntilPayment < 0 ? "text-red-600 dark:text-red-400" : Model.DaysUntilPayment < 3 ? "text-yellow-600 dark:text-yellow-400" : "text-green-600 dark:text-green-400")">
                            @(Model.DaysUntilPayment < 0 ? $"{Math.Abs(Model.DaysUntilPayment)} days overdue" : Model.DaysUntilPayment == 0 ? "Today" : $"{Model.DaysUntilPayment} days")
                        </span>
                    </div>
                </div>
            </div>

            <!-- Salary Breakdown Card -->
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg dark:shadow-gray-900/30 p-4 sm:p-6 md:col-span-2 card-hover border border-gray-100 dark:border-gray-700">
                <div class="flex items-center mb-3 sm:mb-4">
                    <div class="w-8 h-8 sm:w-10 sm:h-10 bg-teal-100 dark:bg-teal-900/50 rounded-lg flex items-center justify-center">
                        <svg class="w-4 h-4 sm:w-5 sm:h-5 text-teal-600 dark:text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <h2 class="ml-2 sm:ml-3 text-base sm:text-lg font-semibold text-gray-900 dark:text-white">Salary Breakdown</h2>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-6">
                    <div class="bg-green-50 dark:bg-green-900/30 rounded-xl p-3 sm:p-4 text-center">
                        <span class="text-xs sm:text-sm text-green-600 dark:text-green-400 font-medium">Base Salary</span>
                        <p class="text-lg sm:text-2xl font-bold text-green-700 dark:text-green-300 mt-1">@Model.FormattedBaseSalary</p>
                    </div>
                    <div class="bg-blue-50 dark:bg-blue-900/30 rounded-xl p-3 sm:p-4 text-center">
                        <span class="text-xs sm:text-sm text-blue-600 dark:text-blue-400 font-medium">Bonus</span>
                        <p class="text-lg sm:text-2xl font-bold text-blue-700 dark:text-blue-300 mt-1">+@Model.FormattedBonus</p>
                    </div>
                    <div class="bg-orange-50 dark:bg-orange-900/30 rounded-xl p-3 sm:p-4 text-center">
                        <span class="text-xs sm:text-sm text-orange-600 dark:text-orange-400 font-medium">Deductions</span>
                        <p class="text-lg sm:text-2xl font-bold text-orange-700 dark:text-orange-300 mt-1">-@Model.FormattedDeductions</p>
                    </div>
                </div>
                <div class="mt-4 sm:mt-6 pt-3 sm:pt-4 border-t border-gray-200 dark:border-gray-700">
                    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-2">
                        <span class="text-base sm:text-lg font-semibold text-gray-900 dark:text-white">Net Salary</span>
                        <span class="text-2xl sm:text-3xl font-bold text-green-600 dark:text-green-400">@Model.FormattedNetSalary</span>
                    </div>
                </div>
            </div>

            <!-- Notes Card -->
            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg dark:shadow-gray-900/30 p-4 sm:p-6 md:col-span-2 card-hover border border-gray-100 dark:border-gray-700">
                    <div class="flex items-center mb-3 sm:mb-4">
                        <div class="w-8 h-8 sm:w-10 sm:h-10 bg-gray-100 dark:bg-gray-700 rounded-lg flex items-center justify-center">
                            <svg class="w-4 h-4 sm:w-5 sm:h-5 text-gray-600 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path>
                            </svg>
                        </div>
                        <h2 class="ml-2 sm:ml-3 text-base sm:text-lg font-semibold text-gray-900 dark:text-white">Notes</h2>
                    </div>
                    <p class="text-xs sm:text-sm text-gray-700 dark:text-gray-300">@Model.Notes</p>
                </div>
            }
        </div>

        <!-- Actions -->
        <div class="mt-6 sm:mt-8 flex flex-col sm:flex-row gap-3 animate-fadeIn">
            <a href="@Url.Action("Edit", new { id = Model.Id })"
               class="w-full sm:w-auto px-4 sm:px-6 py-2.5 bg-gradient-to-r from-green-500 to-emerald-600 dark:from-green-600 dark:to-emerald-600 text-white font-medium rounded-lg hover:from-green-600 dark:hover:from-green-700 hover:to-emerald-700 dark:hover:to-emerald-700 transform hover:scale-105 transition-all duration-200 shadow-lg hover:shadow-xl text-center">
                Edit Compensation
            </a>
            <a href="@Url.Action("Index")"
               class="w-full sm:w-auto px-4 sm:px-6 py-2.5 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-700 dark:text-gray-300 font-medium hover:bg-gray-50 dark:hover:bg-gray-700 transition-all duration-200 text-center">
                Back to List
            </a>
        </div>
    </div>
</div>

<style>
    .card-hover {
        transition: all 0.3s ease;
    }

        .card-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px -5px rgba(16,185,129,0.1), 0 10px 10px -5px rgba(16,185,129,0.04);
        }

    .dark .card-hover:hover {
        box-shadow: 0 20px 25px -5px rgba(16,185,129,0.2), 0 10px 10px -5px rgba(16,185,129,0.1);
    }

    .animate-slideIn {
        animation: slideIn 0.6s ease-out;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateX(-20px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .animate-fadeIn {
        animation: fadeIn 0.6s ease-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>