@model IEnumerable<FuelManagement.Models.CompensationListItemViewModel>

@{
    var currentPage = ViewBag.PageNumber ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var totalCount = ViewBag.TotalCount ?? 0;
    var pageSize = ViewBag.PageSize ?? 10;
    var startItem = ((currentPage - 1) * pageSize) + 1;
    var endItem = Math.Min(currentPage * pageSize, totalCount);
    var hasRecords = Model != null && Model.Any();
}

<div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg dark:shadow-gray-900/30 overflow-hidden border border-gray-100 dark:border-gray-700">
    <div class="overflow-x-auto">
        <table class="min-w-[1500px] sm:min-w-full divide-y divide-gray-200 dark:divide-gray-700">
            <thead class="bg-gradient-to-r from-green-50 to-emerald-50 dark:from-gray-700 dark:to-gray-800">
                <tr>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-emerald-800 dark:text-emerald-300 uppercase tracking-wider">ID</th>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-emerald-800 dark:text-emerald-300 uppercase tracking-wider">Employee</th>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-emerald-800 dark:text-emerald-300 uppercase tracking-wider">Phone</th>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-emerald-800 dark:text-emerald-300 uppercase tracking-wider">Position</th>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-emerald-800 dark:text-emerald-300 uppercase tracking-wider">Base Salary</th>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-emerald-800 dark:text-emerald-300 uppercase tracking-wider">Payment Method</th>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-emerald-800 dark:text-emerald-300 uppercase tracking-wider">Bonus</th>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-emerald-800 dark:text-emerald-300 uppercase tracking-wider">Deductions</th>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-emerald-800 dark:text-emerald-300 uppercase tracking-wider">Net Salary</th>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-emerald-800 dark:text-emerald-300 uppercase tracking-wider">Payment Date</th>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-left text-xs font-medium text-emerald-800 dark:text-emerald-300 uppercase tracking-wider">Status</th>
                    <th scope="col" class="px-3 sm:px-6 py-3 sm:py-4 text-right text-xs font-medium text-emerald-800 dark:text-emerald-300 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
                @if (hasRecords)
                {
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-emerald-50/30 dark:hover:bg-gray-700/50 transition-colors duration-200 group">
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="text-xs sm:text-sm font-medium text-emerald-600 dark:text-emerald-400">@item.EmployeeId</div>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="text-xs sm:text-sm font-medium text-gray-900 dark:text-white">@item.EmployeeName</div>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="flex items-center gap-1.5 text-xs sm:text-sm text-gray-700 dark:text-gray-300">
                                    <i class="fas fa-phone text-emerald-400 text-xs"></i>
                                    @(string.IsNullOrEmpty(item.PhoneNumber) ? "—" : item.PhoneNumber)
                                </div>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="text-xs sm:text-sm text-gray-900 dark:text-white">@item.Position</div>
                                <div class="text-xs text-gray-500 dark:text-gray-400">@item.Department</div>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="text-xs sm:text-sm font-medium text-gray-900 dark:text-white">@item.FormattedBaseSalary</div>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="text-xs sm:text-sm font-medium text-purple-600 dark:text-purple-400">@item.PaymentMethod</div>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="text-xs sm:text-sm text-green-600 dark:text-green-400 font-medium">+@item.FormattedBonus</div>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="text-xs sm:text-sm text-red-600 dark:text-red-400 font-medium">-@item.FormattedDeductions</div>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="text-xs sm:text-sm font-bold text-emerald-600 dark:text-emerald-400">@item.FormattedNetSalary</div>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <div class="text-xs sm:text-sm text-gray-900 dark:text-white">@item.FormattedPaymentDate</div>
                                @if (item.DaysUntilPayment < 0)
                                {
                                    <span class="text-xs text-red-600 dark:text-red-400">@Math.Abs(item.DaysUntilPayment) days overdue</span>
                                }
                                else if (item.DaysUntilPayment == 0)
                                {
                                    <span class="text-xs text-green-600 dark:text-green-400">Today</span>
                                }
                                else if (item.DaysUntilPayment < 3)
                                {
                                    <span class="text-xs text-yellow-600 dark:text-yellow-400">in @item.DaysUntilPayment days</span>
                                }
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                <span class="px-2 sm:px-3 py-1 rounded-full text-xs font-medium @item.StatusColor dark:opacity-90">
                                    <svg class="w-2 h-2 sm:w-3 sm:h-3 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@item.StatusIcon"></path>
                                    </svg>
                                    @item.Status
                                </span>
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap text-right text-xs sm:text-sm font-medium">
                                <div class="flex items-center justify-end space-x-1 sm:space-x-2 opacity-100 sm:opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                                    <a href="@Url.Action("Details", new { id = item.Id })"
                                       class="p-1.5 sm:p-2 text-blue-600 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-900/30 rounded-lg transition-colors duration-200" title="View">
                                        <svg class="w-3 h-3 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                        </svg>
                                    </a>
                                    <a href="@Url.Action("Edit", new { id = item.Id })"
                                       class="p-1.5 sm:p-2 text-amber-600 dark:text-amber-400 hover:bg-amber-50 dark:hover:bg-amber-900/30 rounded-lg transition-colors duration-200" title="Edit">
                                        <svg class="w-3 h-3 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                        </svg>
                                    </a>
                                    <button type="button"
                                            onclick="openDeleteModal(@item.Id, '@item.EmployeeName')"
                                            class="p-1.5 sm:p-2 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/30 rounded-lg transition-colors duration-200" title="Delete">
                                        <svg class="w-3 h-3 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="12" class="px-3 sm:px-6 py-12 sm:py-16 text-center">
                            <div class="flex flex-col items-center justify-center">
                                <div class="w-20 h-20 sm:w-24 sm:h-24 bg-emerald-50 dark:bg-emerald-900/30 rounded-full flex items-center justify-center mb-4">
                                    <svg class="w-10 h-10 sm:w-12 sm:h-12 text-emerald-400 dark:text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                </div>
                                <h3 class="text-lg sm:text-xl font-semibold text-gray-900 dark:text-white mb-2">No compensations found</h3>
                                <p class="text-sm sm:text-base text-gray-500 dark:text-gray-400 mb-6">Get started by adding a new compensation record.</p>
                                <a href="@Url.Action("Create")"
                                   class="inline-flex items-center px-4 sm:px-6 py-2.5 sm:py-3 bg-gradient-to-r from-green-500 to-emerald-600 dark:from-green-600 dark:to-emerald-600 text-white font-medium rounded-xl hover:from-green-600 dark:hover:from-green-700 hover:to-emerald-700 dark:hover:to-emerald-700 transform hover:scale-105 transition-all duration-200 shadow-lg hover:shadow-xl text-sm sm:text-base">
                                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                                    </svg>
                                    Add Compensation
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (hasRecords)
    {
        <div class="bg-white dark:bg-gray-800 px-4 sm:px-6 py-3 sm:py-4 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-gray-200 dark:border-gray-700">
            <div class="text-sm text-gray-700 dark:text-gray-300 order-2 sm:order-1">
                Showing <span class="font-medium text-gray-900 dark:text-white">@startItem</span> to
                <span class="font-medium text-gray-900 dark:text-white">@endItem</span> of
                <span class="font-medium text-gray-900 dark:text-white">@totalCount</span> results
            </div>
            <div class="order-1 sm:order-2">
                <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                    <a href="@Url.Action("Index", new { page = currentPage - 1, StartDate = Context.Request.Query["StartDate"].ToString(), EndDate = Context.Request.Query["EndDate"].ToString(), EmployeeId = Context.Request.Query["EmployeeId"].ToString(), Department = Context.Request.Query["Department"].ToString(), Status = Context.Request.Query["Status"].ToString() })"
                       class="relative inline-flex items-center px-2 sm:px-3 py-2 rounded-l-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-xs sm:text-sm font-medium @(currentPage > 1 ? "text-gray-500 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-600" : "text-gray-300 dark:text-gray-500 cursor-not-allowed pointer-events-none")">
                        <span class="sr-only">Previous</span>
                        <svg class="h-4 w-4 sm:h-5 sm:w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                        </svg>
                    </a>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <a href="@Url.Action("Index", new { page = i, StartDate = Context.Request.Query["StartDate"].ToString(), EndDate = Context.Request.Query["EndDate"].ToString(), EmployeeId = Context.Request.Query["EmployeeId"].ToString(), Department = Context.Request.Query["Department"].ToString(), Status = Context.Request.Query["Status"].ToString() })"
                           class="relative inline-flex items-center px-3 sm:px-4 py-2 border border-gray-300 dark:border-gray-600 text-xs sm:text-sm font-medium @(i == currentPage ? "bg-emerald-50 dark:bg-emerald-900/50 text-emerald-600 dark:text-emerald-400" : "bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-600")">
                            @i
                        </a>
                    }
                    <a href="@Url.Action("Index", new { page = currentPage + 1, StartDate = Context.Request.Query["StartDate"].ToString(), EndDate = Context.Request.Query["EndDate"].ToString(), EmployeeId = Context.Request.Query["EmployeeId"].ToString(), Department = Context.Request.Query["Department"].ToString(), Status = Context.Request.Query["Status"].ToString() })"
                       class="relative inline-flex items-center px-2 sm:px-3 py-2 rounded-r-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-xs sm:text-sm font-medium @(currentPage < totalPages ? "text-gray-500 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-600" : "text-gray-300 dark:text-gray-500 cursor-not-allowed pointer-events-none")">
                        <span class="sr-only">Next</span>
                        <svg class="h-4 w-4 sm:h-5 sm:w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                        </svg>
                    </a>
                </nav>
            </div>
        </div>
    }
</div>