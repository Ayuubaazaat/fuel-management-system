@model FuelManagement.Models.CompensationViewModel

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
    <!-- Total Payroll Card -->
    <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl shadow-lg dark:shadow-gray-900/30 p-4 sm:p-6 card-hover animate-fadeIn border border-green-100 dark:border-green-900/30" style="animation-delay: 0.1s;">
        <div class="flex items-center justify-between mb-3 sm:mb-4">
            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-green-100 dark:bg-green-900/50 rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
            </div>
            <span class="text-xs sm:text-sm font-semibold text-green-500 dark:text-green-400 bg-green-50 dark:bg-green-900/30 px-2 sm:px-2.5 py-1 rounded-full">@Model.CompensationItems.Count employees</span>
        </div>
        <h3 class="text-gray-500 dark:text-gray-400 text-xs sm:text-sm mb-1">Total Payroll</h3>
        <p class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">@Model.TotalPayroll.ToString("C")</p>
        <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-500 mt-2">This month</p>
    </div>

    <!-- Paid Card -->
    <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl shadow-lg dark:shadow-gray-900/30 p-4 sm:p-6 card-hover animate-fadeIn border border-green-100 dark:border-green-900/30" style="animation-delay: 0.2s;">
        <div class="flex items-center justify-between mb-3 sm:mb-4">
            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-emerald-100 dark:bg-emerald-900/50 rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
            </div>
            <span class="text-xs sm:text-sm font-semibold text-emerald-500 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-900/30 px-2 sm:px-2.5 py-1 rounded-full">@Model.PaidCount paid</span>
        </div>
        <h3 class="text-gray-500 dark:text-gray-400 text-xs sm:text-sm mb-1">Paid</h3>
        <p class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">@Model.TotalPaid.ToString("C")</p>
        <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-500 mt-2">@Model.PaidCount employees</p>
    </div>

    <!-- Pending Card -->
    <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl shadow-lg dark:shadow-gray-900/30 p-4 sm:p-6 card-hover animate-fadeIn border border-green-100 dark:border-green-900/30" style="animation-delay: 0.3s;">
        <div class="flex items-center justify-between mb-3 sm:mb-4">
            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-yellow-100 dark:bg-yellow-900/50 rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
            </div>
            <span class="text-xs sm:text-sm font-semibold text-yellow-500 dark:text-yellow-400 bg-yellow-50 dark:bg-yellow-900/30 px-2 sm:px-2.5 py-1 rounded-full">@Model.PendingCount pending</span>
        </div>
        <h3 class="text-gray-500 dark:text-gray-400 text-xs sm:text-sm mb-1">Pending</h3>
        <p class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">@Model.TotalPending.ToString("C")</p>
        <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-500 mt-2">Awaiting processing</p>
    </div>

    <!-- Overdue Card -->
    <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl shadow-lg dark:shadow-gray-900/30 p-4 sm:p-6 card-hover animate-fadeIn border border-green-100 dark:border-green-900/30" style="animation-delay: 0.4s;">
        <div class="flex items-center justify-between mb-3 sm:mb-4">
            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-red-100 dark:bg-red-900/50 rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
            </div>
            <span class="text-xs sm:text-sm font-semibold text-red-500 dark:text-red-400 bg-red-50 dark:bg-red-900/30 px-2 sm:px-2.5 py-1 rounded-full">@Model.OverdueCount overdue</span>
        </div>
        <h3 class="text-gray-500 dark:text-gray-400 text-xs sm:text-sm mb-1">Overdue</h3>
        <p class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">@Model.TotalOverdue.ToString("C")</p>
        <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-500 mt-2">Requires attention</p>
    </div>
</div>

<style>
    .card-hover {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .card-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px -5px rgba(16, 185, 129, 0.1), 0 10px 10px -5px rgba(16, 185, 129, 0.04);
        }

    .dark .card-hover:hover {
        box-shadow: 0 20px 25px -5px rgba(16, 185, 129, 0.2), 0 10px 10px -5px rgba(16, 185, 129, 0.1);
    }

    .animate-fadeIn {
        animation: fadeIn 0.6s ease-out forwards;
        opacity: 0;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>