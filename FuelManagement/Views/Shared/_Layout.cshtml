    <!-- Combined Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {

            // ========== MOBILE SIDEBAR ==========
            const sidebar = document.getElementById('sidebar');
            const mobileMenuBtn = document.getElementById('mobileMenuBtn');
            const closeSidebarBtn = document.getElementById('closeSidebarBtn');

            function openSidebar() {
                sidebar.classList.remove('-translate-x-full');
            }

            function closeSidebar() {
                sidebar.classList.add('-translate-x-full');
            }

            if (mobileMenuBtn) {
                mobileMenuBtn.addEventListener('click', openSidebar);
            }

            if (closeSidebarBtn) {
                closeSidebarBtn.addEventListener('click', closeSidebar);
            }

            document.addEventListener('click', (event) => {
                if (window.innerWidth < 768) {
                    if (sidebar && !sidebar.contains(event.target) && !mobileMenuBtn?.contains(event.target)) {
                        closeSidebar();
                    }
                }
            });

            window.addEventListener('resize', () => {
                if (window.innerWidth >= 768) {
                    sidebar.classList.remove('-translate-x-full');
                } else {
                    sidebar.classList.add('-translate-x-full');
                }
            });

            // ========== MOBILE SEARCH FUNCTIONALITY ==========
            const mobileSearchToggle = document.getElementById('mobileSearchToggle');
            const mobileSearchForm   = document.getElementById('mobileSearchForm');

            window.toggleMobileSearch = function() {
                if (mobileSearchForm) {
                    mobileSearchForm.classList.toggle('hidden');
                    if (!mobileSearchForm.classList.contains('hidden')) {
                        setTimeout(function() {
                            const input = mobileSearchForm.querySelector('input');
                            if (input) input.focus();
                        }, 100);
                    }
                }
            };

            document.addEventListener('click', function(event) {
                const searchContainer = document.getElementById('mobileSearchToggle')?.parentElement;
                if (searchContainer && mobileSearchForm &&
                    !searchContainer.contains(event.target) &&
                    !mobileSearchForm.contains(event.target) &&
                    !mobileSearchForm.classList.contains('hidden')) {
                    mobileSearchForm.classList.add('hidden');
                }
            });

            // ========== MOBILE PROFILE DROPDOWN ==========
            const mobileProfileBtn  = document.getElementById('mobileProfileBtn');
            const mobileProfileMenu = document.getElementById('mobileProfileMenu');

            if (mobileProfileBtn && mobileProfileMenu) {
                mobileProfileBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    mobileProfileMenu.classList.toggle('hidden');
                });

                document.addEventListener('click', function(e) {
                    if (mobileProfileBtn && mobileProfileMenu &&
                        !mobileProfileBtn.contains(e.target) &&
                        !mobileProfileMenu.contains(e.target)) {
                        mobileProfileMenu.classList.add('hidden');
                    }
                });
            }

            // ========== PROFILE DROPDOWN ==========
            const profileButton  = document.getElementById('profileButton');
            const profileMenu    = document.getElementById('profileMenu');
            const profileChevron = document.getElementById('profileChevron');

            if (profileButton && profileMenu) {
                profileButton.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const isHidden = profileMenu.classList.contains('hidden');
                    if (isHidden) {
                        profileMenu.classList.remove('hidden');
                        if (profileChevron) profileChevron.style.transform = 'rotate(180deg)';
                    } else {
                        profileMenu.classList.add('hidden');
                        if (profileChevron) profileChevron.style.transform = 'rotate(0deg)';
                    }
                });

                document.addEventListener('click', (e) => {
                    if (profileButton && profileMenu &&
                        !profileButton.contains(e.target) &&
                        !profileMenu.contains(e.target)) {
                        profileMenu.classList.add('hidden');
                        if (profileChevron) profileChevron.style.transform = 'rotate(0deg)';
                    }
                });
            }

            // ========== THEME SYNC ==========
            // site.js already handles the toggle click — just sync icons here

            function updateThemeIcons(isDark) {
                const themeIcon       = document.getElementById('themeIcon');
                const themeIconMobile = document.getElementById('themeIconMobile');

                if (themeIcon) {
                    themeIcon.className = isDark
                        ? 'fas fa-sun text-gray-600 dark:text-gray-300 text-base sm:text-lg'
                        : 'fas fa-moon text-gray-600 dark:text-gray-300 text-base sm:text-lg';
                }
                if (themeIconMobile) {
                    themeIconMobile.className = isDark
                        ? 'fas fa-sun text-white text-sm'
                        : 'fas fa-moon text-white text-sm';
                }
            }

            updateThemeIcons(document.documentElement.classList.contains('dark'));

            window.addEventListener('themeChanged', (e) => {
                updateThemeIcons(e.detail.theme === 'dark');
            });
        // ========== MOBILE NOTIFICATION HANDLER ==========
        // Handled by notifications.js

        }); // ← single closing of DOMContentLoaded

        // ========== AVATAR ==========
        async function updateAvatarFromProfile() {
            try {
                const response = await fetch('/Profile/GetCurrentUserAvatar');
                const data     = await response.json();

                if (data.success) {
                    const desktopImg      = document.getElementById('desktopAvatarImg');
                    const desktopInitials = document.getElementById('desktopAvatarInitials');
                    const mobileImg       = document.getElementById('mobileAvatarImg');
                    const mobileInitials  = document.getElementById('mobileAvatarInitials');

                    if (data.hasAvatar) {
                        const url = data.avatarUrl + '?t=' + new Date().getTime();
                        if (desktopImg)      { desktopImg.src = url; desktopImg.style.display = 'block'; }
                        if (desktopInitials)   desktopInitials.style.display = 'none';
                        if (mobileImg)       { mobileImg.src = url; mobileImg.classList.remove('hidden'); mobileImg.style.display = 'block'; }
                        if (mobileInitials)    mobileInitials.style.display = 'none';
                    } else {
                        if (desktopInitials) { desktopInitials.textContent = data.initials; desktopInitials.style.display = 'flex'; }
                        if (desktopImg)        desktopImg.style.display = 'none';
                        if (mobileInitials)  { mobileInitials.textContent = data.initials; mobileInitials.style.display = 'flex'; }
                        if (mobileImg)         mobileImg.style.display = 'none';
                    }
                }
            } catch (error) {
                console.error('Error loading avatar:', error);
            }
        }

        document.addEventListener('DOMContentLoaded', updateAvatarFromProfile);
        window.addEventListener('avatarUpdated', updateAvatarFromProfile);
    </script>

    <!-- Include site.js -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
    <script src="~/js/desktop-notifications.js" asp-append-version="true"></script>
    <script src="~/js/mobile-notifications.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
</body>
</html>