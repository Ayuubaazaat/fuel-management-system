@model FuelManagement.Models.InvoiceDetailsViewModel
@{
    ViewData["Title"] = "Invoice Details";
}

<div class="min-h-screen bg-gradient-to-br from-amber-50 to-stone-50 dark:from-gray-900 dark:to-gray-800 py-4 sm:py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="mb-6 sm:mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 animate-slideIn">
            <div>
                <h1 class="text-2xl sm:text-3xl font-bold text-stone-800 dark:text-amber-100">Invoice Details</h1>
                <p class="text-sm sm:text-base mt-2 text-stone-600 dark:text-amber-200">View and print invoice @Model.InvoiceNumber</p>
            </div>
            <div class="flex flex-col sm:flex-row gap-2 sm:space-x-3">
                <button onclick="window.print()"
                        class="w-full sm:w-auto px-3 sm:px-4 py-2 bg-white dark:bg-gray-700 border border-amber-300 dark:border-amber-700 rounded-lg text-stone-700 dark:text-amber-200 text-sm font-medium hover:bg-amber-50 dark:hover:bg-gray-600 transition-all duration-200">
                    <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
                    </svg>
                    <span class="hidden sm:inline">Print</span>
                </button>
                <a href="@Url.Action("Edit", new { id = Model.InvoiceNumber })"
                   class="w-full sm:w-auto px-3 sm:px-4 py-2 bg-gradient-to-r from-amber-800 to-stone-900 dark:from-amber-700 dark:to-stone-800 text-amber-100 dark:text-amber-100 text-sm font-medium rounded-lg hover:from-amber-900 dark:hover:from-amber-800 hover:to-stone-950 dark:hover:to-stone-900 transition-all duration-200 text-center">
                    <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                    </svg>
                    <span class="hidden sm:inline">Edit</span>
                </a>
            </div>
        </div>

        <!-- Invoice Printable -->
        @await Html.PartialAsync("Partials/_InvoicePrintable", Model)

        <!-- Related Receipts Section -->
        @if (Model.RelatedReceipts != null && Model.RelatedReceipts.Any())
        {
            <div class="mt-8 bg-white dark:bg-gray-800 rounded-2xl shadow-lg overflow-hidden border border-amber-200 dark:border-amber-800 animate-fadeIn">
                <div class="bg-gradient-to-r from-amber-800 to-stone-900 dark:from-amber-700 dark:to-stone-800 px-4 sm:px-6 py-3 sm:py-4">
                    <h2 class="text-base sm:text-lg font-semibold text-white">Related Receipts</h2>
                </div>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-amber-200 dark:divide-amber-800">
                        <thead class="bg-amber-50 dark:bg-gray-700">
                            <tr>
                                <th class="px-4 sm:px-6 py-3 text-left text-xs font-medium text-stone-600 dark:text-amber-200 uppercase tracking-wider">Receipt No</th>
                                <th class="px-4 sm:px-6 py-3 text-left text-xs font-medium text-stone-600 dark:text-amber-200 uppercase tracking-wider">Date</th>
                                <th class="px-4 sm:px-6 py-3 text-left text-xs font-medium text-stone-600 dark:text-amber-200 uppercase tracking-wider">Amount</th>
                                <th class="px-4 sm:px-6 py-3 text-left text-xs font-medium text-stone-600 dark:text-amber-200 uppercase tracking-wider">Payment Method</th>
                                <th class="px-4 sm:px-6 py-3 text-left text-xs font-medium text-stone-600 dark:text-amber-200 uppercase tracking-wider">Status</th>
                                <th class="px-4 sm:px-6 py-3 text-right text-xs font-medium text-stone-600 dark:text-amber-200 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white dark:bg-gray-800 divide-y divide-amber-100 dark:divide-amber-900">
                            @foreach (var receipt in Model.RelatedReceipts)
                            {
                                <tr class="hover:bg-amber-50/50 dark:hover:bg-gray-700/50 transition-colors duration-200">
                                    <td class="px-4 sm:px-6 py-3 whitespace-nowrap">
                                        <span class="text-sm font-mono text-stone-900 dark:text-amber-100">@receipt.ReceiptNo</span>
                                    </td>
                                    <td class="px-4 sm:px-6 py-3 whitespace-nowrap">
                                        <span class="text-sm text-stone-600 dark:text-amber-200">@receipt.PaymentDate.ToString("MMM dd, yyyy")</span>
                                    </td>
                                    <td class="px-4 sm:px-6 py-3 whitespace-nowrap">
                                        <span class="text-sm font-semibold text-stone-900 dark:text-amber-100">@receipt.FormattedTotalAmount</span>
                                    </td>
                                    <td class="px-4 sm:px-6 py-3 whitespace-nowrap">
                                        <span class="text-sm text-stone-600 dark:text-amber-200">@receipt.PaymentMethod</span>
                                    </td>
                                    <td class="px-4 sm:px-6 py-3 whitespace-nowrap">
                                        <span class="px-2 py-1 rounded-full text-xs font-medium @receipt.StatusColor">
                                            @receipt.PaymentStatus
                                        </span>
                                    </td>
                                    <td class="px-4 sm:px-6 py-3 whitespace-nowrap text-right">
                                        <a href="@Url.Action("Details", "Receipts", new { id = receipt.Id })"
                                           class="text-amber-600 hover:text-amber-800 dark:text-amber-400 dark:hover:text-amber-300 text-sm font-medium">
                                            View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- Actions -->
        <div class="mt-6 sm:mt-8 flex justify-center sm:justify-start animate-fadeIn">
            <a href="@Url.Action("Index")"
               class="w-full sm:w-auto px-4 sm:px-6 py-2.5 border border-amber-300 dark:border-amber-700 rounded-lg text-stone-700 dark:text-amber-200 text-sm font-medium hover:bg-amber-50 dark:hover:bg-gray-700 transition-all duration-200 text-center">
                Back to List
            </a>
        </div>
    </div>
</div>

<style>
    .card-hover {
        transition: all 0.3s ease;
    }

        .card-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px -5px rgba(180, 83, 9, 0.1), 0 10px 10px -5px rgba(180, 83, 9, 0.04);
        }

    .dark .card-hover:hover {
        box-shadow: 0 20px 25px -5px rgba(245, 158, 11, 0.2), 0 10px 10px -5px rgba(245, 158, 11, 0.1);
    }

    .animate-slideIn {
        animation: slideIn 0.6s ease-out;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateX(-20px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .animate-fadeIn {
        animation: fadeIn 0.6s ease-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Print styles */
    @@media print {
        body * {
            visibility: hidden;
        }

        #invoice-print, #invoice-print * {
            visibility: visible;
        }

        #invoice-print {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
        }

        .no-print {
            display: none;
        }
    }
</style>