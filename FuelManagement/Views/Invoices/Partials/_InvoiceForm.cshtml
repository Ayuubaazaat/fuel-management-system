<script>
    // Calculate invoice totals
    document.addEventListener('DOMContentLoaded', function() {
        const litersInput = document.getElementById('TotalLiters');
        const priceInput = document.getElementById('UnitPrice');
        const amountPaidInput = document.getElementById('AmountPaid');
        const subtotalSpan = document.getElementById('subtotalPreview');
        const vatSpan = document.getElementById('vatPreview');
        const totalSpan = document.getElementById('totalPreview');
        const balanceSpan = document.getElementById('balancePreview');
        const vatRate = 0.05; // 5% Somali VAT

        function updateTotals() {
            const liters = parseFloat(litersInput?.value) || 0;
            const price = parseFloat(priceInput?.value) || 0;
            const amountPaid = parseFloat(amountPaidInput?.value) || 0;

            const subtotal = liters * price;
            const vat = subtotal * vatRate;
            const total = subtotal + vat;
            const balance = total - amountPaid;

            if (subtotalSpan) {
                subtotalSpan.textContent = subtotal.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
            }
            if (vatSpan) {
                vatSpan.textContent = vat.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
            }
            if (totalSpan) {
                totalSpan.textContent = total.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
            }
            if (balanceSpan) {
                balanceSpan.textContent = balance.toLocaleString('en-US', { style: 'currency', currency: 'USD' });

                // Update color based on balance
                if (balance === 0) {
                    balanceSpan.className = 'text-sm sm:text-lg font-semibold text-green-600 dark:text-green-400';
                } else if (balance > 0) {
                    balanceSpan.className = 'text-sm sm:text-lg font-semibold text-red-600 dark:text-red-400';
                }
            }
        }

        if (litersInput && priceInput) {
            litersInput.addEventListener('input', updateTotals);
            priceInput.addEventListener('input', updateTotals);
            if (amountPaidInput) {
                amountPaidInput.addEventListener('input', updateTotals);
            }
            updateTotals(); // Initial calculation
        }
    });
</script>

