@using FuelManagement.Models
@model object

@{
    var isEdit = ViewData["IsEdit"] != null && (bool)ViewData["IsEdit"];

    InvoiceCreateViewModel? createModel = null;
    InvoiceEditViewModel? editModel = null;

    // Safely cast the model with null checks
    if (Model != null)
    {
        if (Model is InvoiceCreateViewModel cm)
        {
            createModel = cm;
        }
        else if (Model is InvoiceEditViewModel em)
        {
            editModel = em;
        }
    }
}

@if (!isEdit && createModel != null)
{
    <div class="space-y-4 sm:space-y-6">
        <!-- Invoice ID and Invoice Number Section -->
        <div class="bg-amber-50 dark:bg-amber-900/30 rounded-xl p-3 sm:p-4 border border-amber-200 dark:border-amber-800 mb-4 sm:mb-6">
            <div class="flex items-center mb-3">
                <svg class="w-4 h-4 sm:w-5 sm:h-5 text-amber-600 dark:text-amber-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"></path>
                </svg>
                <span class="text-xs sm:text-sm text-amber-800 dark:text-amber-300 font-medium">Invoice Information</span>
            </div>

            <!-- Hidden ID field - auto-generated by database -->
            <input type="hidden" id="Id" name="Id" value="0" />

            <div class="grid grid-cols-1 sm:grid-cols-1 gap-4 sm:gap-6">
                <!-- Invoice Number - Full width -->
                <div class="floating-input-group relative">
                    <input type="text"
                           id="InvoiceNumber"
                           name="InvoiceNumber"
                           value="@createModel.InvoiceNumber"
                           required
                           class="peer w-full px-3 sm:px-4 py-2.5 sm:py-3 text-sm rounded-xl border border-amber-200 dark:border-amber-800 bg-white dark:bg-gray-700 text-stone-800 dark:text-amber-100 focus:border-amber-600 dark:focus:border-amber-400 focus:ring-2 focus:ring-amber-200 dark:focus:ring-amber-800 transition-all duration-200 outline-none @(ViewData.ModelState["InvoiceNumber"]?.Errors?.Any() == true ? "border-red-500 dark:border-red-500 focus:border-red-600 dark:focus:border-red-400 focus:ring-red-200 dark:focus:ring-red-800" : "")"
                           placeholder=" " />
                    <label for="InvoiceNumber" class="absolute left-3 sm:left-4 -top-2 sm:-top-2.5 bg-white dark:bg-gray-800 px-1.5 sm:px-2 text-xs sm:text-sm text-stone-600 dark:text-stone-400 transition-all duration-200 peer-placeholder-shown:text-sm peer-placeholder-shown:top-2 sm:peer-placeholder-shown:top-3 peer-placeholder-shown:bg-transparent dark:peer-placeholder-shown:bg-transparent peer-focus:-top-2 sm:peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-amber-600 dark:peer-focus:text-amber-400 peer-focus:bg-white dark:peer-focus:bg-gray-800">
                        Invoice Number (e.g., INV-2024-001) *
                    </label>
                    @if (ViewData.ModelState["InvoiceNumber"]?.Errors?.Any() == true)
                    {
                        <div class="text-red-500 dark:text-red-400 text-xs mt-1">
                            @foreach (var error in ViewData.ModelState["InvoiceNumber"].Errors)
                            {
                                <span>@error.ErrorMessage</span>
                            }
                        </div>
                    }
                    else
                    {
                        @Html.ValidationMessageFor(m => createModel.InvoiceNumber, "", new { @class = "text-red-500 dark:text-red-400 text-xs mt-1" })
                    }
                </div>
            </div>
            <p class="text-xs text-stone-500 dark:text-stone-400 mt-2">Use format: INV-YYYY-XXX (e.g., INV-2024-001)</p>
        </div>

        <!-- Customer Information Section -->
        <div class="border-b border-amber-200 dark:border-amber-800 pb-4">
            <h3 class="text-base sm:text-lg font-semibold text-stone-800 dark:text-amber-100 mb-3 sm:mb-4">Customer Information</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
                <!-- Customer Name -->
                <div class="floating-input-group relative">
                    <input type="text"
                           id="CustomerName"
                           name="CustomerName"
                           value="@createModel.CustomerName"
                           required
                           class="peer w-full px-3 sm:px-4 py-2.5 sm:py-3 text-sm rounded-xl border border-amber-200 dark:border-amber-800 bg-white dark:bg-gray-700 text-stone-800 dark:text-amber-100 focus:border-amber-600 dark:focus:border-amber-400 focus:ring-2 focus:ring-amber-200 dark:focus:ring-amber-800 transition-all duration-200 outline-none @(ViewData.ModelState["CustomerName"]?.Errors?.Any() == true ? "border-red-500 dark:border-red-500 focus:border-red-600 dark:focus:border-red-400 focus:ring-red-200 dark:focus:ring-red-800" : "")"
                           placeholder=" " />
                    <label for="CustomerName" class="absolute left-3 sm:left-4 -top-2 sm:-top-2.5 bg-white dark:bg-gray-800 px-1.5 sm:px-2 text-xs sm:text-sm text-stone-600 dark:text-stone-400 transition-all duration-200 peer-placeholder-shown:text-sm peer-placeholder-shown:top-2 sm:peer-placeholder-shown:top-3 peer-placeholder-shown:bg-transparent dark:peer-placeholder-shown:bg-transparent peer-focus:-top-2 sm:peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-amber-600 dark:peer-focus:text-amber-400 peer-focus:bg-white dark:peer-focus:bg-gray-800">
                        Customer Name *
                    </label>
                    @if (ViewData.ModelState["CustomerName"]?.Errors?.Any() == true)
                    {
                        <div class="text-red-500 dark:text-red-400 text-xs mt-1">
                            @foreach (var error in ViewData.ModelState["CustomerName"].Errors)
                            {
                                <span>@error.ErrorMessage</span>
                            }
                        </div>
                    }
                    else
                    {
                        @Html.ValidationMessageFor(m => createModel.CustomerName, "", new { @class = "text-red-500 dark:text-red-400 text-xs mt-1" })
                    }
                </div>

                <!-- Customer Type -->
                <div class="floating-input-group relative">
                    <select id="CustomerType"
                            name="CustomerType"
                            required
                            class="peer w-full px-3 sm:px-4 py-2.5 sm:py-3 text-sm rounded-xl border border-amber-200 dark:border-amber-800 bg-white dark:bg-gray-700 text-stone-800 dark:text-amber-100 focus:border-amber-600 dark:focus:border-amber-400 focus:ring-2 focus:ring-amber-200 dark:focus:ring-amber-800 transition-all duration-200 outline-none appearance-none @(ViewData.ModelState["CustomerType"]?.Errors?.Any() == true ? "border-red-500 dark:border-red-500 focus:border-red-600 dark:focus:border-red-400 focus:ring-red-200 dark:focus:ring-red-800" : "")">
                        <option value="" disabled selected>Select customer type</option>
                        <option value="Fleet" selected="@(createModel.CustomerType == "Fleet")">Fleet</option>
                        <option value="Corporate" selected="@(createModel.CustomerType == "Corporate")">Corporate</option>
                        <option value="Walk-in" selected="@(createModel.CustomerType == "Walk-in")">Walk-in</option>
                    </select>
                    <label for="CustomerType" class="absolute left-3 sm:left-4 -top-2 sm:-top-2.5 bg-white dark:bg-gray-800 px-1.5 sm:px-2 text-xs sm:text-sm text-stone-600 dark:text-stone-400 transition-all duration-200 peer-focus:-top-2 sm:peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-amber-600 dark:peer-focus:text-amber-400 peer-focus:bg-white dark:peer-focus:bg-gray-800">
                        Customer Type *
                    </label>
                    @if (ViewData.ModelState["CustomerType"]?.Errors?.Any() == true)
                    {
                        <div class="text-red-500 dark:text-red-400 text-xs mt-1">
                            @foreach (var error in ViewData.ModelState["CustomerType"].Errors)
                            {
                                <span>@error.ErrorMessage</span>
                            }
                        </div>
                    }
                    else
                    {
                        @Html.ValidationMessageFor(m => createModel.CustomerType, "", new { @class = "text-red-500 dark:text-red-400 text-xs mt-1" })
                    }
                </div>

                <!-- Customer Phone with Unique Validation -->
                <div class="floating-input-group relative">
                    <input type="tel"
                           id="CustomerPhone"
                           name="CustomerPhone"
                           value="@createModel.CustomerPhone"
                           class="peer w-full px-3 sm:px-4 py-2.5 sm:py-3 text-sm rounded-xl border border-amber-200 dark:border-amber-800 bg-white dark:bg-gray-700 text-stone-800 dark:text-amber-100 focus:border-amber-600 dark:focus:border-amber-400 focus:ring-2 focus:ring-amber-200 dark:focus:ring-amber-800 transition-all duration-200 outline-none @(ViewData.ModelState["CustomerPhone"]?.Errors?.Any() == true ? "border-red-500 dark:border-red-500 focus:border-red-600 dark:focus:border-red-400 focus:ring-red-200 dark:focus:ring-red-800" : "")"
                           placeholder=" " />
                    <label for="CustomerPhone" class="absolute left-3 sm:left-4 -top-2 sm:-top-2.5 bg-white dark:bg-gray-800 px-1.5 sm:px-2 text-xs sm:text-sm text-stone-600 dark:text-stone-400 transition-all duration-200 peer-placeholder-shown:text-sm peer-placeholder-shown:top-2 sm:peer-placeholder-shown:top-3 peer-placeholder-shown:bg-transparent dark:peer-placeholder-shown:bg-transparent peer-focus:-top-2 sm:peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-amber-600 dark:peer-focus:text-amber-400 peer-focus:bg-white dark:peer-focus:bg-gray-800">
                        Customer Phone
                    </label>
                    @if (ViewData.ModelState["CustomerPhone"]?.Errors?.Any() == true)
                    {
                        <div class="text-red-500 dark:text-red-400 text-xs mt-1 flex items-center gap-1">
                            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                            </svg>
                            @foreach (var error in ViewData.ModelState["CustomerPhone"].Errors)
                            {
                                <span>@error.ErrorMessage</span>
                            }
                        </div>
                    }
                    else
                    {
                        @Html.ValidationMessageFor(m => createModel.CustomerPhone, "", new { @class = "text-red-500 dark:text-red-400 text-xs mt-1" })
                    }
                </div>

                <!-- Customer Email -->
                <div class="floating-input-group relative">
                    <input type="email"
                           id="CustomerEmail"
                           name="CustomerEmail"
                           value="@createModel.CustomerEmail"
                           class="peer w-full px-3 sm:px-4 py-2.5 sm:py-3 text-sm rounded-xl border border-amber-200 dark:border-amber-800 bg-white dark:bg-gray-700 text-stone-800 dark:text-amber-100 focus:border-amber-600 dark:focus:border-amber-400 focus:ring-2 focus:ring-amber-200 dark:focus:ring-amber-800 transition-all duration-200 outline-none @(ViewData.ModelState["CustomerEmail"]?.Errors?.Any() == true ? "border-red-500 dark:border-red-500 focus:border-red-600 dark:focus:border-red-400 focus:ring-red-200 dark:focus:ring-red-800" : "")"
                           placeholder=" " />
                    <label for="CustomerEmail" class="absolute left-3 sm:left-4 -top-2 sm:-top-2.5 bg-white dark:bg-gray-800 px-1.5 sm:px-2 text-xs sm:text-sm text-stone-600 dark:text-stone-400 transition-all duration-200 peer-placeholder-shown:text-sm peer-placeholder-shown:top-2 sm:peer-placeholder-shown:top-3 peer-placeholder-shown:bg-transparent dark:peer-placeholder-shown:bg-transparent peer-focus:-top-2 sm:peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-amber-600 dark:peer-focus:text-amber-400 peer-focus:bg-white dark:peer-focus:bg-gray-800">
                        Customer Email
                    </label>
                    @if (ViewData.ModelState["CustomerEmail"]?.Errors?.Any() == true)
                    {
                        <div class="text-red-500 dark:text-red-400 text-xs mt-1">
                            @foreach (var error in ViewData.ModelState["CustomerEmail"].Errors)
                            {
                                <span>@error.ErrorMessage</span>
                            }
                        </div>
                    }
                    else
                    {
                        @Html.ValidationMessageFor(m => createModel.CustomerEmail, "", new { @class = "text-red-500 dark:text-red-400 text-xs mt-1" })
                    }
                </div>
            </div>
        </div>

        <!-- Fuel Details Section -->
        <div class="border-b border-amber-200 dark:border-amber-800 pb-4">
            <h3 class="text-base sm:text-lg font-semibold text-stone-800 dark:text-amber-100 mb-3 sm:mb-4">Fuel Details</h3>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6">
                <!-- Fuel Type -->
                <div class="floating-input-group relative">
                    <select id="FuelType"
                            name="FuelType"
                            required
                            class="peer w-full px-3 sm:px-4 py-2.5 sm:py-3 text-sm rounded-xl border border-amber-200 dark:border-amber-800 bg-white dark:bg-gray-700 text-stone-800 dark:text-amber-100 focus:border-amber-600 dark:focus:border-amber-400 focus:ring-2 focus:ring-amber-200 dark:focus:ring-amber-800 transition-all duration-200 outline-none appearance-none @(ViewData.ModelState["FuelType"]?.Errors?.Any() == true ? "border-red-500 dark:border-red-500 focus:border-red-600 dark:focus:border-red-400 focus:ring-red-200 dark:focus:ring-red-800" : "")">
                        <option value="" disabled selected>Select fuel type</option>
                        <option value="Premium Gasoline" selected="@(createModel.FuelType == "Premium Gasoline")">Premium Gasoline</option>
                        <option value="Regular Gasoline" selected="@(createModel.FuelType == "Regular Gasoline")">Regular Gasoline</option>
                        <option value="Diesel" selected="@(createModel.FuelType == "Diesel")">Diesel</option>
                        <option value="Premium Diesel" selected="@(createModel.FuelType == "Premium Diesel")">Premium Diesel</option>
                        <option value="Ethanol" selected="@(createModel.FuelType == "Ethanol")">Ethanol</option>
                    </select>
                    <label for="FuelType" class="absolute left-3 sm:left-4 -top-2 sm:-top-2.5 bg-white dark:bg-gray-800 px-1.5 sm:px-2 text-xs sm:text-sm text-stone-600 dark:text-stone-400 transition-all duration-200 peer-focus:-top-2 sm:peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-amber-600 dark:peer-focus:text-amber-400 peer-focus:bg-white dark:peer-focus:bg-gray-800">
                        Fuel Type *
                    </label>
                    @if (ViewData.ModelState["FuelType"]?.Errors?.Any() == true)
                    {
                        <div class="text-red-500 dark:text-red-400 text-xs mt-1">
                            @foreach (var error in ViewData.ModelState["FuelType"].Errors)
                            {
                                <span>@error.ErrorMessage</span>
                            }
                        </div>
                    }
                    else
                    {
                        @Html.ValidationMessageFor(m => createModel.FuelType, "", new { @class = "text-red-500 dark:text-red-400 text-xs mt-1" })
                    }
                </div>

                <!-- Total Liters -->
                <div class="floating-input-group relative">
                    <input type="number"
                           id="TotalLiters"
                           name="TotalLiters"
                           value="@createModel.TotalLiters"
                           step="0.1"
                           min="0.1"
                           required
                           class="peer w-full px-3 sm:px-4 py-2.5 sm:py-3 text-sm rounded-xl border border-amber-200 dark:border-amber-800 bg-white dark:bg-gray-700 text-stone-800 dark:text-amber-100 focus:border-amber-600 dark:focus:border-amber-400 focus:ring-2 focus:ring-amber-200 dark:focus:ring-amber-800 transition-all duration-200 outline-none @(ViewData.ModelState["TotalLiters"]?.Errors?.Any() == true ? "border-red-500 dark:border-red-500 focus:border-red-600 dark:focus:border-red-400 focus:ring-red-200 dark:focus:ring-red-800" : "")"
                           placeholder=" " />
                    <label for="TotalLiters" class="absolute left-3 sm:left-4 -top-2 sm:-top-2.5 bg-white dark:bg-gray-800 px-1.5 sm:px-2 text-xs sm:text-sm text-stone-600 dark:text-stone-400 transition-all duration-200 peer-placeholder-shown:text-sm peer-placeholder-shown:top-2 sm:peer-placeholder-shown:top-3 peer-placeholder-shown:bg-transparent dark:peer-placeholder-shown:bg-transparent peer-focus:-top-2 sm:peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-amber-600 dark:peer-focus:text-amber-400 peer-focus:bg-white dark:peer-focus:bg-gray-800">
                        Total Liters *
                    </label>
                    @if (ViewData.ModelState["TotalLiters"]?.Errors?.Any() == true)
                    {
                        <div class="text-red-500 dark:text-red-400 text-xs mt-1">
                            @foreach (var error in ViewData.ModelState["TotalLiters"].Errors)
                            {
                                <span>@error.ErrorMessage</span>
                            }
                        </div>
                    }
                    else
                    {
                        @Html.ValidationMessageFor(m => createModel.TotalLiters, "", new { @class = "text-red-500 dark:text-red-400 text-xs mt-1" })
                    }
                </div>

                <!-- Unit Price -->
                <div class="floating-input-group relative">
                    <input type="number"
                           id="UnitPrice"
                           name="UnitPrice"
                           value="@createModel.UnitPrice"
                           step="0.01"
                           min="0.01"
                           required
                           class="peer w-full px-3 sm:px-4 py-2.5 sm:py-3 text-sm rounded-xl border border-amber-200 dark:border-amber-800 bg-white dark:bg-gray-700 text-stone-800 dark:text-amber-100 focus:border-amber-600 dark:focus:border-amber-400 focus:ring-2 focus:ring-amber-200 dark:focus:ring-amber-800 transition-all duration-200 outline-none @(ViewData.ModelState["UnitPrice"]?.Errors?.Any() == true ? "border-red-500 dark:border-red-500 focus:border-red-600 dark:focus:border-red-400 focus:ring-red-200 dark:focus:ring-red-800" : "")"
                           placeholder=" " />
                    <label for="UnitPrice" class="absolute left-3 sm:left-4 -top-2 sm:-top-2.5 bg-white dark:bg-gray-800 px-1.5 sm:px-2 text-xs sm:text-sm text-stone-600 dark:text-stone-400 transition-all duration-200 peer-placeholder-shown:text-sm peer-placeholder-shown:top-2 sm:peer-placeholder-shown:top-3 peer-placeholder-shown:bg-transparent dark:peer-placeholder-shown:bg-transparent peer-focus:-top-2 sm:peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-amber-600 dark:peer-focus:text-amber-400 peer-focus:bg-white dark:peer-focus:bg-gray-800">
                        Unit Price ($) *
                    </label>
                    @if (ViewData.ModelState["UnitPrice"]?.Errors?.Any() == true)
                    {
                        <div class="text-red-500 dark:text-red-400 text-xs mt-1">
                            @foreach (var error in ViewData.ModelState["UnitPrice"].Errors)
                            {
                                <span>@error.ErrorMessage</span>
                            }
                        </div>
                    }
                    else
                    {
                        @Html.ValidationMessageFor(m => createModel.UnitPrice, "", new { @class = "text-red-500 dark:text-red-400 text-xs mt-1" })
                    }
                </div>
            </div>
        </div>

        <!-- Calculation Preview Section -->
        <div class="bg-gradient-to-r from-amber-50 to-stone-50 dark:from-gray-800 dark:to-gray-700 rounded-xl p-4 sm:p-6 border border-amber-200 dark:border-amber-800">
            <h4 class="text-xs sm:text-sm font-medium text-amber-800 dark:text-amber-300 mb-3 sm:mb-4">Invoice Calculation Preview</h4>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
                <div class="bg-white dark:bg-gray-700 rounded-lg p-2 sm:p-3 border border-amber-100 dark:border-amber-800">
                    <span class="text-xs text-stone-500 dark:text-stone-400">Subtotal</span>
                    <p id="subtotalPreview" class="text-sm sm:text-lg font-semibold text-stone-800 dark:text-amber-100">$0.00</p>
                </div>
                <div class="bg-white dark:bg-gray-700 rounded-lg p-2 sm:p-3 border border-amber-100 dark:border-amber-800">
                    <span class="text-xs text-stone-500 dark:text-stone-400">VAT (5%)</span>
                    <p id="vatPreview" class="text-sm sm:text-lg font-semibold text-amber-600 dark:text-amber-400">$0.00</p>
                </div>
                <div class="bg-white dark:bg-gray-700 rounded-lg p-2 sm:p-3 border border-amber-100 dark:border-amber-800">
                    <span class="text-xs text-stone-500 dark:text-stone-400">Total Amount</span>
                    <p id="totalPreview" class="text-sm sm:text-lg font-bold text-amber-800 dark:text-amber-300">$0.00</p>
                </div>
                <div class="bg-white dark:bg-gray-700 rounded-lg p-2 sm:p-3 border border-amber-100 dark:border-amber-800">
                    <span class="text-xs text-stone-500 dark:text-stone-400">Balance Due</span>
                    <p id="balancePreview" class="text-sm sm:text-lg font-semibold text-red-600 dark:text-red-400">$0.00</p>
                </div>
            </div>
        </div>

        <!-- Payment Details Section -->
        <div class="border-b border-amber-200 dark:border-amber-800 pb-4">
            <h3 class="text-base sm:text-lg font-semibold text-stone-800 dark:text-amber-100 mb-3 sm:mb-4">Payment Details</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
                <!-- Amount Paid -->
                <div class="floating-input-group relative">
                    <input type="number"
                           id="AmountPaid"
                           name="AmountPaid"
                           value="@createModel.AmountPaid"
                           step="0.01"
                           min="0"
                           class="peer w-full px-3 sm:px-4 py-2.5 sm:py-3 text-sm rounded-xl border border-amber-200 dark:border-amber-800 bg-white dark:bg-gray-700 text-stone-800 dark:text-amber-100 focus:border-amber-600 dark:focus:border-amber-400 focus:ring-2 focus:ring-amber-200 dark:focus:ring-amber-800 transition-all duration-200 outline-none @(ViewData.ModelState["AmountPaid"]?.Errors?.Any() == true ? "border-red-500 dark:border-red-500 focus:border-red-600 dark:focus:border-red-400 focus:ring-red-200 dark:focus:ring-red-800" : "")"
                           placeholder=" " />
                    <label for="AmountPaid" class="absolute left-3 sm:left-4 -top-2 sm:-top-2.5 bg-white dark:bg-gray-800 px-1.5 sm:px-2 text-xs sm:text-sm text-stone-600 dark:text-stone-400 transition-all duration-200 peer-placeholder-shown:text-sm peer-placeholder-shown:top-2 sm:peer-placeholder-shown:top-3 peer-placeholder-shown:bg-transparent dark:peer-placeholder-shown:bg-transparent peer-focus:-top-2 sm:peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-amber-600 dark:peer-focus:text-amber-400 peer-focus:bg-white dark:peer-focus:bg-gray-800">
                        Amount Paid ($)
                    </label>
                    @if (ViewData.ModelState["AmountPaid"]?.Errors?.Any() == true)
                    {
                        <div class="text-red-500 dark:text-red-400 text-xs mt-1">
                            @foreach (var error in ViewData.ModelState["AmountPaid"].Errors)
                            {
                                <span>@error.ErrorMessage</span>
                            }
                        </div>
                    }
                </div>

                <!-- Payment Status -->
                <div class="floating-input-group relative">
                    <select id="PaymentStatus"
                            name="PaymentStatus"
                            class="peer w-full px-3 sm:px-4 py-2.5 sm:py-3 text-sm rounded-xl border border-amber-200 dark:border-amber-800 bg-white dark:bg-gray-700 text-stone-800 dark:text-amber-100 focus:border-amber-600 dark:focus:border-amber-400 focus:ring-2 focus:ring-amber-200 dark:focus:ring-amber-800 transition-all duration-200 outline-none appearance-none">
                        <option value="Paid" selected="@(createModel.PaymentStatus == "Paid")">Paid</option>
                        <option value="Unpaid" selected="@(createModel.PaymentStatus == "Unpaid")">Unpaid</option>
                        <option value="Partial" selected="@(createModel.PaymentStatus == "Partial")">Partial</option>
                        <option value="Overdue" selected="@(createModel.PaymentStatus == "Overdue")">Overdue</option>
                    </select>
                    <label for="PaymentStatus" class="absolute left-3 sm:left-4 -top-2 sm:-top-2.5 bg-white dark:bg-gray-800 px-1.5 sm:px-2 text-xs sm:text-sm text-stone-600 dark:text-stone-400 transition-all duration-200 peer-focus:-top-2 sm:peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-amber-600 dark:peer-focus:text-amber-400 peer-focus:bg-white dark:peer-focus:bg-gray-800">
                        Payment Status
                    </label>
                </div>
            </div>
        </div>

        <!-- Dates Section -->
        <div class="border-b border-amber-200 dark:border-amber-800 pb-4">
            <h3 class="text-base sm:text-lg font-semibold text-stone-800 dark:text-amber-100 mb-3 sm:mb-4">Invoice Dates</h3>
