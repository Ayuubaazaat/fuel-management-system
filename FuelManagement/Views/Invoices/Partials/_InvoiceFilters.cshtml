@model FuelManagement.Models.InvoiceFilterViewModel

<div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-lg rounded-2xl shadow-lg dark:shadow-gray-900/30 p-4 sm:p-6 border border-amber-200 dark:border-amber-800/50">
    <form method="get" action="@Url.Action("Index")" id="filterForm" class="space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 sm:gap-0 mb-4">
            <h3 class="text-base sm:text-lg font-semibold text-stone-800 dark:text-amber-100">Filter Invoices</h3>
            <button type="button" onclick="clearAllFilters()"
                    class="text-sm text-amber-700 dark:text-amber-400 hover:text-amber-800 dark:hover:text-amber-300 font-medium text-left sm:text-right">
                Clear All
            </button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
            <!-- Date Range -->
            <div class="space-y-1 sm:space-y-2">
                <label class="text-xs sm:text-sm font-medium text-stone-700 dark:text-amber-300">From</label>
                <input type="date" name="StartDate" id="StartDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                       class="w-full px-3 sm:px-4 py-2 sm:py-2.5 text-sm rounded-xl border border-amber-200 dark:border-amber-700 bg-white dark:bg-gray-700 text-stone-800 dark:text-amber-100 focus:border-amber-600 dark:focus:border-amber-400 focus:ring-2 focus:ring-amber-200 dark:focus:ring-amber-800 transition-all duration-200" />
            </div>

            <div class="space-y-1 sm:space-y-2">
                <label class="text-xs sm:text-sm font-medium text-stone-700 dark:text-amber-300">To</label>
                <input type="date" name="EndDate" id="EndDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                       class="w-full px-3 sm:px-4 py-2 sm:py-2.5 text-sm rounded-xl border border-amber-200 dark:border-amber-700 bg-white dark:bg-gray-700 text-stone-800 dark:text-amber-100 focus:border-amber-600 dark:focus:border-amber-400 focus:ring-2 focus:ring-amber-200 dark:focus:ring-amber-800 transition-all duration-200" />
            </div>

            <!-- Customer Type -->
            <div class="space-y-1 sm:space-y-2">
                <label class="text-xs sm:text-sm font-medium text-stone-700 dark:text-amber-300">Customer Type</label>
                <select name="CustomerType" id="CustomerType" class="w-full px-3 sm:px-4 py-2 sm:py-2.5 text-sm rounded-xl border border-amber-200 dark:border-amber-700 bg-white dark:bg-gray-700 text-stone-800 dark:text-amber-100 focus:border-amber-600 dark:focus:border-amber-400 focus:ring-2 focus:ring-amber-200 dark:focus:ring-amber-800 transition-all duration-200">
                    <option value="">All Types</option>
                    @foreach (var type in Model.AvailableCustomerTypes)
                    {
                        <option value="@type" selected="@(Model.CustomerType == type)">@type</option>
                    }
                </select>
            </div>

            <!-- Payment Status -->
            <div class="space-y-1 sm:space-y-2">
                <label class="text-xs sm:text-sm font-medium text-stone-700 dark:text-amber-300">Status</label>
                <select name="PaymentStatus" id="PaymentStatus" class="w-full px-3 sm:px-4 py-2 sm:py-2.5 text-sm rounded-xl border border-amber-200 dark:border-amber-700 bg-white dark:bg-gray-700 text-stone-800 dark:text-amber-100 focus:border-amber-600 dark:focus:border-amber-400 focus:ring-2 focus:ring-amber-200 dark:focus:ring-amber-800 transition-all duration-200">
                    <option value="">All Status</option>
                    @foreach (var status in Model.AvailablePaymentStatuses)
                    {
                        <option value="@status" selected="@(Model.PaymentStatus == status)">@status</option>
                    }
                </select>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
            <!-- Fuel Type -->
            <div class="space-y-1 sm:space-y-2">
                <label class="text-xs sm:text-sm font-medium text-stone-700 dark:text-amber-300">Fuel Type</label>
                <select name="FuelType" id="FuelType" class="w-full px-3 sm:px-4 py-2 sm:py-2.5 text-sm rounded-xl border border-amber-200 dark:border-amber-700 bg-white dark:bg-gray-700 text-stone-800 dark:text-amber-100 focus:border-amber-600 dark:focus:border-amber-400 focus:ring-2 focus:ring-amber-200 dark:focus:ring-amber-800 transition-all duration-200">
                    <option value="">All Fuels</option>
                    @foreach (var fuel in Model.AvailableFuelTypes)
                    {
                        <option value="@fuel" selected="@(Model.FuelType == fuel)">@fuel</option>
                    }
                </select>
            </div>

            <!-- Search -->
            <div class="space-y-1 sm:space-y-2">
                <label class="text-xs sm:text-sm font-medium text-stone-700 dark:text-amber-300">Search</label>
                <input type="text" name="CustomerName" id="CustomerName" value="@Model.CustomerName" placeholder="Invoice # or Customer"
                       class="w-full px-3 sm:px-4 py-2 sm:py-2.5 text-sm rounded-xl border border-amber-200 dark:border-amber-700 bg-white dark:bg-gray-700 text-stone-800 dark:text-amber-100 placeholder-stone-400 dark:placeholder-amber-300/50 focus:border-amber-600 dark:focus:border-amber-400 focus:ring-2 focus:ring-amber-200 dark:focus:ring-amber-800 transition-all duration-200" />
            </div>
        </div>

        <div class="flex justify-end pt-2 sm:pt-4">
            <button type="submit"
                    class="w-full sm:w-auto px-4 sm:px-6 py-2.5 sm:py-2.5 bg-gradient-to-r from-amber-800 to-stone-900 dark:from-amber-700 dark:to-stone-800 text-amber-100 dark:text-amber-100 font-medium rounded-xl hover:from-amber-900 dark:hover:from-amber-800 hover:to-stone-950 dark:hover:to-stone-900 transform hover:scale-105 transition-all duration-200 shadow-lg hover:shadow-xl text-sm sm:text-base">
                Apply Filters
            </button>
        </div>
    </form>
</div>

<script>
    function clearAllFilters() {
        // Clear all input fields
        document.getElementById('StartDate').value = '';
        document.getElementById('EndDate').value = '';
        document.getElementById('CustomerType').value = '';
        document.getElementById('PaymentStatus').value = '';
        document.getElementById('FuelType').value = '';
        document.getElementById('CustomerName').value = '';

        // Submit the form to refresh the page with cleared filters
        document.getElementById('filterForm').submit();
    }
</script>