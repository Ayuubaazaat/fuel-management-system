@{
    // This partial is used without a specific model, just receives parameters via JavaScript
}

<div id="deleteInvoiceModal" class="fixed inset-0 z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <!-- Background overlay with blur - separate from modal to prevent event bubbling issues -->
    <div id="modalOverlay" class="fixed inset-0 bg-stone-900 bg-opacity-75 dark:bg-gray-900 dark:bg-opacity-75 transition-opacity backdrop-blur-sm" aria-hidden="true"></div>

    <!-- Modal panel - centered -->
    <div class="fixed inset-0 flex items-center justify-center p-4 pointer-events-none">
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl w-full max-w-md mx-auto transform transition-all animate-slideUp pointer-events-auto">
            <!-- Header -->
            <div class="bg-gradient-to-r from-amber-800 to-red-800 dark:from-amber-900 dark:to-red-900 px-4 sm:px-6 py-3 sm:py-4 rounded-t-2xl">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <svg class="h-5 w-5 sm:h-6 sm:w-6 text-amber-100 dark:text-amber-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                        </svg>
                    </div>
                    <h3 class="ml-2 sm:ml-3 text-base sm:text-lg font-semibold text-amber-100 dark:text-amber-200" id="modal-title">
                        Delete Invoice
                    </h3>
                </div>
            </div>

            <!-- Body -->
            <div class="bg-white dark:bg-gray-800 px-4 sm:px-6 py-4 sm:py-6">
                <div class="text-center">
                    <svg class="mx-auto h-10 w-10 sm:h-12 sm:w-12 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                    <p class="mt-3 sm:mt-4 text-sm sm:text-base font-medium text-stone-900 dark:text-amber-100">
                        Are you sure you want to delete invoice <span id="deleteInvoiceNumber" class="font-semibold text-amber-800 dark:text-amber-400"></span>?
                    </p>
                    <p class="mt-2 text-xs sm:text-sm text-stone-500 dark:text-stone-400">
                        This action cannot be undone. All associated transaction data will be permanently removed from the system.
                    </p>
                </div>
            </div>

            <!-- Footer -->
            <div class="bg-stone-50 dark:bg-gray-700 px-4 sm:px-6 py-3 sm:py-4 rounded-b-2xl flex flex-col sm:flex-row justify-end gap-2 sm:space-x-3">
                <button type="button"
                        onclick="closeDeleteInvoiceModal()"
                        class="w-full sm:w-auto px-4 sm:px-6 py-2.5 bg-white dark:bg-gray-600 text-stone-700 dark:text-stone-200 text-sm font-medium rounded-lg border border-stone-300 dark:border-gray-600 hover:bg-stone-50 dark:hover:bg-gray-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-amber-500 transition-all duration-200 order-2 sm:order-1">
                    Cancel
                </button>
                <form id="deleteInvoiceForm" method="post" action="@Url.Action("Delete", "Invoices")" class="w-full sm:w-auto order-1 sm:order-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteInvoiceId" name="id" value="" />
                    <button type="submit"
                            class="w-full sm:w-auto px-4 sm:px-6 py-2.5 bg-gradient-to-r from-amber-700 to-red-700 dark:from-amber-800 dark:to-red-800 text-white dark:text-amber-100 text-sm font-medium rounded-lg hover:from-amber-800 dark:hover:from-amber-900 hover:to-red-800 dark:hover:to-red-900 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-all duration-200 shadow-lg hover:shadow-xl">
                        Delete Invoice
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    // Ensure modal is hidden on page load
    document.addEventListener('DOMContentLoaded', function() {
        var modal = document.getElementById('deleteInvoiceModal');
        if (modal) {
            modal.classList.add('hidden');
        }
    });

    function openDeleteInvoiceModal(invoiceNumber, id) {
        // Set values - store both but use invoiceNumber for deletion
        document.getElementById('deleteInvoiceId').value = invoiceNumber; // Send InvoiceNumber instead of Id
        document.getElementById('deleteInvoiceNumber').textContent = invoiceNumber;

        // Show modal
        var modal = document.getElementById('deleteInvoiceModal');
        modal.classList.remove('hidden');

        // Lock body scroll
        document.body.style.overflow = 'hidden';
        document.body.style.paddingRight = window.innerWidth - document.documentElement.clientWidth + 'px';
    }

    function closeDeleteInvoiceModal() {
        // Hide modal
        var modal = document.getElementById('deleteInvoiceModal');
        modal.classList.add('hidden');

        // Restore body scroll
        document.body.style.overflow = '';
        document.body.style.paddingRight = '';
    }

    // Close modal with Escape key - only if modal is visible
    document.addEventListener('keydown', function(e) {
        var modal = document.getElementById('deleteInvoiceModal');
        if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
            closeDeleteInvoiceModal();
        }
    });

    // Close modal when clicking overlay
    document.addEventListener('DOMContentLoaded', function() {
        var modal = document.getElementById('deleteInvoiceModal');
        if (modal) {
            modal.addEventListener('click', function(e) {
                if (e.target === modal || e.target.id === 'modalOverlay') {
                    closeDeleteInvoiceModal();
                }
            });
        }
    });
</script>

<style>
    .animate-slideUp {
        animation: slideUp 0.3s ease-out;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .pointer-events-none {
        pointer-events: none;
    }

    .pointer-events-auto {
        pointer-events: auto;
    }
</style>