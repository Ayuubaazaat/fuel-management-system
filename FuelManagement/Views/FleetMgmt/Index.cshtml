@model FuelManagement.Models.FleetMgmtViewModel
@{
    ViewData["Title"] = "Fleet Management";
}

<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-900 dark:to-gray-800">
    <!-- Header Partial -->
    @await Html.PartialAsync("Partials/_FleetHeader")

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-8">
        <!-- Summary Cards Partial -->
        @await Html.PartialAsync("Partials/_FleetSummaryCards", Model)

        <!-- Filters Section -->
        <div class="mt-6 sm:mt-8 animate-fadeIn" style="animation-delay: 0.2s;">
            @await Html.PartialAsync("Partials/_FleetFilters", Model.Filter)
        </div>

        <!-- Table Section -->
        <div class="mt-4 sm:mt-6 animate-fadeIn" style="animation-delay: 0.3s;">
            @await Html.PartialAsync("Partials/_FleetTable", Model)
        </div>
    </div>
</div>

<!-- Delete Modal -->
@await Html.PartialAsync("Partials/_DeleteFleetModal")

<style>
    .animate-fadeIn {
        animation: fadeIn 0.6s ease-out forwards;
        opacity: 0;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>