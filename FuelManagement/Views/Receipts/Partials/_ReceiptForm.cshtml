@model dynamic

@{
    var isEdit = Model.GetType().GetProperty("Id") != null;
    var isCreateViewModel = Model.GetType().Name == "ReceiptCreateViewModel";
    var isEditViewModel = Model.GetType().Name == "ReceiptEditViewModel";
}

<div class="space-y-4 sm:space-y-6">
    @if (!isEdit)
    {
        <div class="bg-indigo-50 dark:bg-indigo-900/30 rounded-xl p-3 sm:p-4 border border-indigo-100 dark:border-indigo-800 mb-4 sm:mb-6">
            <div class="flex items-center">
                <svg class="w-4 h-4 sm:w-5 sm:h-5 text-indigo-600 dark:text-indigo-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span class="text-xs sm:text-sm text-indigo-800 dark:text-indigo-300">Receipt Number will be auto-generated: <span class="font-mono font-semibold">@Model.ReceiptNo</span></span>
            </div>
        </div>
    }

    <!-- Invoice Selection Dropdown (only for Create) -->
    @if (!isEdit && isCreateViewModel)
    {
        <div class="bg-blue-50 dark:bg-blue-900/30 rounded-xl p-4 sm:p-6 border border-blue-100 dark:border-blue-800 mb-4">
            <h4 class="text-sm font-medium text-blue-800 dark:text-blue-300 mb-3">Create from Existing Invoice</h4>
            <div class="grid grid-cols-1 gap-4">
                <div class="floating-input-group relative">
                    <select id="SelectedInvoiceId"
                            name="SelectedInvoiceId"
                            class="w-full px-3 sm:px-4 py-2.5 sm:py-3 text-sm rounded-xl border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100 focus:border-indigo-500 dark:focus:border-indigo-400 focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-800 transition-all duration-200 outline-none appearance-none">
                        @foreach (var invoice in Model.Invoices)
                        {
                            <option value="@invoice.Value">@invoice.Text</option>
                        }
                    </select>
                    <label for="SelectedInvoiceId"
                           class="absolute left-3 sm:left-4 -top-2 sm:-top-2.5 bg-white dark:bg-gray-800 px-1.5 sm:px-2 text-xs sm:text-sm text-gray-600 dark:text-gray-400">
                        Select Invoice (Optional)
                    </label>
                </div>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Selecting an invoice will auto-fill the form below</p>
            </div>
        </div>
    }

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
        <!-- Invoice Reference - Read-only in Edit mode -->
        <div class="floating-input-group relative">
            @if (isEdit)
            {
                <input type="text"
                       id="InvoiceRef"
                       name="InvoiceRef"
                       value="@(Model.InvoiceRef ?? "")"
                       required
                       readonly
                       class="peer w-full px-3 sm:px-4 py-2.5 sm:py-3 text-sm rounded-xl border border-gray-200 dark:border-gray-600 bg-gray-100 dark:bg-gray-600 text-gray-700 dark:text-gray-300 cursor-not-allowed @(ViewData.ModelState["InvoiceRef"]?.Errors.Any() == true ? "border-red-500 dark:border-red-500" : "")"
                       placeholder=" " />
            }
            else
            {
                <input type="text"
                       id="InvoiceRef"
                       name="InvoiceRef"
                       value="@(Model.InvoiceRef ?? "")"
                       required
                       class="peer w-full px-3 sm:px-4 py-2.5 sm:py-3 text-sm rounded-xl border @(ViewData.ModelState["InvoiceRef"]?.Errors.Any() == true ? "border-red-500 dark:border-red-500" : "border-gray-200 dark:border-gray-600") bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100 focus:border-indigo-500 dark:focus:border-indigo-400 focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-800 transition-all duration-200 outline-none"
                       placeholder=" " />
            }
            <label for="InvoiceRef"
                   class="absolute left-3 sm:left-4 -top-2 sm:-top-2.5 bg-white dark:bg-gray-800 px-1.5 sm:px-2 text-xs sm:text-sm text-gray-600 dark:text-gray-400 transition-all duration-200 peer-placeholder-shown:text-sm peer-placeholder-shown:top-2 sm:peer-placeholder-shown:top-3 peer-placeholder-shown:bg-transparent dark:peer-placeholder-shown:bg-transparent peer-focus:-top-2 sm:peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-indigo-600 dark:peer-focus:text-indigo-400 peer-focus:bg-white dark:peer-focus:bg-gray-800">
                Invoice Reference *
            </label>
            @if (ViewData.ModelState["InvoiceRef"]?.Errors.Any() == true)
            {
                <p class="text-red-500 text-xs mt-1">@ViewData.ModelState["InvoiceRef"]?.Errors.First().ErrorMessage</p>
            }
        </div>

        <!-- Customer Name -->
        <div class="floating-input-group relative">
            <input type="text"
                   id="CustomerName"
                   name="CustomerName"
                   value="@(Model.CustomerName ?? "")"
                   required
                   class="peer w-full px-3 sm:px-4 py-2.5 sm:py-3 text-sm rounded-xl border @(ViewData.ModelState["CustomerName"]?.Errors.Any() == true ? "border-red-500 dark:border-red-500" : "border-gray-200 dark:border-gray-600") bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100 focus:border-indigo-500 dark:focus:border-indigo-400 focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-800 transition-all duration-200 outline-none"
                   placeholder=" " />
            <label for="CustomerName"
                   class="absolute left-3 sm:left-4 -top-2 sm:-top-2.5 bg-white dark:bg-gray-800 px-1.5 sm:px-2 text-xs sm:text-sm text-gray-600 dark:text-gray-400 transition-all duration-200 peer-placeholder-shown:text-sm peer-placeholder-shown:top-2 sm:peer-placeholder-shown:top-3 peer-placeholder-shown:bg-transparent dark:peer-placeholder-shown:bg-transparent peer-focus:-top-2 sm:peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-indigo-600 dark:peer-focus:text-indigo-400 peer-focus:bg-white dark:peer-focus:bg-gray-800">
                Customer Name *
            </label>
            @if (ViewData.ModelState["CustomerName"]?.Errors.Any() == true)
            {
                <p class="text-red-500 text-xs mt-1">@ViewData.ModelState["CustomerName"]?.Errors.First().ErrorMessage</p>
            }
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6">
        <!-- Customer Type -->
        <div class="floating-input-group relative">
            <select id="CustomerType"
                    name="CustomerType"
                    required
                    class="peer w-full px-3 sm:px-4 py-2.5 sm:py-3 text-sm rounded-xl border @(ViewData.ModelState["CustomerType"]?.Errors.Any() == true ? "border-red-500 dark:border-red-500" : "border-gray-200 dark:border-gray-600") bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100 focus:border-indigo-500 dark:focus:border-indigo-400 focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-800 transition-all duration-200 outline-none appearance-none">
                <option value="" disabled selected class="dark:bg-gray-700">Select customer type</option>
                <option value="Fleet" selected="@(Model.CustomerType == "Fleet")" class="dark:bg-gray-700">Fleet</option>
                <option value="Corporate" selected="@(Model.CustomerType == "Corporate")" class="dark:bg-gray-700">Corporate</option>
                <option value="Walk-in" selected="@(Model.CustomerType == "Walk-in")" class="dark:bg-gray-700">Walk-in</option>
            </select>
            <label for="CustomerType"
                   class="absolute left-3 sm:left-4 -top-2 sm:-top-2.5 bg-white dark:bg-gray-800 px-1.5 sm:px-2 text-xs sm:text-sm text-gray-600 dark:text-gray-400 transition-all duration-200 peer-focus:-top-2 sm:peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-indigo-600 dark:peer-focus:text-indigo-400 peer-focus:bg-white dark:peer-focus:bg-gray-800">
                Customer Type *
            </label>
            @if (ViewData.ModelState["CustomerType"]?.Errors.Any() == true)
            {
                <p class="text-red-500 text-xs mt-1">@ViewData.ModelState["CustomerType"]?.Errors.First().ErrorMessage</p>
            }
        </div>

        <!-- Customer Phone -->
        <div class="floating-input-group relative">
            <input type="tel"
                   id="CustomerPhone"
                   name="CustomerPhone"
                   value="@(Model.CustomerPhone ?? "")"
                   class="peer w-full px-3 sm:px-4 py-2.5 sm:py-3 text-sm rounded-xl border @(ViewData.ModelState["CustomerPhone"]?.Errors.Any() == true ? "border-red-500 dark:border-red-500" : "border-gray-200 dark:border-gray-600") bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100 focus:border-indigo-500 dark:focus:border-indigo-400 focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-800 transition-all duration-200 outline-none"
                   placeholder=" " />
            <label for="CustomerPhone"
                   class="absolute left-3 sm:left-4 -top-2 sm:-top-2.5 bg-white dark:bg-gray-800 px-1.5 sm:px-2 text-xs sm:text-sm text-gray-600 dark:text-gray-400 transition-all duration-200 peer-placeholder-shown:text-sm peer-placeholder-shown:top-2 sm:peer-placeholder-shown:top-3 peer-placeholder-shown:bg-transparent dark:peer-placeholder-shown:bg-transparent peer-focus:-top-2 sm:peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-indigo-600 dark:peer-focus:text-indigo-400 peer-focus:bg-white dark:peer-focus:bg-gray-800">
                Customer Phone
            </label>
            @if (ViewData.ModelState["CustomerPhone"]?.Errors.Any() == true)
            {
                <p class="text-red-500 text-xs mt-1">@ViewData.ModelState["CustomerPhone"]?.Errors.First().ErrorMessage</p>
            }
        </div>

        <!-- Customer Email -->
        <div class="floating-input-group relative">
            <input type="email"
                   id="CustomerEmail"
                   name="CustomerEmail"
                   value="@(Model.CustomerEmail ?? "")"
                   class="peer w-full px-3 sm:px-4 py-2.5 sm:py-3 text-sm rounded-xl border @(ViewData.ModelState["CustomerEmail"]?.Errors.Any() == true ? "border-red-500 dark:border-red-500" : "border-gray-200 dark:border-gray-600") bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100 focus:border-indigo-500 dark:focus:border-indigo-400 focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-800 transition-all duration-200 outline-none"
                   placeholder=" " />
            <label for="CustomerEmail"
                   class="absolute left-3 sm:left-4 -top-2 sm:-top-2.5 bg-white dark:bg-gray-800 px-1.5 sm:px-2 text-xs sm:text-sm text-gray-600 dark:text-gray-400 transition-all duration-200 peer-placeholder-shown:text-sm peer-placeholder-shown:top-2 sm:peer-placeholder-shown:top-3 peer-placeholder-shown:bg-transparent dark:peer-placeholder-shown:bg-transparent peer-focus:-top-2 sm:peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-indigo-600 dark:peer-focus:text-indigo-400 peer-focus:bg-white dark:peer-focus:bg-gray-800">
                Customer Email
            </label>
            @if (ViewData.ModelState["CustomerEmail"]?.Errors.Any() == true)
            {
                <p class="text-red-500 text-xs mt-1">@ViewData.ModelState["CustomerEmail"]?.Errors.First().ErrorMessage</p>
            }
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6">
        <!-- Fuel Type -->
        <div class="floating-input-group relative">
            <select id="FuelType"
                    name="FuelType"
                    required
                    class="peer w-full px-3 sm:px-4 py-2.5 sm:py-3 text-sm rounded-xl border @(ViewData.ModelState["FuelType"]?.Errors.Any() == true ? "border-red-500 dark:border-red-500" : "border-gray-200 dark:border-gray-600") bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100 focus:border-indigo-500 dark:focus:border-indigo-400 focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-800 transition-all duration-200 outline-none appearance-none">
                <option value="" disabled selected class="dark:bg-gray-700">Select fuel type</option>
                <option value="Premium Gasoline" selected="@(Model.FuelType == "Premium Gasoline")" class="dark:bg-gray-700">Premium Gasoline</option>
                <option value="Regular Gasoline" selected="@(Model.FuelType == "Regular Gasoline")" class="dark:bg-gray-700">Regular Gasoline</option>
                <option value="Diesel" selected="@(Model.FuelType == "Diesel")" class="dark:bg-gray-700">Diesel</option>
                <option value="Premium Diesel" selected="@(Model.FuelType == "Premium Diesel")" class="dark:bg-gray-700">Premium Diesel</option>
                <option value="Ethanol" selected="@(Model.FuelType == "Ethanol")" class="dark:bg-gray-700">Ethanol</option>
            </select>
            <label for="FuelType"
                   class="absolute left-3 sm:left-4 -top-2 sm:-top-2.5 bg-white dark:bg-gray-800 px-1.5 sm:px-2 text-xs sm:text-sm text-gray-600 dark:text-gray-400 transition-all duration-200 peer-focus:-top-2 sm:peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-indigo-600 dark:peer-focus:text-indigo-400 peer-focus:bg-white dark:peer-focus:bg-gray-800">
                Fuel Type *
            </label>
            @if (ViewData.ModelState["FuelType"]?.Errors.Any() == true)
            {
                <p class="text-red-500 text-xs mt-1">@ViewData.ModelState["FuelType"]?.Errors.First().ErrorMessage</p>
            }
        </div>

        <!-- Quantity -->
        <div class="floating-input-group relative">
            <input type="number"
                   id="Quantity"
                   name="Quantity"
                   value="@(Model.Quantity)"
                   step="0.1"
                   min="0.1"
                   required
                   class="peer w-full px-3 sm:px-4 py-2.5 sm:py-3 text-sm rounded-xl border @(ViewData.ModelState["Quantity"]?.Errors.Any() == true ? "border-red-500 dark:border-red-500" : "border-gray-200 dark:border-gray-600") bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100 focus:border-indigo-500 dark:focus:border-indigo-400 focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-800 transition-all duration-200 outline-none"
                   placeholder=" " />
            <label for="Quantity"
                   class="absolute left-3 sm:left-4 -top-2 sm:-top-2.5 bg-white dark:bg-gray-800 px-1.5 sm:px-2 text-xs sm:text-sm text-gray-600 dark:text-gray-400 transition-all duration-200 peer-placeholder-shown:text-sm peer-placeholder-shown:top-2 sm:peer-placeholder-shown:top-3 peer-placeholder-shown:bg-transparent dark:peer-placeholder-shown:bg-transparent peer-focus:-top-2 sm:peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-indigo-600 dark:peer-focus:text-indigo-400 peer-focus:bg-white dark:peer-focus:bg-gray-800">
                Quantity (Liters) *
            </label>
            @if (ViewData.ModelState["Quantity"]?.Errors.Any() == true)
            {
                <p class="text-red-500 text-xs mt-1">@ViewData.ModelState["Quantity"]?.Errors.First().ErrorMessage</p>
            }
        </div>

        <!-- Unit Price -->
        <div class="floating-input-group relative">
            <input type="number"
                   id="UnitPrice"
                   name="UnitPrice"
                   value="@(Model.UnitPrice)"
                   step="0.01"
                   min="0.01"
                   required
                   class="peer w-full px-3 sm:px-4 py-2.5 sm:py-3 text-sm rounded-xl border @(ViewData.ModelState["UnitPrice"]?.Errors.Any() == true ? "border-red-500 dark:border-red-500" : "border-gray-200 dark:border-gray-600") bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100 focus:border-indigo-500 dark:focus:border-indigo-400 focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-800 transition-all duration-200 outline-none"
                   placeholder=" " />
            <label for="UnitPrice"
                   class="absolute left-3 sm:left-4 -top-2 sm:-top-2.5 bg-white dark:bg-gray-800 px-1.5 sm:px-2 text-xs sm:text-sm text-gray-600 dark:text-gray-400 transition-all duration-200 peer-placeholder-shown:text-sm peer-placeholder-shown:top-2 sm:peer-placeholder-shown:top-3 peer-placeholder-shown:bg-transparent dark:peer-placeholder-shown:bg-transparent peer-focus:-top-2 sm:peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-indigo-600 dark:peer-focus:text-indigo-400 peer-focus:bg-white dark:peer-focus:bg-gray-800">
                Unit Price ($) *
            </label>
            @if (ViewData.ModelState["UnitPrice"]?.Errors.Any() == true)
            {
                <p class="text-red-500 text-xs mt-1">@ViewData.ModelState["UnitPrice"]?.Errors.First().ErrorMessage</p>
            }
        </div>
    </div>

    <!-- Calculation Preview -->
    <div class="bg-gradient-to-r from-slate-50 to-indigo-50 dark:from-gray-800 dark:to-gray-700 rounded-xl p-4 sm:p-6 border border-indigo-100 dark:border-indigo-800">
        <h4 class="text-xs sm:text-sm font-medium text-indigo-800 dark:text-indigo-300 mb-3 sm:mb-4">Receipt Calculation Preview</h4>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
            <div class="bg-white dark:bg-gray-700 rounded-lg p-2 sm:p-3">
                <span class="text-xs text-gray-500 dark:text-gray-400">Subtotal</span>
                <p id="subtotalPreview" class="text-sm sm:text-lg font-semibold text-slate-900 dark:text-indigo-100">$0.00</p>
            </div>
            <div class="bg-white dark:bg-gray-700 rounded-lg p-2 sm:p-3">
                <span class="text-xs text-gray-500 dark:text-gray-400">VAT (5%)</span>
                <p id="vatPreview" class="text-sm sm:text-lg font-semibold text-amber-600 dark:text-amber-400">$0.00</p>
            </div>
            <div class="bg-white dark:bg-gray-700 rounded-lg p-2 sm:p-3">
                <span class="text-xs text-gray-500 dark:text-gray-400">Total Amount</span>
                <p id="totalPreview" class="text-sm sm:text-lg font-bold text-indigo-600 dark:text-indigo-400">$0.00</p>
            </div>
        </div>
    </div>

    <!-- Payment Method Section - Somali Mobile Money Only -->
    <div class="bg-white dark:bg-gray-800 rounded-xl p-4 sm:p-6 border border-gray-200 dark:border-gray-700">
        <h4 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-3">Payment Method *</h4>
        <select id="PaymentMethod"
                name="PaymentMethod"
                required
                class="w-full px-3 sm:px-4 py-2.5 sm:py-3 text-sm rounded-xl border @(ViewData.ModelState["PaymentMethod"]?.Errors.Any() == true ? "border-red-500 dark:border-red-500" : "border-gray-200 dark:border-gray-600") bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100 focus:border-indigo-500 dark:focus:border-indigo-400 focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-800 transition-all duration-200 outline-none appearance-none">
            <option value="" disabled selected class="dark:bg-gray-700">Select payment method</option>
            <option value="EVC+" selected="@(Model.PaymentMethod == "EVC+")" class="dark:bg-gray-700">EVC+</option>
            <option value="Waafi" selected="@(Model.PaymentMethod == "Waafi")" class="dark:bg-gray-700">Waafi</option>
            <option value="Somtel" selected="@(Model.PaymentMethod == "Somtel")" class="dark:bg-gray-700">Somtel</option>
            <option value="Somnet" selected="@(Model.PaymentMethod == "Somnet")" class="dark:bg-gray-700">Somnet</option>
            <option value="E-Dahab" selected="@(Model.PaymentMethod == "E-Dahab")" class="dark:bg-gray-700">E-Dahab</option>
        </select>
        @if (ViewData.ModelState["PaymentMethod"]?.Errors.Any() == true)
        {
            <p class="text-red-500 text-xs mt-1">@ViewData.ModelState["PaymentMethod"]?.Errors.First().ErrorMessage</p>
        }
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
        <!-- Payment Date -->
        <div class="floating-input-group relative">
            <input type="date"
                   id="PaymentDate"
                   name="PaymentDate"
                   value="@(Model.PaymentDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))"
                   required
                   class="peer w-full px-3 sm:px-4 py-2.5 sm:py-3 text-sm rounded-xl border @(ViewData.ModelState["PaymentDate"]?.Errors.Any() == true ? "border-red-500 dark:border-red-500" : "border-gray-200 dark:border-gray-600") bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100 focus:border-indigo-500 dark:focus:border-indigo-400 focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-800 transition-all duration-200 outline-none"
                   placeholder=" " />
            <label for="PaymentDate"
                   class="absolute left-3 sm:left-4 -top-2 sm:-top-2.5 bg-white dark:bg-gray-800 px-1.5 sm:px-2 text-xs sm:text-sm text-gray-600 dark:text-gray-400 transition-all duration-200 peer-placeholder-shown:text-sm peer-placeholder-shown:top-2 sm:peer-placeholder-shown:top-3 peer-placeholder-shown:bg-transparent dark:peer-placeholder-shown:bg-transparent peer-focus:-top-2 sm:peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-indigo-600 dark:peer-focus:text-indigo-400 peer-focus:bg-white dark:peer-focus:bg-gray-800">
                Payment Date *
            </label>
            @if (ViewData.ModelState["PaymentDate"]?.Errors.Any() == true)
            {
                <p class="text-red-500 text-xs mt-1">@ViewData.ModelState["PaymentDate"]?.Errors.First().ErrorMessage</p>
            }
        </div>

        <!-- Amount Paid -->
        <div class="floating-input-group relative">
            <input type="number"
                   id="AmountPaid"
                   name="AmountPaid"
                   value="@(Model.AmountPaid ?? 0)"
                   step="0.01"
                   min="0"
                   class="peer w-full px-3 sm:px-4 py-2.5 sm:py-3 text-sm rounded-xl border @(ViewData.ModelState["AmountPaid"]?.Errors.Any() == true ? "border-red-500 dark:border-red-500" : "border-gray-200 dark:border-gray-600") bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100 focus:border-indigo-500 dark:focus:border-indigo-400 focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-800 transition-all duration-200 outline-none"
                   placeholder=" " />
            <label for="AmountPaid"
                   class="absolute left-3 sm:left-4 -top-2 sm:-top-2.5 bg-white dark:bg-gray-800 px-1.5 sm:px-2 text-xs sm:text-sm text-gray-600 dark:text-gray-400 transition-all duration-200 peer-placeholder-shown:text-sm peer-placeholder-shown:top-2 sm:peer-placeholder-shown:top-3 peer-placeholder-shown:bg-transparent dark:peer-placeholder-shown:bg-transparent peer-focus:-top-2 sm:peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-indigo-600 dark:peer-focus:text-indigo-400 peer-focus:bg-white dark:peer-focus:bg-gray-800">
                Amount Paid
            </label>
            @if (ViewData.ModelState["AmountPaid"]?.Errors.Any() == true)
            {
                <p class="text-red-500 text-xs mt-1">@ViewData.ModelState["AmountPaid"]?.Errors.First().ErrorMessage</p>
            }
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
        <!-- Payment Status - Dropdown for both Create and Edit -->
        <div class="floating-input-group relative">
            <select id="PaymentStatus"
                    name="PaymentStatus"
                    required
                    class="peer w-full px-3 sm:px-4 py-2.5 sm:py-3 text-sm rounded-xl border @(ViewData.ModelState["PaymentStatus"]?.Errors.Any() == true ? "border-red-500 dark:border-red-500" : "border-gray-200 dark:border-gray-600") bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100 focus:border-indigo-500 dark:focus:border-indigo-400 focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-800 transition-all duration-200 outline-none appearance-none">
                @if (!isEdit)
                {
                    <!-- For Create: Pending selected by default, other options available -->
                    <option value="Pending" selected class="dark:bg-gray-700">Pending</option>
                    <option value="Paid" class="dark:bg-gray-700">Paid</option>
                    <option value="Partial" class="dark:bg-gray-700">Partial</option>
                    <option value="Overdue" class="dark:bg-gray-700">Overdue</option>
                    <option value="Void" class="dark:bg-gray-700">Void</option>
                }
                else
                {
                    <!-- For Edit: Select the current status -->
                    <option value="Paid" selected="@(Model.PaymentStatus == "Paid")" class="dark:bg-gray-700">Paid</option>
                    <option value="Pending" selected="@(Model.PaymentStatus == "Pending")" class="dark:bg-gray-700">Pending</option>
                    <option value="Partial" selected="@(Model.PaymentStatus == "Partial")" class="dark:bg-gray-700">Partial</option>
                    <option value="Overdue" selected="@(Model.PaymentStatus == "Overdue")" class="dark:bg-gray-700">Overdue</option>
                    <option value="Void" selected="@(Model.PaymentStatus == "Void")" class="dark:bg-gray-700">Void</option>
                }
            </select>
            <label for="PaymentStatus"
                   class="absolute left-3 sm:left-4 -top-2 sm:-top-2.5 bg-white dark:bg-gray-800 px-1.5 sm:px-2 text-xs sm:text-sm text-gray-600 dark:text-gray-400 transition-all duration-200 peer-focus:-top-2 sm:peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-indigo-600 dark:peer-focus:text-indigo-400 peer-focus:bg-white dark:peer-focus:bg-gray-800">
                Payment Status *
            </label>
            @if (ViewData.ModelState["PaymentStatus"]?.Errors.Any() == true)
            {
                <p class="text-red-500 text-xs mt-1">@ViewData.ModelState["PaymentStatus"]?.Errors.First().ErrorMessage</p>
            }
        </div>
    </div>

    <!-- Notes -->
    <div class="floating-input-group relative">
        <textarea id="Notes"
                  name="Notes"
                  rows="3"
                  class="peer w-full px-3 sm:px-4 py-2.5 sm:py-3 text-sm rounded-xl border @(ViewData.ModelState["Notes"]?.Errors.Any() == true ? "border-red-500 dark:border-red-500" : "border-gray-200 dark:border-gray-600") bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100 focus:border-indigo-500 dark:focus:border-indigo-400 focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-800 transition-all duration-200 outline-none resize-none"
                  placeholder=" ">@(Model.Notes ?? "")</textarea>
        <label for="Notes"
               class="absolute left-3 sm:left-4 -top-2 sm:-top-2.5 bg-white dark:bg-gray-800 px-1.5 sm:px-2 text-xs sm:text-sm text-gray-600 dark:text-gray-400 transition-all duration-200 peer-placeholder-shown:text-sm peer-placeholder-shown:top-2 sm:peer-placeholder-shown:top-3 peer-placeholder-shown:bg-transparent dark:peer-placeholder-shown:bg-transparent peer-focus:-top-2 sm:peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-indigo-600 dark:peer-focus:text-indigo-400 peer-focus:bg-white dark:peer-focus:bg-gray-800">
            Notes (Optional)
        </label>
        @if (ViewData.ModelState["Notes"]?.Errors.Any() == true)
        {
            <p class="text-red-500 text-xs mt-1">@ViewData.ModelState["Notes"]?.Errors.First().ErrorMessage</p>
        }
    </div>
</div>

<script>
    // Calculate receipt totals
    document.addEventListener('DOMContentLoaded', function() {
        const quantityInput = document.getElementById('Quantity');
        const priceInput = document.getElementById('UnitPrice');
        const subtotalSpan = document.getElementById('subtotalPreview');
        const vatSpan = document.getElementById('vatPreview');
        const totalSpan = document.getElementById('totalPreview');
        const vatRate = 0.05; // 5%

        // Invoice selection dropdown
        const invoiceSelect = document.getElementById('SelectedInvoiceId');

        if (invoiceSelect) {
            invoiceSelect.addEventListener('change', function() {
                const invoiceId = this.value;
                if (invoiceId) {
                    fetch(`/Receipts/GetInvoiceDetails?invoiceId=${invoiceId}`)
                        .then(response => response.json())
                        .then(data => {
                            document.getElementById('InvoiceRef').value = data.invoiceRef;
                            document.getElementById('CustomerName').value = data.customerName;
                            document.getElementById('CustomerType').value = data.customerType;
                            document.getElementById('CustomerPhone').value = data.customerPhone || '';
                            document.getElementById('CustomerEmail').value = data.customerEmail || '';
                            document.getElementById('FuelType').value = data.fuelType;
                            document.getElementById('Quantity').value = data.quantity;
                            document.getElementById('UnitPrice').value = data.unitPrice;

                            // Trigger calculation
                            updateTotals();
                        });
                }
            });
        }

        function updateTotals() {
            const quantity = parseFloat(quantityInput?.value) || 0;
            const price = parseFloat(priceInput?.value) || 0;
            const subtotal = quantity * price;
            const vat = subtotal * vatRate;
            const total = subtotal + vat;

            if (subtotalSpan) {
                subtotalSpan.textContent = subtotal.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
            }
            if (vatSpan) {
                vatSpan.textContent = vat.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
            }
            if (totalSpan) {
                totalSpan.textContent = total.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
            }
        }

        if (quantityInput && priceInput) {
            quantityInput.addEventListener('input', updateTotals);
            priceInput.addEventListener('input', updateTotals);
            updateTotals(); // Initial calculation
        }
    });
</script>

