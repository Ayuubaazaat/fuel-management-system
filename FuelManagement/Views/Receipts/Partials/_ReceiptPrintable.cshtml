@model FuelManagement.Models.ReceiptDetailsViewModel

<div id="receipt-print" class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-200">
    <!-- Receipt Paper Design -->
    <div class="p-4 sm:p-8">
        <!-- Header -->
        <div class="text-center border-b border-gray-200 pb-4 sm:pb-6">
            <h1 class="text-2xl sm:text-3xl font-bold text-slate-900">@Model.StationName</h1>
            <p class="text-xs sm:text-sm text-gray-600 mt-1">@Model.StationAddress</p>
            <p class="text-xs sm:text-sm text-gray-600">Tel: @Model.StationPhone | Email: @Model.StationEmail</p>
        </div>

        <!-- Receipt Info -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mt-4 sm:mt-6 gap-4">
            <div>
                <h2 class="text-xl sm:text-2xl font-bold text-slate-900">RECEIPT</h2>
                <p class="text-xs sm:text-sm text-gray-600 mt-1">Receipt No: <span class="font-mono font-semibold">@Model.ReceiptNo</span></p>
                <p class="text-xs sm:text-sm text-gray-600">Invoice Ref: <span class="font-mono">@Model.InvoiceRef</span></p>
            </div>
            <div class="text-left sm:text-right">
                <p class="text-xs sm:text-sm text-gray-600">Date: <span class="font-semibold">@Model.FormattedDate</span></p>
                <p class="text-xs sm:text-sm text-gray-600">Time: <span class="font-semibold">@Model.FormattedTime</span></p>
                <div class="mt-2">
                    <span class="px-2 sm:px-4 py-1 rounded-full text-xs sm:text-sm font-semibold @Model.StatusColor">
                        @Model.PaymentStatus
                    </span>
                </div>
            </div>
        </div>

        <!-- Customer Info -->
        <div class="mt-4 sm:mt-6 p-3 sm:p-4 bg-gray-50 rounded-xl">
            <h3 class="text-xs sm:text-sm font-semibold text-gray-700 uppercase tracking-wider">Customer Information</h3>
            <div class="grid grid-cols-2 gap-2 sm:gap-4 mt-2 sm:mt-3">
                <div>
                    <p class="text-xs text-gray-500">Name</p>
                    <p class="text-xs sm:text-sm font-medium text-gray-900">@Model.CustomerName</p>
                </div>
                <div>
                    <p class="text-xs text-gray-500">Type</p>
                    <p class="text-xs sm:text-sm font-medium text-gray-900">@Model.CustomerType</p>
                </div>
                @if (!string.IsNullOrEmpty(Model.CustomerPhone))
                {
                    <div>
                        <p class="text-xs text-gray-500">Phone</p>
                        <p class="text-xs sm:text-sm font-medium text-gray-900">@Model.CustomerPhone</p>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.CustomerAddress))
                {
                    <div>
                        <p class="text-xs text-gray-500">Address</p>
                        <p class="text-xs sm:text-sm font-medium text-gray-900">@Model.CustomerAddress</p>
                    </div>
                }
            </div>
        </div>

        <!-- Items Table -->
        <div class="mt-4 sm:mt-6">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-2 sm:px-4 py-2 sm:py-3 text-left text-xs font-medium text-gray-500 uppercase">Description</th>
                            <th class="px-2 sm:px-4 py-2 sm:py-3 text-right text-xs font-medium text-gray-500 uppercase">Qty (L)</th>
                            <th class="px-2 sm:px-4 py-2 sm:py-3 text-right text-xs font-medium text-gray-500 uppercase">Unit Price</th>
                            <th class="px-2 sm:px-4 py-2 sm:py-3 text-right text-xs font-medium text-gray-500 uppercase">Total</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        <tr>
                            <td class="px-2 sm:px-4 py-2 sm:py-3 text-xs sm:text-sm text-gray-900">@Model.FuelType</td>
                            <td class="px-2 sm:px-4 py-2 sm:py-3 text-xs sm:text-sm text-right text-gray-900">@Model.FormattedQuantity</td>
                            <td class="px-2 sm:px-4 py-2 sm:py-3 text-xs sm:text-sm text-right text-gray-900">@Model.FormattedUnitPrice</td>
                            <td class="px-2 sm:px-4 py-2 sm:py-3 text-xs sm:text-sm text-right text-gray-900">@Model.FormattedSubtotal</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Summary -->
        <div class="mt-4 sm:mt-6 border-t border-gray-200 pt-3 sm:pt-4">
            <div class="flex justify-end">
                <div class="w-full sm:w-64 space-y-1 sm:space-y-2">
                    <div class="flex justify-between text-xs sm:text-sm">
                        <span class="text-gray-600">Subtotal:</span>
                        <span class="font-medium text-gray-900">@Model.FormattedSubtotal</span>
                    </div>
                    <div class="flex justify-between text-xs sm:text-sm">
                        <span class="text-gray-600">VAT (5%):</span>
                        <span class="font-medium text-amber-600">@Model.FormattedVAT</span>
                    </div>
                    <div class="flex justify-between text-sm sm:text-base font-bold pt-1 sm:pt-2 border-t border-gray-200">
                        <span class="text-gray-900">Total:</span>
                        <span class="text-indigo-600">@Model.FormattedTotalAmount</span>
                    </div>
                    <div class="flex justify-between text-xs sm:text-sm pt-1 sm:pt-2">
                        <span class="text-gray-600">Amount Paid:</span>
                        <span class="font-medium text-green-600">@Model.FormattedAmountPaid</span>
                    </div>
                    @if (Model.BalanceRemaining > 0)
                    {
                        <div class="flex justify-between text-xs sm:text-sm">
                            <span class="text-gray-600">Balance Due:</span>
                            <span class="font-medium text-red-600">@Model.FormattedBalance</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Payment Info -->
        <div class="mt-4 sm:mt-6 grid grid-cols-1 sm:grid-cols-2 gap-2 sm:gap-4 text-xs sm:text-sm text-gray-600 border-t border-gray-200 pt-3 sm:pt-4">
            <div>
                <span class="font-medium">Payment Method:</span> @Model.PaymentMethod
            </div>
            <div>
                <span class="font-medium">Processed By:</span> @Model.CreatedBy
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="mt-3 sm:mt-4 p-2 sm:p-3 bg-gray-50 rounded-lg">
                <p class="text-xs text-gray-500">Notes:</p>
                <p class="text-xs sm:text-sm text-gray-700">@Model.Notes</p>
            </div>
        }

        <!-- Footer -->
        <div class="mt-4 sm:mt-8 text-center text-xs sm:text-sm text-gray-500 border-t border-gray-200 pt-3 sm:pt-4">
            <p>Waad ku mahadsantahay soo booqashadaada!</p>
            <p class="text-xs mt-1">Noo imoow marar badan. naga soo doono adeeg hufan.</p>
        </div>
    </div>
</div>

<style>
    /* Print styles */
    @@media print {
        body * {
            visibility: hidden;
        }

        #receipt-print, #receipt-print * {
            visibility: visible;
        }

        #receipt-print {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            padding: 0;
            margin: 0;
            box-shadow: none;
        }

        .no-print {
            display: none;
        }
    }
</style>