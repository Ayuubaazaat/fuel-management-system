@model IEnumerable<FuelManagement.Models.ReceiptListItemViewModel>
@{
    var pageNumber = ViewBag.PageNumber ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var totalCount = ViewBag.TotalCount ?? 0;
    var pageSize = ViewBag.PageSize ?? 10;
    var startIndex = (pageNumber - 1) * pageSize + 1;
    var endIndex = Math.Min(startIndex + Model.Count() - 1, totalCount);
}

<div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg dark:shadow-gray-900/30 overflow-hidden border border-gray-200 dark:border-gray-700">
    <div class="overflow-x-auto">
        <table class="min-w-[1400px] sm:min-w-full divide-y divide-gray-200 dark:divide-gray-700">
            <thead class="bg-gradient-to-r from-slate-50 to-zinc-50 dark:from-gray-700 dark:to-gray-800">
                <tr>
                    <th scope="col" class="px-2 sm:px-6 py-2 sm:py-4 text-left text-xs font-medium text-slate-600 dark:text-gray-300 uppercase tracking-wider">Receipt No</th>
                    <th scope="col" class="px-2 sm:px-6 py-2 sm:py-4 text-left text-xs font-medium text-slate-600 dark:text-gray-300 uppercase tracking-wider">Invoice Ref</th>
                    <th scope="col" class="px-2 sm:px-6 py-2 sm:py-4 text-left text-xs font-medium text-slate-600 dark:text-gray-300 uppercase tracking-wider">Customer</th>
                    <th scope="col" class="px-2 sm:px-6 py-2 sm:py-4 text-left text-xs font-medium text-slate-600 dark:text-gray-300 uppercase tracking-wider">Type</th>
                    <th scope="col" class="px-2 sm:px-6 py-2 sm:py-4 text-left text-xs font-medium text-slate-600 dark:text-gray-300 uppercase tracking-wider">Fuel</th>
                    <th scope="col" class="px-2 sm:px-6 py-2 sm:py-4 text-left text-xs font-medium text-slate-600 dark:text-gray-300 uppercase tracking-wider">Qty</th>
                    <th scope="col" class="px-2 sm:px-6 py-2 sm:py-4 text-left text-xs font-medium text-slate-600 dark:text-gray-300 uppercase tracking-wider">Total</th>
                    <th scope="col" class="px-2 sm:px-6 py-2 sm:py-4 text-left text-xs font-medium text-slate-600 dark:text-gray-300 uppercase tracking-wider">Payment</th>
                    <th scope="col" class="px-2 sm:px-6 py-2 sm:py-4 text-left text-xs font-medium text-slate-600 dark:text-gray-300 uppercase tracking-wider">Date & Time</th>
                    <th scope="col" class="px-2 sm:px-6 py-2 sm:py-4 text-left text-xs font-medium text-slate-600 dark:text-gray-300 uppercase tracking-wider">Status</th>
                    <th scope="col" class="px-2 sm:px-6 py-2 sm:py-4 text-right text-xs font-medium text-slate-600 dark:text-gray-300 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-slate-50/50 dark:hover:bg-gray-700/50 transition-colors duration-200 group">
                        <td class="px-2 sm:px-6 py-2 sm:py-4 whitespace-nowrap">
                            <span class="text-xs sm:text-sm font-mono font-medium text-slate-900 dark:text-gray-100">@item.ReceiptNo</span>
                        </td>
                        <td class="px-2 sm:px-6 py-2 sm:py-4 whitespace-nowrap">
                            <span class="text-xs sm:text-sm text-slate-600 dark:text-gray-400">@item.InvoiceRef</span>
                        </td>
                        <td class="px-2 sm:px-6 py-2 sm:py-4 whitespace-nowrap">
                            <div class="text-xs sm:text-sm font-medium text-slate-900 dark:text-gray-100 truncate max-w-[80px] sm:max-w-none">@item.CustomerName</div>
                        </td>
                        <td class="px-2 sm:px-6 py-2 sm:py-4 whitespace-nowrap">
                            <span class="px-1.5 sm:px-2 py-0.5 sm:py-1 text-xs rounded-full bg-slate-100 dark:bg-gray-700 text-slate-700 dark:text-gray-300">@item.CustomerType</span>
                        </td>
                        <td class="px-2 sm:px-6 py-2 sm:py-4 whitespace-nowrap">
                            <div class="text-xs sm:text-sm text-slate-600 dark:text-gray-400">@item.FuelType</div>
                        </td>
                        <td class="px-2 sm:px-6 py-2 sm:py-4 whitespace-nowrap">
                            <div class="text-xs sm:text-sm text-slate-900 dark:text-gray-100">@item.FormattedQuantity</div>
                        </td>
                        <td class="px-2 sm:px-6 py-2 sm:py-4 whitespace-nowrap">
                            <div class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-gray-100">@item.FormattedTotalAmount</div>
                            <div class="text-xs text-slate-500 dark:text-gray-500 hidden sm:block">VAT: @item.FormattedVAT</div>
                        </td>
                        <td class="px-2 sm:px-6 py-2 sm:py-4 whitespace-nowrap">
                            <div class="text-xs sm:text-sm text-slate-600 dark:text-gray-400">@item.PaymentMethod</div>
                        </td>
                        <td class="px-2 sm:px-6 py-2 sm:py-4 whitespace-nowrap">
                            <div class="text-xs sm:text-sm text-slate-900 dark:text-gray-100">@item.PaymentDate.ToString("MMM dd")</div>
                            <div class="text-xs text-slate-500 dark:text-gray-500 hidden sm:block">@item.PaymentDate.ToString("hh:mm tt")</div>
                        </td>
                        <td class="px-2 sm:px-6 py-2 sm:py-4 whitespace-nowrap">
                            <span class="px-1.5 sm:px-3 py-0.5 sm:py-1 rounded-full text-xs font-medium @item.StatusColor">
                                <svg class="w-2 h-2 sm:w-3 sm:h-3 inline mr-0.5 sm:mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@item.StatusIcon"></path>
                                </svg>
                                <span class="hidden sm:inline">@item.PaymentStatus</span>
                                <span class="sm:hidden">@item.PaymentStatus.Substring(0, 1)</span>
                            </span>
                        </td>
                        <td class="px-2 sm:px-6 py-2 sm:py-4 whitespace-nowrap text-right text-xs sm:text-sm font-medium">
                            <div class="flex items-center justify-end space-x-1 sm:space-x-2 opacity-100 sm:opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                                <a href="@Url.Action("Details", new { id = item.Id })"
                                   class="p-1 sm:p-2 text-indigo-600 hover:bg-indigo-50 dark:text-indigo-400 dark:hover:bg-gray-700 rounded-lg transition-colors duration-200" title="View">
                                    <svg class="w-3 h-3 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                    </svg>
                                </a>
                                <a href="@Url.Action("Edit", new { id = item.Id })"
                                   class="p-1 sm:p-2 text-amber-600 hover:bg-amber-50 dark:text-amber-400 dark:hover:bg-gray-700 rounded-lg transition-colors duration-200" title="Edit">
                                    <svg class="w-3 h-3 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                    </svg>
                                </a>
                                <button type="button"
                                        onclick="openDeleteModal(@item.Id, '@item.ReceiptNo')"
                                        class="p-1 sm:p-2 text-red-600 hover:bg-red-50 dark:text-red-400 dark:hover:bg-gray-700 rounded-lg transition-colors duration-200" title="Delete">
                                    <svg class="w-3 h-3 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                    </svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="bg-white dark:bg-gray-800 px-4 sm:px-6 py-3 sm:py-4 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-gray-200 dark:border-gray-700">
        <div class="text-sm text-gray-700 dark:text-gray-400 order-2 sm:order-1">
            Showing <span class="font-medium dark:text-gray-200">@startIndex</span> to <span class="font-medium dark:text-gray-200">@endIndex</span> of <span class="font-medium dark:text-gray-200">@totalCount</span> results
        </div>
        <div class="order-1 sm:order-2">
            <nav class="relative z-0 inline-flex rounded-md shadow-sm dark:shadow-gray-900/30 -space-x-px" aria-label="Pagination">
                <!-- Previous Page Button -->
                <a href="@Url.Action("Index", new {
                    page = pageNumber - 1,
                    StartDate = ViewBag.CurrentFilter?.StartDate,
                    EndDate = ViewBag.CurrentFilter?.EndDate,
                    CustomerType = ViewBag.CurrentFilter?.CustomerType,
                    PaymentStatus = ViewBag.CurrentFilter?.PaymentStatus,
                    PaymentMethod = ViewBag.CurrentFilter?.PaymentMethod,
                    FuelType = ViewBag.CurrentFilter?.FuelType,
                    CustomerName = ViewBag.CurrentFilter?.CustomerName
                })"
                   class="relative inline-flex items-center px-2 sm:px-3 py-2 rounded-l-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-xs sm:text-sm font-medium @(pageNumber > 1 ? "text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700" : "text-gray-300 dark:text-gray-600 cursor-not-allowed pointer-events-none")"
                @(pageNumber <= 1 ? "disabled" : "")>
                    <span class="sr-only">Previous</span>
                    <svg class="h-4 w-4 sm:h-5 sm:w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                </a>

                <!-- Page Numbers -->
                @for (int i = 1; i <= totalPages; i++)
                {
                    <a href="@Url.Action("Index", new {
                        page = i,
                        StartDate = ViewBag.CurrentFilter?.StartDate,
                        EndDate = ViewBag.CurrentFilter?.EndDate,
                        CustomerType = ViewBag.CurrentFilter?.CustomerType,
                        PaymentStatus = ViewBag.CurrentFilter?.PaymentStatus,
                        PaymentMethod = ViewBag.CurrentFilter?.PaymentMethod,
                        FuelType = ViewBag.CurrentFilter?.FuelType,
                        CustomerName = ViewBag.CurrentFilter?.CustomerName
                    })"
                       class="relative inline-flex items-center px-3 sm:px-4 py-2 border border-gray-300 dark:border-gray-600 text-xs sm:text-sm font-medium @(i == pageNumber ? "bg-indigo-50 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-400 hover:bg-indigo-100 dark:hover:bg-indigo-900/50" : "bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700")">
                        @i
                    </a>
                }

                <!-- Next Page Button -->
                <a href="@Url.Action("Index", new {
                    page = pageNumber + 1,
                    StartDate = ViewBag.CurrentFilter?.StartDate,
                    EndDate = ViewBag.CurrentFilter?.EndDate,
                    CustomerType = ViewBag.CurrentFilter?.CustomerType,
                    PaymentStatus = ViewBag.CurrentFilter?.PaymentStatus,
                    PaymentMethod = ViewBag.CurrentFilter?.PaymentMethod,
                    FuelType = ViewBag.CurrentFilter?.FuelType,
                    CustomerName = ViewBag.CurrentFilter?.CustomerName
                })"
                   class="relative inline-flex items-center px-2 sm:px-3 py-2 rounded-r-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-xs sm:text-sm font-medium @(pageNumber < totalPages ? "text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700" : "text-gray-300 dark:text-gray-600 cursor-not-allowed pointer-events-none")"
                @(pageNumber >= totalPages ? "disabled" : "")>
                    <span class="sr-only">Next</span>
                    <svg class="h-4 w-4 sm:h-5 sm:w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                    </svg>
                </a>
            </nav>
        </div>
    </div>
</div>