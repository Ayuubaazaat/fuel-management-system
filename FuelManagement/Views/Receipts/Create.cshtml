@model FuelManagement.Models.ReceiptCreateViewModel
@{
    ViewData["Title"] = "Create Receipt";
}

<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-900 dark:to-gray-800 py-4 sm:py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="mb-6 sm:mb-8 animate-slideIn">
            <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100">Create New Receipt</h1>
            <p class="text-sm sm:text-base mt-2 text-gray-600 dark:text-gray-400">Generate a fuel sale receipt for customer</p>
        </div>

        <!-- Validation Summary -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="mb-6 bg-red-50 border-l-4 border-red-500 p-4 rounded-lg animate-fadeIn">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                        </svg>
                    </div>
                    <div class="ml-3">
                        <h3 class="text-sm font-medium text-red-800">Please correct the following errors:</h3>
                        <div class="mt-2 text-sm text-red-700">
                            @Html.ValidationSummary(false)
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Form Card -->
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl overflow-hidden animate-fadeIn">
            <div class="bg-gradient-to-r from-slate-800 to-zinc-900 dark:from-slate-700 dark:to-zinc-700 px-4 sm:px-6 py-3 sm:py-4">
                <h2 class="text-base sm:text-lg font-semibold text-white dark:text-white">Receipt Information</h2>
            </div>

            @using (Html.BeginForm("Create", "Receipts", FormMethod.Post, new { @class = "p-4 sm:p-6" }))
            {
                @Html.AntiForgeryToken()
                @await Html.PartialAsync("Partials/_ReceiptForm", Model)

                <div class="mt-4 sm:mt-6 flex flex-col sm:flex-row justify-end gap-3">
                    <a href="@Url.Action("Index")"
                       class="w-full sm:w-auto px-4 sm:px-6 py-2.5 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-700 dark:text-gray-300 font-medium hover:bg-gray-50 dark:hover:bg-gray-700 transition-all duration-200 text-center order-2 sm:order-1">
                        Cancel
                    </a>
                    <button type="submit"
                            class="w-full sm:w-auto px-4 sm:px-6 py-2.5 bg-gradient-to-r from-slate-800 to-zinc-900 dark:from-slate-700 dark:to-zinc-700 text-white dark:text-white font-medium rounded-lg hover:from-slate-900 dark:hover:from-slate-800 hover:to-zinc-950 dark:hover:to-zinc-800 transform hover:scale-105 transition-all duration-200 shadow-lg hover:shadow-xl order-1 sm:order-2">
                        Create Receipt
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .animate-slideIn {
        animation: slideIn 0.6s ease-out;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateX(-20px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .animate-fadeIn {
        animation: fadeIn 0.6s ease-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>