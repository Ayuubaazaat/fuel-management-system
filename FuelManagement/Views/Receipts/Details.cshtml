@model FuelManagement.Models.ReceiptDetailsViewModel
@{
    ViewData["Title"] = "Receipt Details";
}

<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-900 dark:to-gray-800 py-4 sm:py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="mb-6 sm:mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 animate-slideIn">
            <div>
                <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100">Receipt Details</h1>
                <p class="text-sm sm:text-base mt-2 text-gray-600 dark:text-gray-400">View and print receipt @Model.ReceiptNo</p>
            </div>
            <div class="flex flex-col sm:flex-row gap-2 sm:space-x-3">
                <button onclick="window.print()"
                        class="w-full sm:w-auto px-3 sm:px-4 py-2 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-lg text-gray-700 dark:text-gray-300 text-sm font-medium hover:bg-gray-50 dark:hover:bg-gray-700 transition-all duration-200">
                    <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
                    </svg>
                    <span class="hidden sm:inline">Print</span>
                </button>
                <a href="@Url.Action("Edit", new { id = Model.Id })"
                   class="w-full sm:w-auto px-3 sm:px-4 py-2 bg-gradient-to-r from-slate-800 to-zinc-900 dark:from-gray-200 dark:to-gray-300 text-white dark:text-gray-900 text-sm font-medium rounded-lg hover:from-slate-900 hover:to-zinc-950 dark:hover:from-gray-300 dark:hover:to-gray-400 transition-all duration-200 text-center">
                    <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                    </svg>
                    <span class="hidden sm:inline">Edit</span>
                </a>
            </div>
        </div>

        <!-- Receipt Paper (Printable) -->
        @await Html.PartialAsync("Partials/_ReceiptPrintable", Model)

        <!-- Actions -->
        <div class="mt-6 sm:mt-8 flex flex-col sm:flex-row gap-3 animate-fadeIn">
            <a href="@Url.Action("Edit", new { id = Model.Id })"
               class="w-full sm:w-auto px-4 sm:px-6 py-2.5 bg-gradient-to-r from-slate-800 to-zinc-900 dark:from-gray-200 dark:to-gray-300 text-white dark:text-gray-900 font-medium rounded-lg hover:from-slate-900 hover:to-zinc-950 dark:hover:from-gray-300 dark:hover:to-gray-400 transform hover:scale-105 transition-all duration-200 shadow-lg hover:shadow-xl text-center">
                Edit Receipt
            </a>
            <a href="@Url.Action("Index")"
               class="w-full sm:w-auto px-4 sm:px-6 py-2.5 border border-gray-300 dark:border-gray-700 rounded-lg text-gray-700 dark:text-gray-300 font-medium hover:bg-gray-50 dark:hover:bg-gray-800 transition-all duration-200 text-center">
                Back to List
            </a>
        </div>
    </div>
</div>

<script>
    function downloadPDF() {
        // PDF download functionality will be implemented later
        alert('PDF download feature coming soon!');
    }
</script>

<style>
    .card-hover {
        transition: all 0.3s ease;
    }

        .card-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }

    .dark .card-hover:hover {
        box-shadow: 0 20px 25px -5px rgba(255, 255, 255, 0.1), 0 10px 10px -5px rgba(255, 255, 255, 0.04);
    }

    .animate-slideIn {
        animation: slideIn 0.6s ease-out;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateX(-20px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .animate-fadeIn {
        animation: fadeIn 0.6s ease-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Print styles */
    @@media print {
        body * {
            visibility: hidden;
        }

        #receipt-print, #receipt-print * {
            visibility: visible;
        }

        #receipt-print {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
        }

        .no-print {
            display: none;
        }
    }
</style>