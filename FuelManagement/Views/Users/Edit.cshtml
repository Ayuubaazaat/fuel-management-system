@model FuelManagement.Models.UserEditViewModel
@{
    ViewData["Title"] = "Edit User";
    ViewBag.IsEdit = true;
}

<div class="max-w-3xl mx-auto animate-fadeIn px-4 sm:px-0">
    <!-- Header with User Info -->
    <div class="bg-gradient-to-r from-sky-500 to-purple-600 dark:from-sky-700 dark:to-purple-800 rounded-2xl p-6 sm:p-8 mb-8 text-white relative overflow-hidden">
        <div class="absolute inset-0 opacity-10">
            <i class="fas fa-user-circle text-6xl sm:text-8xl absolute -bottom-4 -right-4"></i>
        </div>

        <div class="relative z-10">
            <h1 class="text-2xl sm:text-3xl font-bold mb-2">Edit User</h1>
            <p class="text-white/80 text-sm sm:text-base">Update user information and permissions</p>
        </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-4 sm:p-8">
        <form asp-action="Edit" method="post" enctype="multipart/form-data" class="space-y-4 sm:space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly" class="text-red-500 dark:text-red-400 text-xs sm:text-sm bg-red-50 dark:bg-red-900/30 p-3 sm:p-4 rounded-xl" role="alert"></div>

            <!-- Avatar Upload Section -->
            <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-6 mb-6 sm:mb-8 pb-6 sm:pb-8 border-b border-gray-100 dark:border-gray-700">
                <div class="relative group">
                    <div class="w-20 h-20 sm:w-24 sm:h-24 bg-gradient-to-br from-sky-500 to-purple-600 dark:from-sky-700 dark:to-purple-800 rounded-2xl flex items-center justify-center text-white text-2xl sm:text-3xl font-semibold overflow-hidden">
                        @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                        {
                            <img src="@Model.ProfileImageUrl" alt="Profile" class="w-full h-full object-cover" id="avatarPreview" />
                        }
                        else
                        {
                            <span>@(Model.FirstName?.Length > 0 ? Model.FirstName[0].ToString() : "")@(Model.LastName?.Length > 0 ? Model.LastName[0].ToString() : "")</span>
                        }
                    </div>
                    <label for="avatarInput" class="absolute inset-0 bg-black bg-opacity-50 dark:bg-gray-900 dark:bg-opacity-70 rounded-2xl flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-200 cursor-pointer">
                        <i class="fas fa-camera text-white text-base sm:text-lg"></i>
                    </label>
                    <input type="file" id="avatarInput" name="avatar" accept="image/*" class="hidden" />
                </div>
                <div>
                    <h3 class="font-semibold text-gray-800 dark:text-gray-200 text-base sm:text-lg">Profile Photo</h3>
                    <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 mt-1">JPG, PNG or GIF (max. 5MB)</p>
                    <div id="uploadStatus" class="text-xs mt-2 hidden"></div>
                </div>
            </div>

            <!-- Form Fields -->
            <div class="space-y-4">
                <!-- First Name -->
                <div>
                    <label asp-for="FirstName" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">First Name</label>
                    <input asp-for="FirstName" class="w-full px-4 py-3 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-xl text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-transparent transition-all duration-200" />
                    <span asp-validation-for="FirstName" class="text-red-500 dark:text-red-400 text-xs mt-1"></span>
                </div>

                <!-- Last Name -->
                <div>
                    <label asp-for="LastName" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Last Name</label>
                    <input asp-for="LastName" class="w-full px-4 py-3 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-xl text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-transparent transition-all duration-200" />
                    <span asp-validation-for="LastName" class="text-red-500 dark:text-red-400 text-xs mt-1"></span>
                </div>

                <!-- Email - READ ONLY and DISABLED -->
                <div>
                    <label asp-for="Email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Email Address</label>
                    <input asp-for="Email" type="email"
                           class="w-full px-4 py-3 bg-gray-100 dark:bg-gray-600 border border-gray-200 dark:border-gray-600 rounded-xl text-gray-600 dark:text-gray-400 cursor-not-allowed"
                           readonly />
                    <p class="text-xs text-red-500 dark:text-gray-400 mt-1">Email address cannot be changed</p>
                </div>

                <!-- Phone - READ ONLY and DISABLED -->
                <div>
                    <label asp-for="Phone" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Phone </label>
                    <input asp-for="Phone" type="tel"
                           class="w-full px-4 py-3 bg-gray-100 dark:bg-gray-600 border border-gray-200 dark:border-gray-600 rounded-xl text-gray-600 dark:text-gray-400 cursor-not-allowed"
                           readonly />
                    <p class="text-xs text-red-500 dark:text-gray-400 mt-1">Phone number cannot be changed</p>
                </div>

                <!-- Role -->
                <div>
                    <label asp-for="Role" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Role</label>
                    <select asp-for="Role" class="w-full px-4 py-3 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-xl text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-transparent transition-all duration-200">
                        <option value="Admin">Admin</option>
                        <option value="User">User</option>
                    </select>
                    <span asp-validation-for="Role" class="text-red-500 dark:text-red-400 text-xs mt-1"></span>
                </div>

                <!-- Account Status -->
                <div class="flex items-center justify-between p-4 bg-gray-50 dark:bg-gray-700/50 rounded-xl">
                    <div>
                        <p class="font-medium text-gray-800 dark:text-gray-200">Account Status</p>
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Activate or deactivate this user account</p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" asp-for="IsActive" class="sr-only peer">
                        <div class="w-11 h-6 bg-gray-200 dark:bg-gray-600 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-sky-300 dark:peer-focus:ring-sky-700 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 dark:after:border-gray-600 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-gradient-to-r peer-checked:from-sky-500 peer-checked:to-purple-600 dark:peer-checked:from-sky-700 dark:peer-checked:to-purple-800"></div>
                    </label>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 pt-4 sm:pt-6 border-t border-gray-100 dark:border-gray-700">
                <button type="submit"
                        class="w-full sm:w-auto px-4 sm:px-6 py-3 bg-gradient-to-r from-sky-500 to-purple-600 dark:from-sky-700 dark:to-purple-800 text-white rounded-xl hover:from-sky-600 dark:hover:from-sky-800 hover:to-purple-700 dark:hover:to-purple-900 focus:outline-none focus:ring-2 focus:ring-sky-500 dark:focus:ring-sky-700 focus:ring-offset-2 transition-all duration-200 font-medium text-sm sm:text-base flex items-center justify-center gap-2 group">
                    <i class="fas fa-save group-hover:scale-110 transition-transform duration-200"></i>
                    Save Changes
                </button>

                <a asp-controller="Users" asp-action="Index"
                   class="w-full sm:w-auto px-4 sm:px-6 py-3 border border-gray-200 dark:border-gray-600 text-gray-600 dark:text-gray-300 rounded-xl hover:bg-gray-50 dark:hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-500 dark:focus:ring-gray-400 focus:ring-offset-2 transition-all duration-200 font-medium text-sm sm:text-base text-center">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Toast Container -->
<div id="toastContainer" class="fixed bottom-4 right-4 z-50 space-y-3"></div>

<style>
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fadeIn {
        animation: fadeIn 0.5s ease-out forwards;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Toast notification function
        function showToast(type, message) {
            const toast = document.createElement('div');
            toast.className = `flex items-center gap-3 px-6 py-4 rounded-xl shadow-lg transform transition-all duration-300 translate-x-full ${
                type === 'success' ? 'bg-emerald-50 dark:bg-emerald-900/30 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-400' :
                'bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-400'
            }`;
            toast.innerHTML = `
                <i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'}"></i>
                <span>${message}</span>
            `;

            document.getElementById('toastContainer').appendChild(toast);

            setTimeout(() => {
                toast.classList.remove('translate-x-full');
            }, 100);

            setTimeout(() => {
                toast.classList.add('translate-x-full');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // Avatar upload handling
        const avatarInput = document.getElementById('avatarInput');
        const uploadStatus = document.getElementById('uploadStatus');

        if (avatarInput) {
            avatarInput.addEventListener('change', async function() {
                if (!this.files || !this.files[0]) return;

                const file = this.files[0];

                // Validate file size
                if (file.size > 5 * 1024 * 1024) {
                    showToast('error', 'File size must be less than 5MB');
                    this.value = '';
                    return;
                }

                // Validate file type
                if (!file.type.match('image.*')) {
                    showToast('error', 'Please select an image file');
                    this.value = '';
                    return;
                }

                // Show preview
                const reader = new FileReader();
                reader.onload = function(e) {
                    const avatarContainer = document.querySelector('.w-20.h-20.sm\\:w-24.sm\\:h-24');
                    if (avatarContainer) {
                        let img = document.getElementById('avatarPreview');
                        if (!img) {
                            img = document.createElement('img');
                            img.id = 'avatarPreview';
                            img.className = 'w-full h-full object-cover';
                            avatarContainer.innerHTML = '';
                            avatarContainer.appendChild(img);
                        }
                        img.src = e.target.result;
                    }
                };
                reader.readAsDataURL(file);

                // Upload immediately
                uploadStatus.classList.remove('hidden');
                uploadStatus.textContent = 'Uploading...';

                const formData = new FormData();
                formData.append('avatar', file);

                try {
                   const response = await fetch('/Users/UploadAvatar/@Model.Id', {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    });

                    const result = await response.json();

                    uploadStatus.classList.add('hidden');

                    if (result.success) {
                        showToast('success', 'Avatar uploaded successfully');

                        // Trigger avatar update in layout
                        window.dispatchEvent(new Event('avatarUpdated'));

                    } else {
                        showToast('error', result.message || 'Failed to upload avatar');
                    }
                } catch (error) {
                    uploadStatus.classList.add('hidden');
                    showToast('error', 'Failed to upload avatar');
                }
            });
        }
    </script>
}