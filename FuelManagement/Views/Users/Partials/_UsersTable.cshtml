@model IEnumerable<FuelManagement.Models.UserListItemViewModel>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full min-w-[800px] sm:min-w-full">
            <thead class="bg-gray-50 border-b border-gray-100">
                <tr class="text-left text-xs sm:text-sm text-gray-500">
                    <th class="px-3 sm:px-6 py-3 sm:py-4 font-medium">User</th>
                    <th class="px-3 sm:px-6 py-3 sm:py-4 font-medium">Role</th>
                    <th class="px-3 sm:px-6 py-3 sm:py-4 font-medium">Status</th>
                    <th class="px-3 sm:px-6 py-3 sm:py-4 font-medium">Joined</th>
                    <th class="px-3 sm:px-6 py-3 sm:py-4 font-medium text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @foreach (var user in Model)
                {
                    <tr class="hover:bg-gray-50 transition-colors duration-200 user-row text-xs sm:text-sm"
                        data-name="@user.FullName.ToLower()"
                        data-email="@user.Email.ToLower()"
                        data-role="@user.Role"
                        data-status="@user.Status">

                        <td class="px-3 sm:px-6 py-3 sm:py-4">
                            <div class="flex items-center gap-2 sm:gap-3">
                                <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-br from-sky-500 to-purple-600 flex items-center justify-center text-white font-semibold text-xs sm:text-sm flex-shrink-0">
                                    @user.Initials
                                </div>
                                <div class="min-w-0">
                                    <p class="font-medium text-gray-800 truncate">@user.FullName</p>
                                    <p class="text-xs text-gray-500 truncate">@user.Email</p>
                                </div>
                            </div>
                        </td>

                        <td class="px-3 sm:px-6 py-3 sm:py-4">
                            <span class="text-gray-600 text-xs sm:text-sm">@user.Role</span>
                        </td>

                        <td class="px-3 sm:px-6 py-3 sm:py-4">
                            <span class="px-2 sm:px-3 py-1 rounded-full text-xs font-medium @(user.Status == "Active" ? "bg-emerald-100 text-emerald-700" : "bg-gray-100 text-gray-600")">
                                @user.Status
                            </span>
                        </td>

                        <td class="px-3 sm:px-6 py-3 sm:py-4 text-gray-600 text-xs sm:text-sm">
                            @user.JoinDateFormatted
                        </td>

                        <td class="px-3 sm:px-6 py-3 sm:py-4 text-right">
                            <div class="flex items-center justify-end gap-1 sm:gap-2">
                                <a asp-controller="Users" asp-action="Details" asp-route-id="@user.Id"
                                   class="p-1.5 sm:p-2 hover:bg-gray-100 rounded-lg transition-colors" title="View Details">
                                    <i class="fas fa-eye text-gray-500 text-xs sm:text-sm"></i>
                                </a>
                                <a asp-controller="Users" asp-action="Edit" asp-route-id="@user.Id"
                                   class="p-1.5 sm:p-2 hover:bg-gray-100 rounded-lg transition-colors" title="Edit User">
                                    <i class="fas fa-edit text-gray-500 text-xs sm:text-sm"></i>
                                </a>
                                <button onclick="openDeleteModal(@user.Id, '@user.FullName')"
                                        class="p-1.5 sm:p-2 hover:bg-red-50 rounded-lg transition-colors" title="Delete User">
                                    <i class="fas fa-trash-alt text-red-500 text-xs sm:text-sm"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-12 sm:py-16">
            <div class="w-16 h-16 sm:w-24 sm:h-24 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-users text-2xl sm:text-4xl text-gray-400"></i>
            </div>
            <h3 class="text-base sm:text-lg font-semibold text-gray-800 mb-2">No users found</h3>
            <p class="text-sm sm:text-base text-gray-500">Get started by creating a new user</p>
            <a asp-controller="Users" asp-action="Create"
               class="inline-flex items-center gap-2 px-4 sm:px-6 py-3 bg-gradient-to-r from-sky-500 to-purple-600 text-white rounded-xl hover:from-sky-600 hover:to-purple-700 transition-all duration-200 mt-4 text-sm sm:text-base">
                <i class="fas fa-plus"></i>
                Create New User
            </a>
        </div>
    }
</div>