@model FuelManagement.Models.UserViewModel

@{
    // Ensure Model is not null
    if (Model == null)
    {
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-6 text-center text-gray-500 dark:text-gray-400">
            No activity data available
        </div>
        return;
    }
}

<div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-6">
    <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-4 flex items-center gap-2">
        <i class="fas fa-chart-line text-purple-500"></i>
        Recent Activity
    </h3>

    <div class="space-y-4">
        <!-- Last Login -->
        <div class="flex items-start gap-4">
            <div class="w-8 h-8 bg-blue-100 dark:bg-blue-900/30 rounded-lg flex items-center justify-center flex-shrink-0">
                <i class="fas fa-sign-in-alt text-blue-600 dark:text-blue-400 text-sm"></i>
            </div>
            <div>
                <p class="text-gray-800 dark:text-gray-200 font-medium">Last Login</p>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                    @if (Model.LastLogin.HasValue)
                    {
                        @Model.LastLogin.Value.ToString("MMMM dd, yyyy 'at' hh:mm tt")
                    }
                    else
                    {
                        <text>Never</text>
                    }
                </p>
            </div>
        </div>

        <!-- Account Created -->
        <div class="flex items-start gap-4">
            <div class="w-8 h-8 bg-emerald-100 dark:bg-emerald-900/30 rounded-lg flex items-center justify-center flex-shrink-0">
                <i class="fas fa-user-plus text-emerald-600 dark:text-emerald-400 text-sm"></i>
            </div>
            <div>
                <p class="text-gray-800 dark:text-gray-200 font-medium">Account Created</p>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                    @Model.JoinDate.ToString("MMMM dd, yyyy")
                </p>
            </div>
        </div>

        <!-- Total Logins -->
        <div class="flex items-start gap-4">
            <div class="w-8 h-8 bg-amber-100 dark:bg-amber-900/30 rounded-lg flex items-center justify-center flex-shrink-0">
                <i class="fas fa-clock text-amber-600 dark:text-amber-400 text-sm"></i>
            </div>
            <div>
                <p class="text-gray-800 dark:text-gray-200 font-medium">Total Logins</p>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                    @Model.TotalLogins.ToString("N0") logins
                </p>
            </div>
        </div>

        <!-- Current Device -->
        <div class="flex items-start gap-4">
            <div class="w-8 h-8 bg-purple-100 dark:bg-purple-900/30 rounded-lg flex items-center justify-center flex-shrink-0">
                <i class="fas fa-laptop text-purple-600 dark:text-purple-400 text-sm"></i>
            </div>
            <div>
                <p class="text-gray-800 dark:text-gray-200 font-medium">Current Device</p>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                    @if (!string.IsNullOrEmpty(Model.LoginDevice))
                    {
                        @Model.LoginDevice
                    }
                    else
                    {
                        <text>Chrome on Windows</text>
                    }
                </p>
            </div>
        </div>

        <!-- IP Address -->
        <div class="flex items-start gap-4">
            <div class="w-8 h-8 bg-gray-100 dark:bg-gray-700 rounded-lg flex items-center justify-center flex-shrink-0">
                <i class="fas fa-network-wired text-gray-600 dark:text-gray-400 text-sm"></i>
            </div>
            <div>
                <p class="text-gray-800 dark:text-gray-200 font-medium">Last IP Address</p>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                    @if (!string.IsNullOrEmpty(Model.LastLoginIp))
                    {
                        @Model.LastLoginIp
                    }
                    else
                    {
                        <text>192.168.1.105</text>
                    }
                </p>
            </div>
        </div>
    </div>
</div>

<style>
    /* Ensure consistent spacing */
    .space-y-4 > * + * {
        margin-top: 1rem;
    }

    .flex-shrink-0 {
        flex-shrink: 0;
    }
</style>