@model FuelManagement.Models.UserViewModel
@{
    ViewData["Title"] = "User Details";
}

<div class="max-w-4xl mx-auto animate-fadeIn px-4 sm:px-0">
    <!-- Profile Header Card -->
    <div class="bg-gradient-to-r from-purple-600 to-blue-600 rounded-2xl p-6 sm:p-8 mb-8 text-white relative overflow-hidden">
        <div class="absolute inset-0 opacity-10">
            <i class="fas fa-user-circle text-7xl sm:text-9xl absolute -bottom-8 -right-8"></i>
        </div>

        <div class="relative z-10 flex flex-col sm:flex-row items-start gap-4 sm:gap-8">
            <!-- Large Avatar with Image Support -->
            <div class="w-20 h-20 sm:w-32 sm:h-32 bg-white/20 backdrop-blur-sm rounded-2xl border-4 border-white/30 flex items-center justify-center flex-shrink-0 overflow-hidden">
                @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                {
                    <img src="@Model.ProfileImageUrl" alt="@Model.FirstName" class="w-full h-full object-cover" />
                }
                else
                {
                    <span class="text-3xl sm:text-5xl font-bold text-white">@Model.FirstName[0]@Model.LastName[0]</span>
                }
            </div>

            <!-- User Info -->
            <div class="flex-1 w-full sm:w-auto">
                <h1 class="text-2xl sm:text-4xl font-bold mb-2">@Model.FirstName @Model.LastName</h1>
                <div class="flex flex-wrap items-center gap-2 sm:gap-3 mb-3 sm:mb-4">
                    <span class="px-3 sm:px-4 py-1 bg-white/20 backdrop-blur-sm rounded-lg text-xs sm:text-sm">@Model.Role</span>
                    <span class="px-3 sm:px-4 py-1 rounded-lg text-xs sm:text-sm @(Model.Status == "Active" ? "bg-emerald-500/20 text-emerald-100" : "bg-gray-500/20 text-gray-200")">
                        @Model.Status
                    </span>
                </div>
                <p class="text-white/80 text-xs sm:text-sm flex items-center gap-2">
                    <i class="far fa-envelope"></i> @Model.Email
                </p>
                <p class="text-white/80 text-xs sm:text-sm flex items-center gap-2 mt-1">
                    <i class="fas fa-phone-alt"></i> @Model.Phone
                </p>
            </div>

            <!-- Action Buttons -->
            <div class="absolute top-4 right-4 sm:static sm:flex-shrink-0">
                <a asp-controller="Users" asp-action="Edit" asp-route-id="@Model.Id"
                   class="p-2 sm:p-3 bg-white/20 backdrop-blur-sm rounded-xl hover:bg-white/30 transition-all duration-200 group inline-flex">
                    <i class="fas fa-edit text-white group-hover:scale-110 transition-transform duration-200"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Details Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6">
        <!-- Personal Information Card -->
        <div class="sm:col-span-2 bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-4 sm:p-6">
            <h3 class="text-base sm:text-lg font-semibold text-gray-800 dark:text-gray-100 mb-3 sm:mb-4 flex items-center gap-2">
                <i class="fas fa-user-circle text-purple-500"></i>
                Personal Information
            </h3>

            <div class="space-y-3 sm:space-y-4">
                <div class="grid grid-cols-2 gap-3 sm:gap-4">
                    <div>
                        <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 mb-1">First Name</p>
                        <p class="text-sm sm:text-base text-gray-800 dark:text-gray-200 font-medium">@Model.FirstName</p>
                    </div>
                    <div>
                        <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 mb-1">Last Name</p>
                        <p class="text-sm sm:text-base text-gray-800 dark:text-gray-200 font-medium">@Model.LastName</p>
                    </div>
                </div>

                <div>
                    <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 mb-1">Email Address</p>
                    <p class="text-sm sm:text-base text-gray-800 dark:text-gray-200 font-medium break-all">@Model.Email</p>
                </div>

                <div>
                    <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 mb-1">Phone Number</p>
                    <p class="text-sm sm:text-base text-gray-800 dark:text-gray-200 font-medium">@Model.Phone</p>
                </div>
            </div>
        </div>

        <!-- Account Summary Card -->
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-4 sm:p-6">
            <h3 class="text-base sm:text-lg font-semibold text-gray-800 dark:text-gray-100 mb-3 sm:mb-4 flex items-center gap-2">
                <i class="fas fa-chart-pie text-purple-500"></i>
                Account Summary
            </h3>

            <div class="space-y-3 sm:space-y-4">
                <div>
                    <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 mb-1">Member Since</p>
                    <p class="text-sm sm:text-base text-gray-800 dark:text-gray-200 font-medium">@Model.JoinDate.ToString("MMMM dd, yyyy")</p>
                </div>

                <div>
                    <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 mb-1">Last Login</p>
                    <p class="text-sm sm:text-base text-gray-800 dark:text-gray-200 font-medium">
                        @if (Model.LastLogin.HasValue)
                        {
                            @Model.LastLogin.Value.ToString("MMM dd, yyyy hh:mm tt")
                        }
                        else
                        {
                            <text>Never</text>
                        }
                    </p>
                </div>

                <div>
                    <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 mb-1">Total Logins</p>
                    <p class="text-sm sm:text-base text-gray-800 dark:text-gray-200 font-medium">@Model.TotalLogins.ToString("N0")</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Back Button -->
    <div class="mt-6 sm:mt-8">
        <a asp-controller="Users" asp-action="Index"
           class="inline-flex items-center gap-2 px-4 sm:px-6 py-3 border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 rounded-xl hover:bg-gray-50 dark:hover:bg-gray-800 transition-all duration-200 group text-sm sm:text-base">
            <i class="fas fa-arrow-left group-hover:-translate-x-1 transition-transform duration-200"></i>
            Back to Users
        </a>
    </div>
</div>

<style>
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fadeIn {
        animation: fadeIn 0.5s ease-out forwards;
    }
</style>